<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:paddingHorizontal="10dp"
    tools:context=".lj.AccountBroadActivity">
    <LinearLayout
        android:id="@+id/llPhone"
        android:gravity="center_vertical"
        android:paddingHorizontal="25dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_rect_0b0a10_broad_10dp"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <TextView
            android:text="@string/手机号"
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/tvPhone"
            tools:text="15032145678"
            android:textSize="14sp"
            android:textColor="#999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_marginLeft="11dp"
            android:src="@mipmap/ic_next_broad_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_rect_0b0a10_broad_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/llUserName"
            android:paddingHorizontal="25dp"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="55dp">
            <TextView
                android:text="@string/用户名"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvName"
                tools:text="里厉害"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/llGenggai"
            android:paddingHorizontal="25dp"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="55dp">
            <TextView
                android:text="@string/更改密码"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <ImageView
                android:layout_marginLeft="11dp"
                android:src="@mipmap/ic_next_broad_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>