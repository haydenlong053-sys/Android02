<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_main_space"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@color/bg_main"
        android:paddingTop="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivTouxiang"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_text0"
                android:ellipsize="end"
                android:id="@+id/tvname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="200dp"
                android:maxLines="1"
                android:layout_marginStart="17dp"
                app:layout_constraintStart_toEndOf="@+id/ivTouxiang"
                app:layout_constraintTop_toTopOf="@+id/ivTouxiang"/>
            <ImageView
                android:id="@+id/ivxingbie"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@mipmap/ic_broad_nan"
                android:layout_marginStart="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/tvname"
                app:layout_constraintStart_toEndOf="@+id/tvname"
                app:layout_constraintTop_toTopOf="@+id/tvname"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            style="@style/Line2"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="53dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/color_text0"
                android:id="@+id/qianming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gexingqiaming"
                android:layout_marginStart="23dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/color_text_content"
                android:ellipsize="end"
                android:gravity="end"
                android:id="@+id/qianmingname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="23dp"
                android:layout_marginEnd="21dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/qianming"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@color/bg_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_text_addfriend"
            android:gravity="center"
            android:id="@+id/tianjiadaotongxun"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:text="@string/tianjiadaotongxun"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>
