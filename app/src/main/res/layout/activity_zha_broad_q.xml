<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main_space"
    android:orientation="vertical"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/llSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:id="@+id/rlIcon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="50dp">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/riIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_head"
                    app:riv_oval="true" />

            </RelativeLayout>

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:paddingVertical="10dp"
                android:text=""
                android:textColor="@color/color_text0"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvIdno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="ID："
                android:textColor="@color/color_text0"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:background="@drawable/bg_rect_main"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">



                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/ivQrcode"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:scaleType="fitXY"
                    />

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvRegInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_rect_main"
            android:padding="20dp"
            android:text=""
            android:textColor="#ffbebebe"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_rect_main">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textSize="14sp"
                    android:textColor="@color/color_text0"
                    android:text="@string/用户名"/>

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:layout_weight="1"
                    android:gravity="right"
                    android:padding="12dp"
                    android:hint="@string/请输入"
                    android:background="@null"
                    android:textSize="14sp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                style="@style/Line"
               />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textSize="14sp"
                    android:textColor="@color/color_text0"
                    android:text="@string/密码"/>

                <TextView
                    android:id="@+id/etPsw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="right"
                    android:padding="12dp"
                    android:text="******"
                    android:inputType="textPassword"
                    android:background="@null"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/color_text_xg"
                    android:text="@string/修改"/>

            </LinearLayout>

        </LinearLayout>
        <TextView
            android:id="@+id/tvSaveInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:background="@mipmap/ic_bg_btn1_01"
            android:gravity="center"
            android:text="@string/保存"
            android:textColor="@color/color_text0"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:background="@mipmap/ic_bg_btn2_01"
            android:gravity="center"
            android:text="@string/保存二维码"
            android:textColor="#ffffffff"
            android:textSize="16sp"
            android:textStyle="bold" />



    </LinearLayout>


</ScrollView>