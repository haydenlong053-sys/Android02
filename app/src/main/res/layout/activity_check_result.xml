<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/layout_my_toolbar_broad_style1" android:id="@+id/toolbar"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="20dp"
        >
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- 高风险预警卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center_horizontal">

                        <!-- 标题 -->
                        <TextView
                            android:id="@+id/tvRiskWarningTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            app:drawableStartCompat="@mipmap/ic_ai_dangerous_broad_low" />

                        <!-- 风险占比圆形指示器 -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="174dp"
                            android:layout_height="174dp"
                            android:layout_marginTop="35dp">

                            <!-- 圆形背景 -->
                            <com.dinuscxj.progressbar.CircleProgressBar
                                android:id="@+id/viewCircleBg"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:line_count="30"
                                app:line_width="10dp"
                                app:progress_background_color="@color/color_F1F5F9"
                                app:progress_start_color="@color/color_EF4444"
                                app:progress_end_color="@color/color_EF4444"
                                app:progress_shader="sweep"
                                app:progress_stroke_cap="round"
                                app:progress_stroke_width="10dp"
                                app:progress_style="solid_line"
                                app:progress_text_color="@color/color_EF4444"
                                app:progress_text_size="0sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                />

                            <!-- 百分比文字容器 -->
                            <LinearLayout
                                android:id="@+id/llPercentageContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:id="@+id/tvRiskPercentage"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        tools:text="92"
                                        android:textColor="@color/black"
                                        android:textSize="50sp"
                                        android:textStyle="bold"
                                        />
                                    <TextView
                                        android:id="@+id/tvPercentage"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="%"
                                        android:textColor="@color/black"
                                        android:textSize="24sp"
                                        android:textStyle="bold"
                                        />

                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/risk_percentage"
                                    android:textColor="@color/color_94A3B8"
                                    android:textSize="14sp"
                                    />
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- 免责声明 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/monitoring_result_disclaimer"
                            android:textColor="@color/color_94A3B8"
                            android:textSize="14sp"
                            android:gravity="center" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 分析细则报告标题 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:layout_marginHorizontal="16dp"
                    android:gravity="center_vertical">

                    <com.hjq.shape.view.ShapeView
                        android:layout_width="3dp"
                        android:layout_height="16dp"
                        app:shape_solidColor="@color/color_3B47DD"
                        app:shape_radius="49dp"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/detailed_analysis_report"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCheckResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_check_broad_result" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="60dp"/>
            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- 返回首页按钮 -->
        <FrameLayout
            android:id="@+id/btnReturnHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_btn_broad_blue"
            android:layout_gravity="bottom"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/return_homepage"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:layout_gravity="center"
                app:drawableStartCompat="@mipmap/ic_ai_broad_back" />

        </FrameLayout>


    </FrameLayout>
</LinearLayout>

