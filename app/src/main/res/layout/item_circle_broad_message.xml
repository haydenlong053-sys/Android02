<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingHorizontal="17dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/riIcon"
            android:src="@mipmap/ic_broad_head"
            android:scaleType="centerCrop"
            app:riv_corner_radius="5dp"
            android:layout_width="46dp"
            android:layout_height="46dp"/>
        <LinearLayout
            android:layout_marginLeft="12dp"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvName"
                android:text="斯塔拉·罗斯"
                android:textSize="13sp"
                android:textColor="@color/color_text0"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/imZan"
                android:layout_marginTop="5dp"
                android:src="@mipmap/ic_dianzan_num_broad_false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvContent"
                android:text="你拍的很好看"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvTime"
                android:text="9月6日 00:58"
                android:textSize="12sp"
                android:textColor="#999999"
                android:textStyle="bold"
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:background="@drawable/bg_rect_f5f5f5_broad_10dp"
            android:orientation="vertical"
            android:layout_width="56dp"
            android:layout_height="56dp">
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/riThumb"
                app:riv_corner_radius="5dp"
                android:src="@mipmap/ic_broad_zhanwei"
                android:scaleType="centerCrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:id="@+id/tvWenan"
                android:text="文案描述文案描述文案…"
                android:maxLines="3"
                android:textColor="#999999"
                android:textSize="9sp"
                android:paddingHorizontal="10dp"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_marginTop="13dp"
        android:layout_width="match_parent"
        style="@style/Line2"/>
</LinearLayout>