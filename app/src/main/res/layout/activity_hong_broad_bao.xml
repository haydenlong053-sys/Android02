<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:src="@mipmap/ic_hongbao_top_broad_bg"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:id="@+id/zhuanzhangvitool"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/fanhui"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:padding="18dp"
                android:src="@mipmap/ic_broad_back" />

        </FrameLayout>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_marginTop="45dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivTouxiang"
                android:layout_width="23dp"
                android:layout_height="23dp"
               />


            <TextView
                android:id="@+id/tvname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxWidth="260dp"
                android:maxLines="1"
                android:text="@string/mourendehongbao"
                android:textColor="@color/color_text0"
                android:textSize="18sp"
                android:textStyle="bold"
                 />

        </androidx.appcompat.widget.LinearLayoutCompat>


        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvnicheng"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="16dp"
            tools:text="恭喜发财，大吉大利"
            android:textColor="@color/color_text_content"
            android:textSize="13sp"
            />
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_marginTop="23dp"
            android:gravity="bottom"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/qianNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textStyle="bold"
                android:textColor="@color/color_price_red"
                android:textSize="55sp"
                />
            <TextView
                android:layout_marginStart="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yuanqian"
                android:textStyle="bold"
                android:textColor="@color/color_price_red"
                android:textSize="13sp"
                />
        </androidx.appcompat.widget.LinearLayoutCompat>


        <TextView
            android:id="@+id/tvhongbaogeshu"
            android:layout_marginTop="19dp"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/yilingquhongbao"
            android:textColor="#C8A76F"
            android:textSize="13sp"
            />

        <View
            android:layout_marginTop="26dp"
            android:layout_width="match_parent"
            android:background="@color/bg_main_space"
            android:layout_height="8dp"/>

        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/smartLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </com.scwang.smart.refresh.layout.SmartRefreshLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>


</androidx.constraintlayout.widget.ConstraintLayout>