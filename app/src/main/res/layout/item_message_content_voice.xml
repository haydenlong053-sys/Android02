<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/voice_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <RelativeLayout
        android:id="@+id/audioContentLayout"
        android:layout_width="65dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_bubble_broad_receive"
        tools:ignore="RtlHardcoded">

        <ImageView
            android:id="@+id/audioImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"
            android:background="@drawable/audio_animation_left_broad_list"
            android:contentDescription="@null" />
    </RelativeLayout>

    <TextView
        android:id="@+id/durationTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/color_text0"
        android:textSize="14sp"
        tools:text="6''" />

    <View
        android:id="@+id/playStatusIndicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/shape_red_broad_dot"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
