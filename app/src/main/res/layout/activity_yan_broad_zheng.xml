<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main2"
    android:orientation="vertical">

    <com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:shapeCornersRadius="8dp"
        app:shapeSolidColor="@color/white">

        <EditText
            android:id="@+id/edtSousuo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:drawableStart="@mipmap/ic_broad_search2"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:hint="@string/sousuonicheng"
            android:imeOptions="actionSearch"
            android:paddingStart="12dp"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="@color/black_45"
            android:textSize="14sp"
            tools:ignore="Autofill,TextFields,TouchTargetSizeCheck" />

    </com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout>



    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/smartLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main_space"
        android:paddingTop="8dp"
        >

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</LinearLayout>