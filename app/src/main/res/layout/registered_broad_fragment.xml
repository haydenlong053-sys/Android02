<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="#000000">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_25"
        android:text="@string/mnemonic_account_register"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/title2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/register_account_with_96_bit_mnemonic"
        android:textColor="#A5ffffff"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/title"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/content"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:padding="@dimen/dp_16"
        android:textColor="#FF6490FF"
        android:textSize="@dimen/sp_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title2"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="#3D3B47DD"
        app:shape_strokeColor="@color/color_3B47DD"
        app:shape_strokeWidth="@dimen/dp_1"
        tools:text="*** HGJK TY78 HH IJ NKGG DYHG78KGHTH  IJNK TY78 HH IGJK TY78 HH IJ NKGG DYHG JK 78 HTHH  IJNK TY78 HH IJJ ****" />

    <com.hjq.shape.view.ShapeView
        android:id="@+id/backView"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginBottom="-40dp"
        app:layout_constraintBottom_toBottomOf="@id/loginBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/content"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="#FF0F1B3A"
        app:shape_strokeColor="#FF3E5387"
        app:shape_strokeWidth="@dimen/dp_1"
        tools:alpha="1"
        tools:visibility="visible" />


    <com.hjq.shape.view.ShapeEditText
        android:id="@+id/loginAccount"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_50"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_40"
        android:drawableStart="@mipmap/icon_login_account"
        android:drawablePadding="@dimen/dp_12"
        android:hint="@string/please_enter_account"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_48"
        android:textColor="@color/white"
        android:textColorHint="#5966A0F7"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/backView"
        app:layout_constraintStart_toStartOf="@id/backView"
        app:layout_constraintTop_toTopOf="@id/backView"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="@color/color_080E1E"
        app:shape_strokeColor="@color/color_080E1E"
        app:shape_strokeWidth="@dimen/dp_1" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/loginLookPwd"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:background="@color/transparent"
        android:padding="@dimen/dp_16"
        android:scaleType="centerCrop"
        android:src="@mipmap/icon_clear_text"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/loginAccount"
        app:layout_constraintEnd_toEndOf="@id/loginAccount"
        app:layout_constraintTop_toTopOf="@id/loginAccount"
        tools:visibility="visible" />

    <com.hjq.shape.view.ShapeEditText
        android:id="@+id/loginPwd"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_20"
        android:drawableStart="@mipmap/icon_login_pwd"
        android:drawablePadding="@dimen/dp_12"
        android:hint="@string/please_enter_new_password"
        android:inputType="textPassword"
        android:paddingHorizontal="@dimen/dp_16"
        android:textColor="@color/white"
        android:textColorHint="#5966A0F7"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/loginAccount"
        app:layout_constraintStart_toStartOf="@id/loginAccount"
        app:layout_constraintTop_toBottomOf="@id/loginAccount"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="@color/color_080E1E"
        app:shape_strokeColor="@color/color_080E1E"
        app:shape_strokeWidth="@dimen/dp_1" />

    <com.hjq.shape.view.ShapeEditText
        android:id="@+id/updatePwd"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_20"
        android:drawableStart="@mipmap/icon_update_pwd"
        android:drawablePadding="@dimen/dp_12"
        android:hint="@string/please_repeat_password"
        android:inputType="textPassword"
        android:paddingHorizontal="@dimen/dp_16"
        android:textColor="@color/white"
        android:textColorHint="#5966A0F7"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/loginAccount"
        app:layout_constraintStart_toStartOf="@id/loginAccount"
        app:layout_constraintTop_toBottomOf="@id/loginPwd"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="@color/color_080E1E"
        app:shape_strokeColor="@color/color_080E1E"
        app:shape_strokeWidth="@dimen/dp_1" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/loginBtn"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_50"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_32"
        android:gravity="center"
        android:text="@string/generate_login_qrcode"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/backView"
        app:layout_constraintStart_toStartOf="@id/backView"
        app:layout_constraintTop_toBottomOf="@id/updatePwd" />
</androidx.constraintlayout.widget.ConstraintLayout>