<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/bg_main_space"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:paddingHorizontal="27dp"
            android:layout_marginTop="9dp"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/bg_rect_broad_main"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:text="@string/当前余额"
                android:textSize="14sp"
                android:textColor="@color/color_text0"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvYue"
                tools:text="0"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#FF5145"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:paddingHorizontal="27dp"
            android:layout_marginTop="9dp"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/bg_rect_broad_main"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:text="@string/收款人"
                    android:textSize="14sp"
                    android:textColor="@color/color_text0"
                    android:textStyle="bold"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvShoukuanUser"
                    tools:text="利达李"
                    android:textSize="14sp"
                    android:textColor="@color/color_text_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:id="@+id/imCopy1"
                    android:layout_marginLeft="7dp"
                    android:src="@mipmap/ic_broad_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:text="@string/收款账户"
                    android:textSize="14sp"
                    android:textColor="@color/color_text0"
                    android:textStyle="bold"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvShoukuanZhanghu"
                    tools:text="456354456364535"
                    android:textSize="14sp"
                    android:textColor="@color/color_text_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:id="@+id/imCopy2"
                    android:layout_marginLeft="7dp"
                    android:src="@mipmap/ic_broad_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_marginTop="17dp"
            android:layout_marginLeft="23dp"
            android:text="@string/请复制收款信息进行充值"
            android:textColor="@color/color_text_content_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:paddingHorizontal="27dp"
            android:paddingVertical="20dp"
            android:layout_marginTop="17dp"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/bg_rect_broad_main"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvBiaoti"
                android:text="标题标题"
                android:textSize="14sp"
                android:textColor="@color/color_text0"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:scaleType="centerCrop"
                android:id="@+id/imBiaoti"
                android:layout_marginTop="15dp"
                tools:src="@mipmap/ic_broad_zhanwei"
                android:layout_width="178dp"
                android:layout_height="111dp"/>
        </LinearLayout>
        <LinearLayout
            android:paddingHorizontal="27dp"
            android:paddingVertical="20dp"
            android:layout_marginTop="17dp"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/bg_rect_broad_main"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/充值金额"
                android:textSize="14sp"
                android:textColor="@color/color_text0"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="78dp">
                <TextView
                    android:text="@string/人民币"
                    android:textSize="20sp"
                    android:textColor="@color/color_text0"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/etMoney"
                    android:textSize="30sp"
                    android:textColor="@color/color_text0"
                    android:paddingHorizontal="10dp"
                    android:inputType="numberDecimal"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <View
                android:background="#F3F3F3"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
        </LinearLayout>
        <LinearLayout
            android:paddingHorizontal="27dp"
            android:paddingVertical="20dp"
            android:layout_marginTop="17dp"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/bg_rect_broad_main"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/上传凭证"
                android:textSize="14sp"
                android:textColor="@color/color_text0"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/imImage"
                android:layout_marginTop="15dp"
                android:src="@mipmap/ic_add_broad_image"
                android:layout_width="75dp"
                android:layout_height="75dp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tvEnter"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"
            android:layout_marginHorizontal="37dp"
            android:background="@mipmap/ic_bg_btn2_broad_01"
            android:gravity="center"
            android:text="@string/确认充值"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>