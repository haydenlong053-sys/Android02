<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >


    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.hjq.shape.layout.ShapeConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="48dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp"
            app:shape_angle="90"
            app:shape_endColor="#f8f7fd"
            app:shape_radius="@dimen/dp_20"
            app:shape_startColor="@color/transparent"
            >

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/accountLabelTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_account"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.hjq.shape.view.ShapeEditText
                android:id="@+id/accountEt"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:drawableStart="@mipmap/icon_login_broad_account"
                android:drawablePadding="12dp"
                android:enabled="false"
                android:focusable="false"
                android:inputType="none"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:textColorHint="#BBBBBB"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/accountLabelTv"
                app:shape_radius="12dp"
                app:shape_solidColor="@color/white"
                app:shape_strokeColor="#E5E5E5"
                app:shape_strokeWidth="1dp"
                tools:text="test018" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/oldPwdLabelTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/原密码"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/accountEt" />

            <com.hjq.shape.view.ShapeEditText
                android:id="@+id/oldPwdEt"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:drawableStart="@mipmap/icon_login_broad_pwd"
                android:drawablePadding="12dp"
                android:hint="@string/请输入原密码"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:textColor="@color/black"
                android:textColorHint="#BBBBBB"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/oldPwdLabelTv"
                app:shape_radius="12dp"
                app:shape_solidColor="@color/white"
                app:shape_strokeColor="#E5E5E5"
                app:shape_strokeWidth="1dp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/oldPwdLook"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/transparent"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@mipmap/icon_pwd_broad_close"
                android:tint="@color/color_9699A3"
                app:layout_constraintBottom_toBottomOf="@id/oldPwdEt"
                app:layout_constraintEnd_toEndOf="@id/oldPwdEt"
                app:layout_constraintTop_toTopOf="@id/oldPwdEt" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/newPwdLabelTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/新密码"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/oldPwdEt" />

            <com.hjq.shape.view.ShapeEditText
                android:id="@+id/newPwdEt"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:drawableStart="@mipmap/icon_login_broad_pwd"
                android:drawablePadding="12dp"
                android:hint="@string/请输入新密码"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:textColor="@color/black"
                android:textColorHint="#BBBBBB"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/newPwdLabelTv"
                app:shape_radius="12dp"
                app:shape_solidColor="@color/white"
                app:shape_strokeColor="#E5E5E5"
                app:shape_strokeWidth="1dp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/newPwdLook"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/transparent"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@mipmap/icon_pwd_broad_close"
                android:tint="@color/color_9699A3"
                app:layout_constraintBottom_toBottomOf="@id/newPwdEt"
                app:layout_constraintEnd_toEndOf="@id/newPwdEt"
                app:layout_constraintTop_toTopOf="@id/newPwdEt" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/pwdRuleTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auth_password_rule_hint"
                android:textColor="#999999"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/newPwdEt" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/confirmPwdLabelTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/确认新密码"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/pwdRuleTv" />

            <com.hjq.shape.view.ShapeEditText
                android:id="@+id/againPwdEt"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:drawableStart="@mipmap/icon_login_broad_pwd"
                android:drawablePadding="12dp"
                android:hint="@string/请再次输入密码"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:textColor="@color/black"
                android:textColorHint="#BBBBBB"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/confirmPwdLabelTv"
                app:shape_radius="12dp"
                app:shape_solidColor="@color/white"
                app:shape_strokeColor="#E5E5E5"
                app:shape_strokeWidth="1dp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/againPwdLook"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/transparent"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@mipmap/icon_pwd_broad_close"
                android:tint="@color/color_9699A3"
                app:layout_constraintBottom_toBottomOf="@id/againPwdEt"
                app:layout_constraintEnd_toEndOf="@id/againPwdEt"
                app:layout_constraintTop_toTopOf="@id/againPwdEt" />

            <com.hjq.shape.view.ShapeTextView
                android:id="@+id/sureBtn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="32dp"
                android:alpha="0.7"
                android:gravity="center"
                android:text="@string/confirm_modify_pwd"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/againPwdEt"
                app:shape_angle="0"
                app:shape_endColor="#9069fc"
                app:shape_radius="12dp"
                app:shape_startColor="#6232f9" />

        </com.hjq.shape.layout.ShapeConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
