<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/yellow">

    <com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout
        android:id="@+id/rootView"
        android:layout_width="320dp"
        android:layout_height="270dp"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"
        app:shapeCornersRadius="15dp"
        app:shapeSolidColor="@color/white">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/bianjixiaoxineirong"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout
            android:layout_width="match_parent"
            android:layout_height="99dp"
            android:layout_marginStart="23dp"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="23dp"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeCornersRadius="10dp"
            app:shapeSolidColor="@color/color_psw_bg">

            <EditText
                android:id="@+id/edtBeizhu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:gravity="start"
                android:paddingStart="25dp"
                android:paddingTop="20dp"
                android:textColor="#666666"
                android:textColorHint="#666666"
                android:textSize="14sp"
                tools:hint="测试" />

        </com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout>

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvNotAgree"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="22dp"
            android:gravity="center"
            android:text="@string/quxiao"
            android:textColor="@color/color_3B47DDk"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvAgree"
            app:layout_constraintStart_toStartOf="parent"
            app:shape_radius="@dimen/dp_10"
            app:shape_solidColor="@color/white"
            app:shape_strokeColor="@color/color_3B47DDk"
            app:shape_strokeWidth="@dimen/dp_1" />


        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvAgree"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="26dp"
            android:layout_marginBottom="22dp"
            android:gravity="center"
            android:text="@string/queding"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvNotAgree"
            app:shape_radius="@dimen/dp_10"
            app:shape_solidColor="@color/color_3B47DDk" />


    </com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout>
</LinearLayout>