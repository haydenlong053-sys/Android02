<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main2">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.hjq.shape.view.ShapeView
            android:id="@+id/returnView"
            android:layout_width="@dimen/dp_62"
            android:layout_height="@dimen/dp_62"
            android:layout_marginStart="@dimen/dp_11"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_radius="@dimen/dp_31"
            app:shape_shadowColor="#739e9e9e"
            app:shape_shadowSize="@dimen/dp_10"
            app:shape_solidColor="@color/white" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/backIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_broad_back2"
            app:layout_constraintBottom_toBottomOf="@id/returnView"
            app:layout_constraintEnd_toEndOf="@id/returnView"
            app:layout_constraintStart_toStartOf="@id/returnView"
            app:layout_constraintTop_toTopOf="@id/returnView" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/titleTv"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/square_notice_rule_title"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/returnView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/returnView" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_12"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@id/confirmBtn"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.hjq.shape.layout.ShapeConstraintLayout
                android:id="@+id/stakeRuleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/dp_16"
                app:shape_radius="@dimen/dp_16"
                app:shape_solidColor="@color/white"
                app:shape_strokeColor="#E8EAFF"
                app:shape_strokeWidth="@dimen/dp_0.5">

                <com.hjq.shape.view.ShapeView
                    android:id="@+id/stakeIconBg"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shape_radius="@dimen/dp_12"
                    app:shape_solidColor="@color/color_3B47DD_12" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/stakeIcon"
                    android:layout_width="@dimen/dp_14"
                    android:layout_height="@dimen/dp_14"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_square_publish_info"
                    app:layout_constraintBottom_toBottomOf="@id/stakeIconBg"
                    app:layout_constraintEnd_toEndOf="@id/stakeIconBg"
                    app:layout_constraintStart_toStartOf="@id/stakeIconBg"
                    app:layout_constraintTop_toTopOf="@id/stakeIconBg"
                    app:tint="@color/color_3B47DD"
                    tools:ignore="ContentDescription" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/stakeTitle"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:textColor="@color/color_3B47DD"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/stakeIconBg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/stakeIconBg"
                    app:layout_constraintTop_toTopOf="@id/stakeIconBg"
                    tools:text="质押发布机制" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/stakeContent"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:lineSpacingExtra="@dimen/dp_4"
                    android:textColor="@color/black_65"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/stakeIconBg"
                    tools:text="在广场发布动态需质押 2.0 ODIS。内容发布 24 小时内若无违规举报，质押金将全额退还至您的账户。" />
            </com.hjq.shape.layout.ShapeConstraintLayout>

            <com.hjq.shape.layout.ShapeConstraintLayout
                android:id="@+id/auditRuleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:padding="@dimen/dp_16"
                app:shape_radius="@dimen/dp_16"
                app:shape_solidColor="@color/white"
                app:shape_strokeColor="#E8EAFF"
                app:shape_strokeWidth="@dimen/dp_0.5">

                <com.hjq.shape.view.ShapeView
                    android:id="@+id/auditIconBg"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shape_radius="@dimen/dp_12"
                    app:shape_solidColor="#1AD5271E" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/auditIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="!"
                    android:textColor="@color/color_D5271E"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/auditIconBg"
                    app:layout_constraintEnd_toEndOf="@id/auditIconBg"
                    app:layout_constraintStart_toStartOf="@id/auditIconBg"
                    app:layout_constraintTop_toTopOf="@id/auditIconBg" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/auditTitle"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:textColor="@color/color_D5271E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/auditIconBg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/auditIconBg"
                    app:layout_constraintTop_toTopOf="@id/auditIconBg"
                    tools:text="内容审核标准" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/auditContent"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:lineSpacingExtra="@dimen/dp_4"
                    android:textColor="@color/black_65"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/auditIconBg"
                    tools:text="SeekWeb4 致力于高净值信息交换。严禁发布垃圾广告、虚假新闻或人身攻击。违规将扣除全部质押金并限制广场权限。" />
            </com.hjq.shape.layout.ShapeConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/confirmBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_24"
        android:gravity="center"
        android:text="@string/square_publish_rules_confirm"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shape_radius="@dimen/dp_24"
        app:shape_solidColor="@color/color_3B47DD" />
</androidx.constraintlayout.widget.ConstraintLayout>
