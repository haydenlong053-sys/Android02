<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_rect_white_top_broad_10dp"
    android:orientation="vertical">
    <ImageView
        android:layout_marginTop="-5dp"
        android:src="@mipmap/ic_dialog_broad_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imDismiss"
            android:src="@mipmap/ic_broad_guanbi"
            android:tint="@color/black"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="30dp"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:text="@string/提现金额"
            android:layout_marginTop="30dp"
            android:textSize="15sp"
            android:textColor="#101010"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/人民币"
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvMoney"
                android:text="0.00"
                android:textSize="32dp"
                android:textColor="#222222"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <com.maning.pswedittextlibrary.MNPasswordEditText
            android:id="@+id/pswEdit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="23dp"
            android:layout_marginBottom="16dp"
            android:focusableInTouchMode="true"
            android:layout_marginHorizontal="10dp"
            android:inputType="number"
            android:maxLength="6"
            android:textSize="20sp"
            app:psw_mode="Circle"
            app:psw_border_color="#F2F2F2"
            app:psw_border_radius="5dp"
            app:psw_cover_circle_radius="4dp"
            app:psw_border_selected_color="#5456F6"
            app:psw_border_width="1dp"
            app:psw_cover_circle_color="#5456F6"
            app:psw_cursor_width="0dp"
            app:psw_item_margin="10dp"
            app:psw_show_cursor="false"
            app:psw_style="StyleOneself"
            app:psw_text_color="#5456F6"/>
        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <View
                android:background="#EEEEEE"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
           <LinearLayout
               android:orientation="horizontal"
               android:layout_width="match_parent"
               android:layout_height="50dp">
              <TextView
                  android:text="1"
                  android:textColor="@color/black"
                  android:textStyle="bold"
                  android:textSize="25sp"
                  android:gravity="center"
                  android:layout_width="0dp"
                  android:layout_weight="1"
                  android:layout_height="match_parent"/>
               <View
                   android:background="#EEEEEE"
                   android:layout_width="0.5dp"
                   android:layout_height="match_parent"/>
               <TextView
                   android:text="2"
                   android:textColor="@color/black"
                   android:textStyle="bold"
                   android:textSize="25sp"
                   android:gravity="center"
                   android:layout_width="0dp"
                   android:layout_weight="1"
                   android:layout_height="match_parent"/>
               <View
                   android:background="#EEEEEE"
                   android:layout_width="0.5dp"
                   android:layout_height="match_parent"/>
               <TextView
                   android:text="3"
                   android:textColor="@color/black"
                   android:textStyle="bold"
                   android:textSize="25sp"
                   android:gravity="center"
                   android:layout_width="0dp"
                   android:layout_weight="1"
                   android:layout_height="match_parent"/>
           </LinearLayout>
            <View
                android:background="#EEEEEE"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:text="4"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="25sp"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"/>
                <View
                    android:background="#EEEEEE"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:text="5"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="25sp"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"/>
                <View
                    android:background="#EEEEEE"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:text="6"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="25sp"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <View
                android:background="#EEEEEE"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:text="7"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="25sp"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"/>
                <View
                    android:background="#EEEEEE"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:text="8"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="25sp"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"/>
                <View
                    android:background="#EEEEEE"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:text="9"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="25sp"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <View
                android:background="#EEEEEE"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:background="#EEEEEE"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="25sp"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"/>
                <View
                    android:background="#EEEEEE"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:text="0"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="25sp"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"/>
                <View
                    android:background="#EEEEEE"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:gravity="center"
                    android:background="#EEEEEE"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent">
                    <ImageView
                        android:src="@mipmap/ic_jianpan_broad_shanchu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>