<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginBottom="4dp"
    android:paddingLeft="16dp">

    <ImageView
        android:id="@+id/iv_check_cnv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_marginRight="16dp"
        android:src="@mipmap/ic_check_cnv_normal"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/portraitRelativeLayout"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@id/iv_check_cnv">

        <!--头像-->
        <com.cboda.baselibrary.view.AppRoundImage
            android:id="@+id/portraitImageView"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            app:app_round_round_type="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@mipmap/ic_launcher" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/gradeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_1"
            android:textColor="@color/ps_color_white"
            android:textSize="8sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/portraitImageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:shape_endColor="#7A66FA"
            app:shape_radius="@dimen/dp_10"
            app:shape_startColor="#956BEC"
            tools:text="78分"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_centerVertical="true"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="16dp"
        android:layout_toRightOf="@+id/portraitRelativeLayout"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/secretChatIndicator"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="10px"
                android:src="@mipmap/ic_lock"
                android:visibility="gone" />

            <TableLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:shrinkColumns="0">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <!--昵称或群名-->
                    <TextView
                        android:id="@+id/nameTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="会话名称"
                        android:textColor="@color/color_title_conversation_list"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/organizationGroupIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:background="@drawable/shape_round_3"
                        android:paddingLeft="2dp"
                        android:paddingTop="1dp"
                        android:paddingRight="2dp"
                        android:paddingBottom="1dp"
                        android:text="官方"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:visibility="gone"
                        tools:visibility="visible" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <com.hjq.shape.view.ShapeTextView
                        android:id="@+id/nameTimeTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="4dp"
                        android:paddingHorizontal="@dimen/dp_4"
                        android:paddingVertical="@dimen/dp_1"
                        android:textColor="#3B47DD"
                        android:textSize="11sp"
                        android:visibility="gone"
                        app:shape_radius="@dimen/dp_4"
                        app:shape_solidColor="#1F3B47DD"
                        tools:text="30天"
                        tools:visibility="visible" />
                </TableRow>
            </TableLayout>

            <TextView
                android:id="@+id/timeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="12:01"
                android:textColor="@color/color_content_conversation_list"
                android:textSize="12sp" />
        </LinearLayout>

        <!--消息-->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/slient"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="5dp"
                    android:src="@mipmap/block_notification"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/promptTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/draft"
                    android:textColor="@color/red7"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/statusImageView"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="5dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:src="@mipmap/img_error"
                    tools:visibility="visible" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/contentTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:ellipsize="marquee"
                        android:singleLine="true"
                        android:textColor="@color/color_content_conversation_list"
                        android:textSize="13sp"
                        android:layout_marginEnd="25dp"
                        tools:text="[草稿]" />

                    <!--未读消息数-->
                    <TextView
                        android:id="@+id/unreadCountTextView"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/shape_red_dot"
                        android:gravity="center"
                        android:text="99"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <View
                        android:id="@+id/redDotView"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="5dp"
                        android:background="@drawable/shape_red_dot"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </RelativeLayout>
            </LinearLayout>


        </RelativeLayout>
    </LinearLayout>

    <View
        style="@style/Line"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="2dp"
        android:layout_toRightOf="@id/portraitRelativeLayout" />
</RelativeLayout>