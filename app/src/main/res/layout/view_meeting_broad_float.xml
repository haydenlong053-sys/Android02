<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="96dp"
    android:id="@+id/float_layout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_float_meeting"
    android:layout_height="96dp">


    <com.cboda.intelligent.widge.VoiceWaveBroadView
        android:id="@+id/voice_wave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="80dp"
        android:layout_height="80dp"/>
    <com.cboda.intelligent.widge.AvatarShadowBroadView
        android:id="@+id/speak_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shadowColor="@color/AvatarShadow"
        app:shadowDy="4dp"
        app:shadowRadius="8dp"
        android:layout_width="64dp"
        android:layout_height="64dp"/>

    <ImageView
        app:layout_constraintEnd_toStartOf="@id/speak_avatar"
        app:layout_constraintStart_toStartOf="@id/speak_avatar"
        app:layout_constraintTop_toTopOf="@id/speak_avatar"
        android:scaleType="centerInside"
        android:src="@mipmap/ic_meeting_float_mic_on"
        android:background="@drawable/bg_white_oval"
        android:layout_width="16dp"
        android:layout_height="16dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>