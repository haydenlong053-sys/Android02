<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shape_solidColor="@color/white"
    app:shape_topLeftRadius="@dimen/dp_18"
    app:shape_topRightRadius="@dimen/dp_18">

    <com.hjq.shape.layout.ShapeLinearLayout
        android:id="@+id/publishTabContainer"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_16"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/dp_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shape_radius="@dimen/dp_18"
        app:shape_solidColor="@color/color_3B47DD_12">

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/publishTabSquare"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="@dimen/dp_72"
            android:paddingHorizontal="@dimen/dp_16"
            android:text="@string/bottom_bar_gc"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_14"
            app:shape_radius="@dimen/dp_16"
            app:shape_solidColor="@color/color_3B47DD" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/publishTabMoments"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="@dimen/dp_72"
            android:paddingHorizontal="@dimen/dp_16"
            android:text="@string/circle_friend"
            android:textColor="@color/black_65"
            android:textSize="@dimen/sp_14"
            app:shape_radius="@dimen/dp_16"
            app:shape_solidColor="@color/transparent" />
    </com.hjq.shape.layout.ShapeLinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/publishHistory"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_12"
        android:padding="@dimen/dp_10"
        android:scaleType="centerCrop"
        android:src="@mipmap/icon_time2"
        app:layout_constraintBottom_toBottomOf="@id/publishTabContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/publishTabContainer"
        tools:ignore="ContentDescription" />

    <Space
        android:id="@+id/publishSpaceTop"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/publishTabContainer" />

    <com.hjq.shape.layout.ShapeLinearLayout
        android:id="@+id/publishInfoBanner"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_12"
        android:paddingVertical="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/publishSpaceTop"
        app:shape_radius="@dimen/dp_12"
        app:shape_solidColor="@color/color_F4F8FD">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_square_publish_info"
            tools:ignore="ContentDescription" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/publishInfoTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:textColor="@color/color_3B47DD"
            android:textSize="@dimen/dp_12"
            tools:text="发布到广场需质押 2.0 ODIC 以保证信息质量" />
    </com.hjq.shape.layout.ShapeLinearLayout>

    <com.hjq.shape.view.ShapeView
        android:id="@+id/publishInputBg"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_120"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/publishInfoBanner"
        app:shape_radius="@dimen/dp_12"
        app:shape_solidColor="@color/colorF7F8FA" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/publishContentInput"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:background="@null"
        android:gravity="top|start"
        android:hint="@string/square_publish_input_hint"
        android:inputType="textMultiLine"
        android:padding="@dimen/dp_12"
        android:textColor="@color/black_85"
        android:textColorHint="@color/black_35"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="@id/publishInputBg"
        app:layout_constraintEnd_toEndOf="@id/publishInputBg"
        app:layout_constraintStart_toStartOf="@id/publishInputBg"
        app:layout_constraintTop_toTopOf="@id/publishInputBg" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/publishMediaList"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:minHeight="@dimen/dp_72"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/publishInputBg" />

    <com.hjq.shape.layout.ShapeConstraintLayout
        android:id="@+id/publishQuoteLayout"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:padding="@dimen/dp_12"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/publishMediaList"
        app:shape_radius="@dimen/dp_12"
        app:shape_solidColor="#FFF7F8FA"
        app:shape_strokeColor="#283B47DD"
        app:shape_strokeWidth="@dimen/dp_1"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/publishQuoteContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="吴彦祖：今天的真不错！ [图片] [图片]" />
    </com.hjq.shape.layout.ShapeConstraintLayout>

    <com.hjq.shape.view.ShapeView
        android:id="@+id/publishAddMedia"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/publishInputBg" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/publishAddMediaIcon"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/publishInputBg" />

    <com.hjq.shape.view.ShapeView
        android:id="@+id/publishCommentRow"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_55"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/publishQuoteLayout"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="@color/color_3B47DD_12"
        app:shape_strokeColor="#E2E3FF"
        app:shape_strokeWidth="@dimen/dp_0.5" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/publishCommentIcon"
        android:layout_width="@dimen/dp_18"
        android:layout_height="@dimen/dp_18"
        android:layout_marginStart="@dimen/dp_16"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_square_publish_comment"
        app:layout_constraintBottom_toBottomOf="@id/publishCommentRow"
        app:layout_constraintStart_toStartOf="@id/publishCommentRow"
        app:layout_constraintTop_toTopOf="@id/publishCommentRow"
        tools:ignore="ContentDescription" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/publishCommentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:text="@string/square_publish_who_can_comment"
        android:textColor="@color/black_85"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="@id/publishCommentRow"
        app:layout_constraintStart_toEndOf="@id/publishCommentIcon"
        app:layout_constraintTop_toTopOf="@id/publishCommentRow" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/publishCommentArrow"
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        android:layout_marginEnd="@dimen/dp_16"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_broad_next2"
        app:layout_constraintBottom_toBottomOf="@id/publishCommentRow"
        app:layout_constraintEnd_toEndOf="@id/publishCommentRow"
        app:layout_constraintTop_toTopOf="@id/publishCommentRow"
        tools:ignore="ContentDescription" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/publishCommentValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_4"
        android:text="@string/square_publish_everyone"
        android:textColor="@color/black_35"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="@id/publishCommentRow"
        app:layout_constraintEnd_toStartOf="@id/publishCommentArrow"
        app:layout_constraintTop_toTopOf="@id/publishCommentRow" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/publishSubmit"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_48"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_20"
        android:gravity="center"
        android:text="@string/square_publish_submit"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/publishCommentRow"
        app:shape_radius="@dimen/dp_24"
        app:shape_solidColor="@color/color_6672ff" />

    <Space
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/publishSubmit" />

</com.hjq.shape.layout.ShapeConstraintLayout>
