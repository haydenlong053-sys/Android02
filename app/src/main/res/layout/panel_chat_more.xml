<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    app:shape_solidColor="@color/white"
    app:shape_topLeftRadius="@dimen/dp_16"
    app:shape_topRightRadius="@dimen/dp_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <!-- 第1行：相册 / 拍摄 / 收藏夹 / 语音通话 / 文件 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <include
                android:id="@+id/panel_more_album"
                layout="@layout/panel_chat_more_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <include
                android:id="@+id/panel_more_camera"
                layout="@layout/panel_chat_more_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <include
                android:id="@+id/panel_more_collect"
                layout="@layout/panel_chat_more_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <include
                android:id="@+id/panel_more_voice_call"
                layout="@layout/panel_chat_more_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <include
                android:id="@+id/panel_more_file"
                layout="@layout/panel_chat_more_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- 第2行：名片 / 会议室 / 防诈骗 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <include
                android:id="@+id/panel_more_user_card"
                layout="@layout/panel_chat_more_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />


            <include
                android:id="@+id/panel_more_anti_fraud"
                layout="@layout/panel_chat_more_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <include
                android:id="@+id/panel_more_meeting"
                layout="@layout/panel_chat_more_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <include
                layout="@layout/panel_chat_more_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="invisible"
                tools:visibility="visible"
                />

            <include
                layout="@layout/panel_chat_more_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="invisible"
                tools:visibility="visible"
                />


        </LinearLayout>

    </LinearLayout>
</com.hjq.shape.layout.ShapeFrameLayout>
