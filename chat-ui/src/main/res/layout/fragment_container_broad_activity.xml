<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F3F5"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include
        android:id="@+id/toobarlay"
        layout="@layout/toolbar"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/page_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.hjq.shape.view.ShapeView
            android:id="@+id/page_title_left_icon"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_60"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_radius="@dimen/dp_30"
            app:shape_shadowColor="#739e9e9e"
            app:shape_shadowSize="@dimen/dp_10"
            app:shape_solidColor="@color/white" />

        <ImageView
            android:id="@+id/mIvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_broad_back2"
            app:layout_constraintBottom_toBottomOf="@id/page_title_left_icon"
            app:layout_constraintEnd_toEndOf="@id/page_title_left_icon"
            app:layout_constraintStart_toStartOf="@id/page_title_left_icon"
            app:layout_constraintTop_toTopOf="@id/page_title_left_icon" />


        <com.hjq.shape.view.ShapeView
            android:id="@+id/page_title_right_icon"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_60"
            app:layout_constraintBottom_toBottomOf="@id/page_title_left_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/page_title_left_icon"
            app:shape_radius="@dimen/dp_30"
            app:shape_shadowColor="#739e9e9e"
            app:shape_shadowSize="@dimen/dp_10"
            app:shape_solidColor="@color/white" />


        <ImageView
            android:id="@+id/mIvBack2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_broad_gengduo"
            app:layout_constraintBottom_toBottomOf="@id/page_title_right_icon"
            app:layout_constraintEnd_toEndOf="@id/page_title_right_icon"
            app:layout_constraintStart_toStartOf="@id/page_title_right_icon"
            app:layout_constraintTop_toTopOf="@id/page_title_right_icon" />


        <com.hjq.shape.layout.ShapeConstraintLayout
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_0"
            android:gravity="center_horizontal"
            android:minHeight="@dimen/dp_60"
            android:orientation="vertical"
            android:paddingVertical="@dimen/dp_15"
            app:layout_constraintBottom_toBottomOf="@id/page_title_left_icon"
            app:layout_constraintEnd_toStartOf="@id/page_title_right_icon"
            app:layout_constraintStart_toEndOf="@id/page_title_left_icon"
            app:layout_constraintTop_toTopOf="@id/page_title_left_icon"
            app:shape_radius="@dimen/dp_30"
            app:shape_shadowColor="#739e9e9e"
            app:shape_shadowSize="@dimen/dp_10"
            app:shape_solidColor="@color/white">

            <TextView
                android:id="@+id/page_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:ellipsize="end"
                android:gravity="center"
                android:maxWidth="200dp"
                android:singleLine="true"
                android:textAlignment="gravity"
                android:textColor="@color/color_text0"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/titleGradeAndTime"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="用户信息" />

            <LinearLayout
                android:id="@+id/titleGradeAndTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/page_title"
                tools:visibility="visible">

                <com.hjq.shape.view.ShapeTextView
                    android:id="@+id/titleGrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_4"
                    android:textColor="#A5000000"
                    android:textSize="10sp"
                    app:shape_radius="@dimen/dp_4"
                    tools:text="信誉：89分" />

                <com.hjq.shape.view.ShapeTextView
                    android:id="@+id/titleTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:paddingHorizontal="@dimen/dp_4"
                    android:textColor="#A5000000"
                    android:textSize="10sp"
                    app:shape_radius="@dimen/dp_4"
                    tools:text="信誉：89分" />
            </LinearLayout>
        </com.hjq.shape.layout.ShapeConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/containerFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2F3F5" />

</LinearLayout>