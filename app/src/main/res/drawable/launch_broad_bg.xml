<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:endColor="#ffffff"
                android:startColor="#ffffff" />
        </shape>
    </item>

    <!-- width/height 约束 item 区域；bitmap 必须 gravity=fill 才会缩放到 100dp。
         gravity=center 会按 png 固有像素绘制（ic_broad_logo 为 1254px，远大于 100dp）。
         scaleType 不是 layer-list bitmap 的合法属性，会被忽略。 -->
    <item
        android:width="@dimen/dp_100"
        android:height="@dimen/dp_100"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@mipmap/ic_broad_logo" />
    </item>

</layer-list>