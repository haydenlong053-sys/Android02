<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:id="@+id/hometool"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_62">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/ivManager"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <com.hjq.shape.view.ShapeView
                android:id="@+id/shapeView"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_62"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivMore"
                app:layout_constraintStart_toEndOf="@id/ivManager"
                app:layout_constraintTop_toTopOf="parent"
                app:shape_radius="@dimen/dp_31"
                app:shape_shadowColor="#739e9e9e"
                app:shape_shadowSize="@dimen/dp_10"
                app:shape_solidColor="@color/white" />


            <com.cboda.baselibrary.view.magicindicator.MagicBroadIndicator
                android:id="@+id/magicIndicator"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_42"
                android:layout_marginStart="@dimen/dp_20"
                android:layout_marginEnd="@dimen/dp_15"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="@id/shapeView"
                app:layout_constraintEnd_toEndOf="@id/shapeView"
                app:layout_constraintStart_toStartOf="@id/shapeView"
                app:layout_constraintTop_toTopOf="@id/shapeView" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivAdd"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:scaleType="fitXY"
                android:src="@drawable/bg_top_broad_add"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivsousuo"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_broad_sousuo"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivAdd"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/ivMore"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <com.cboda.baselibrary.widge.NestedViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_6" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivsudu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="19dp"
        android:layout_marginBottom="90dp"
        android:src="@mipmap/ic_to_broad_web"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Space
        android:id="@+id/bottomView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivkefu"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginEnd="19dp"
        android:layout_marginBottom="@dimen/dp_80"
        android:visibility="invisible"
        tools:visibility="visible"
        android:src="@mipmap/ic_broad_kefu"
        app:layout_constraintBottom_toTopOf="@id/bottomView3"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_manager_bar"
        android:layout_width="300dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>