<?xml version="1.0" encoding="utf-8"?>
<com.cboda.chatui.widget.InputAwareBroadLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLinearLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/qungonggao"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:visibility="gone">

        <com.cboda.chatui.MarqueeTextBroadView
            android:id="@+id/gonggaoxinxi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="23dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="群公告：群公告群公告：群公告群公告：群公告群公告：群公告群公告：群公告群公告：群公告群公告：群公告群公告：群公告"
            android:textColor="@color/color_text_gonggao"
            android:textSize="13sp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/qunMeetingNotice"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:visibility="gone">

        <com.cboda.chatui.MarqueeTextBroadView
            android:id="@+id/tvQunMeeting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="23dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="群通知：已经开启语音房，点击可加入!"
            android:textColor="@color/color_text_gonggao"
            android:textSize="13sp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!--内容-->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/conversationBackgroundScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/conversationBackgroundImageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipeRefreshLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/msgRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


                <com.cboda.chatui.widget.TopInterceptBroadView
                    android:id="@+id/mViewIntercept"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />


                <com.cboda.baselibrary.widge.HighPerformanceDanmakuView
                    android:id="@+id/verticalDanmakuView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_400"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="@dimen/dp_15"
                    android:layout_marginBottom="@dimen/dp_15"
                    android:clickable="false"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/danmakuIv"
                    android:layout_width="@dimen/dp_66"
                    android:layout_height="@dimen/dp_74"
                    android:layout_gravity="bottom|end"
                    android:paddingTop="@dimen/dp_8"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/icon_dm"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.cboda.baselibrary.widge.CountPillView
                    android:id="@+id/countPillView"
                    android:layout_width="@dimen/dp_42"
                    android:layout_height="@dimen/dp_18"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/dp_48"
                    android:layout_marginBottom="@dimen/dp_45"
                    android:visibility="gone"
                    app:cornerRadius="@dimen/dp_9"
                    app:pillBgColor="#99212234"
                    app:rollLineGapExtra="@dimen/dp_5"
                    app:suffixText="@string/msg_person_unit"
                    app:suffixTextColor="#ffd957"
                    app:suffixTextSize="10sp"
                    tools:visibility="visible" />

                <com.hjq.shape.view.ShapeView
                    android:id="@+id/danmakuView"
                    android:layout_width="@dimen/dp_8"
                    android:layout_height="@dimen/dp_8"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/dp_15"
                    android:layout_marginBottom="@dimen/dp_50"
                    android:visibility="gone"
                    app:shape_radius="@dimen/dp_4"
                    app:shape_solidColor="@color/color_EB534B"
                    tools:visibility="visible" />
            </FrameLayout>


            <com.cboda.chatui.conversation.ConversationInputBroadPanel
                android:id="@+id/inputPanelFrameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_24" />

            <TextView
                android:id="@+id/tvPhoneLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="40dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="40dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/shape_tousu_broad_liaotian"
                android:gravity="center"
                android:text="确定"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/multiMessageActionContainerLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="@dimen/dp_15"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/unreadCountLinearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:gravity="right"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/unreadCountTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/shape_unread_message_count_label_broad_bg"
                android:maxLines="1"
                android:paddingHorizontal="15dp"
                android:paddingVertical="7dp"
                android:text="12条消息"
                android:textColor="@color/white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/unreadMentionCountTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/shape_unread_message_count_label_broad_bg"
                android:paddingHorizontal="15dp"
                android:paddingVertical="7dp"
                android:text="12条@消息"
                android:textColor="@color/white"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ongoingCallRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/mViewMeetJoin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_36"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:layout_marginTop="@dimen/dp_4"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:shape_radius="@dimen/dp_16"
            app:shape_solidColor="@color/color_EB534B_35"
            tools:visibility="visible">

            <TextView
                android:id="@+id/mTvMeetPeople"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_weight="1"
                android:text="@string/msg_meeting_active_count"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_14" />

            <com.hjq.shape.view.ShapeTextView
                android:id="@+id/mTvMeetJoin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_5"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_5"
                android:text="@string/msg_meeting_join"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:shape_radius="@dimen/dp_16"
                app:shape_solidColor="@color/color_EB534B" />

        </com.hjq.shape.layout.ShapeLinearLayout>

    </FrameLayout>

</com.cboda.chatui.widget.InputAwareBroadLayout>