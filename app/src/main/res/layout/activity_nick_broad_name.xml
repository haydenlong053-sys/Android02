<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <TextView
        android:id="@+id/tvTitle1"
        android:text="@string/昵称"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="50dp"
        android:textColor="@color/color_text0"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="13dp"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/bg_rect_broad_input"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <EditText
            android:id="@+id/etNickName"
            android:textColor="#344361"
            android:hint="@string/请输入"
            android:maxLength="32"
            android:textSize="14sp"
            android:paddingHorizontal="25dp"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/imDelate"
            android:visibility="gone"
            android:paddingHorizontal="10dp"
            android:src="@mipmap/ic_edit_broad_delate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvSave"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="37dp"
        android:background="@mipmap/ic_bg_btn2_broad_01"
        android:gravity="center"
        android:text="@string/完成"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>