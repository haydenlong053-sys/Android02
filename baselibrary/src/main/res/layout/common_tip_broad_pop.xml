<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    tools:background="@color/black">

    <com.hjq.shape.layout.ShapeLinearLayout
        android:id="@+id/mLlSaveView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_40"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:shape_radius="@dimen/dp_16"
        app:shape_strokeColor="@color/white"
        app:shape_strokeWidth="@dimen/dp_05"
        app:shape_solidColor="@color/white"
        tools:ignore="UselessParent">


        <TextView
            android:id="@+id/mTvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="18sp"
            tools:text="该账号交易限制" />

        <TextView
            android:id="@+id/mTvDes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/black_65"
            android:textSize="14sp"
            tools:text="请联系客服008号" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp">

            <com.hjq.shape.view.ShapeTextView
                android:id="@+id/mTvCancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="23dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/bs_quxiao"
                android:textColor="@color/color_3B47DD"
                android:textSize="16sp"
                app:shape_radius="@dimen/dp_16"
                app:shape_solidColor="@color/white"
                app:shape_strokeColor="@color/color_3B47DD"
                app:shape_strokeWidth="@dimen/dp_1" />

            <com.hjq.shape.view.ShapeTextView
                android:id="@+id/mTvSure"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/bs_mine_sure"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:shape_radius="@dimen/dp_16"
                app:shape_solidColor="@color/color_3B47DD" />
        </LinearLayout>


    </com.hjq.shape.layout.ShapeLinearLayout>

</FrameLayout>
