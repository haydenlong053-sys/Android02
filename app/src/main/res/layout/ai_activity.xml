<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <com.hjq.shape.view.ShapeView
        android:id="@+id/leftView"
        android:layout_width="@dimen/dp_62"
        android:layout_height="@dimen/dp_62"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shape_radius="@dimen/dp_31"
        app:shape_shadowColor="#739e9e9e"
        app:shape_shadowSize="@dimen/dp_10"
        app:shape_solidColor="@color/white" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/returnIv"
        android:layout_width="@dimen/dp_12"
        android:layout_height="@dimen/dp_12"
        android:scaleType="centerCrop"
        android:src="@mipmap/icon_ai_close"
        app:layout_constraintBottom_toBottomOf="@id/leftView"
        app:layout_constraintEnd_toEndOf="@id/leftView"
        app:layout_constraintStart_toStartOf="@id/leftView"
        app:layout_constraintTop_toTopOf="@id/leftView" />

    <com.hjq.shape.view.ShapeView
        android:id="@+id/rightView"
        android:layout_width="@dimen/dp_62"
        android:layout_height="@dimen/dp_62"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/leftView"
        app:shape_radius="@dimen/dp_31"
        app:shape_shadowColor="#739e9e9e"
        app:shape_shadowSize="@dimen/dp_10"
        app:shape_solidColor="@color/white" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/aiTime"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:scaleType="centerCrop"
        android:src="@mipmap/icon_ai_time"
        app:layout_constraintBottom_toBottomOf="@id/rightView"
        app:layout_constraintEnd_toEndOf="@id/rightView"
        app:layout_constraintStart_toStartOf="@id/rightView"
        app:layout_constraintTop_toTopOf="@id/rightView" />

    <com.hjq.shape.view.ShapeView
        android:id="@+id/shapeView"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_62"
        android:layout_marginHorizontal="@dimen/dp_52"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/leftView"
        app:shape_radius="@dimen/dp_31"
        app:shape_shadowColor="#739e9e9e"
        app:shape_shadowSize="@dimen/dp_10"
        app:shape_solidColor="@color/white" />

    <com.cboda.baselibrary.view.magicindicator.MagicBroadIndicator
        android:id="@+id/aiMagicIndicator"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_42"
        android:layout_marginHorizontal="@dimen/dp_15"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/shapeView"
        app:layout_constraintEnd_toEndOf="@id/shapeView"
        app:layout_constraintStart_toStartOf="@id/shapeView"
        app:layout_constraintTop_toTopOf="@id/shapeView" />


    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shapeView" />
</androidx.constraintlayout.widget.ConstraintLayout>