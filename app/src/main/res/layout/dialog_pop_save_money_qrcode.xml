<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    >
    <LinearLayout
        android:id="@+id/mLlSaveView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rect_white_broad_16dp"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical"
        android:gravity="center"
        tools:ignore="UselessParent">

        <TextView
            android:id="@+id/mTvDes1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mine_money_qrcode"
            android:textColor="@color/black"
            android:gravity="center"
            android:textSize="18sp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            />

        <ImageView
            android:id="@+id/mIvQrCodeAuth"
            android:layout_width="160dp"
            android:layout_height="160dp"
            tools:src="@mipmap/ic_security_auth"
            android:layout_marginTop="24dp"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/mTvDes2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mine_transfer_des1"
            android:textColor="@color/black_65"
            android:gravity="center"
            android:textSize="14sp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"/>

        <LinearLayout
            android:id="@+id/mLlGoogleAuthCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_rect_mine_eeeff0_10dp"
            android:gravity="center"
            >
            <TextView
                android:id="@+id/mTvCopyDes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="12dp"
                tools:text="GHFSHSGDJDFYDY"
                android:gravity="center|start"
                android:textColor="@color/black"
                android:textSize="14sp"
                />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:src="@mipmap/ic_copy"
                tools:ignore="ContentDescription" />


        </LinearLayout>

        <TextView
            android:id="@+id/mTvSaveQrcode"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_rect_mine_1e000000_16dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:text="@string/保存二维码"
            android:gravity="center"
            android:textColor="@color/color_3B47DDk"
            android:textSize="16sp"
            />

    </LinearLayout>
    <ImageView
        android:id="@+id/mViewClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/ic_pop_close"
        android:layout_gravity="center_horizontal"
        android:padding="24dp"
        />
</LinearLayout>
