<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="544dp"
    android:id="@+id/mViewTopBg"
    android:background="@drawable/bg_rect_white_only_top_broad_18dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:id="@+id/mIvClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_auth_broad_close"
                tools:ignore="ContentDescription"
                android:padding="16dp"
                />

            <TextView
                android:id="@+id/mTvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="18dp"
                android:text="@string/mine_auth_way"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="16sp"
                 />

            <ImageView
                android:id="@+id/mIvGo"
                android:layout_width="48dp"
                android:layout_height="54dp"
                android:src="@mipmap/ic_auth_broad_go"
                tools:ignore="ContentDescription"
                android:padding="20dp"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/mLlGoogleAuth"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rect_save_broad_10dp"
            android:gravity="center"
            >
            <TextView
                android:id="@+id/mTvGoogleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:text="@string/mine_google_auth"
                android:gravity="center|start"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:drawablePadding="8dp"
                app:drawableStartCompat="@mipmap/ic_google_broad_auth" />

            <TextView
                android:id="@+id/mViewAddGoogle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black66"
                android:textSize="14sp"
                android:text="@string/mine_auth_add"
                android:layout_marginEnd="16dp"
                />
            <ImageView
                android:id="@+id/mViewGoogle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_icon_auth_broad_ok"
                android:layout_marginEnd="16dp"
                tools:ignore="ContentDescription"
                android:visibility="gone"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mLlPassWord"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rect_save_broad_10dp"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible"
            >
            <TextView
                android:id="@+id/mTvPasswordText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:text="@string/mine_pay_password"
                android:gravity="center|start"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:drawablePadding="8dp"
                app:drawableStartCompat="@mipmap/ic_pay_password_broad_auth" />

            <TextView
                android:id="@+id/mViewAddPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black66"
                android:textSize="14sp"
                android:text="@string/mine_auth_add"
                android:layout_marginEnd="16dp"

                />
            <ImageView
                android:id="@+id/mViewPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_icon_auth_broad_ok"
                android:layout_marginEnd="16dp"
                tools:ignore="ContentDescription"
                android:visibility="gone"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mLlSecurity"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rect_save_broad_10dp"
            android:gravity="center"
            >
            <TextView
                android:id="@+id/mTvSecurityText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:text="@string/mine_security_auth"
                android:gravity="center|start"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:drawablePadding="8dp"
                app:drawableStartCompat="@mipmap/ic_security_broad_auth" />

            <TextView
                android:id="@+id/mViewAddSecurity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black66"
                android:textSize="14sp"
                android:text="@string/mine_auth_add"
                android:layout_marginEnd="16dp"
                />
            <ImageView
                android:id="@+id/mViewSecurity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_icon_auth_broad_ok"
                android:layout_marginEnd="16dp"
                tools:ignore="ContentDescription"
                android:visibility="gone"
                />
        </LinearLayout>



    </LinearLayout>
</FrameLayout>
