<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="33dp"
    android:background="@color/bg_main"
    >
    <TextView
        android:id="@+id/tvHint"
        android:text="@string/请输入您的登录密码"
        android:layout_marginTop="50dp"
        android:textSize="14sp"
        android:textColor="@color/color_text0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:id="@+id/llPassword"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="13dp"
        android:background="@drawable/bg_rect_broad_input"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <EditText
            android:id="@+id/etPassword"
            android:textColor="@color/color_text0"
            android:hint="@string/请输入"
            android:textColorHint="@color/color_text_content_hint"
            android:textSize="14sp"
            android:paddingHorizontal="25dp"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/imDelate"
            android:visibility="gone"
            android:paddingHorizontal="10dp"
            android:src="@mipmap/ic_edit_broad_delate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/llCode"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:visibility="gone"
        tools:visibility="visible"
        android:layout_marginTop="13dp"
        android:background="@drawable/bg_rect_broad_input"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/etYzm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/请输入验证码"
            android:textColorHint="@color/color_text_content_hint"
            android:paddingHorizontal="22dp"
            android:textColor="@color/color_text0"
            android:textSize="14sp"
            android:textStyle="bold" />
        <View
            android:background="#CCCCCC"
            android:layout_width="0.5dp"
            android:layout_height="18.5dp"/>
        <TextView
            android:id="@+id/tvGetCode"
            android:text="@string/获取验证码"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#5456F6"
            android:layout_width="104dp"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvSave"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="3dp"
        android:background="@mipmap/ic_bg_btn2_broad_01"
        android:gravity="center"
        android:text="@string/完成"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>