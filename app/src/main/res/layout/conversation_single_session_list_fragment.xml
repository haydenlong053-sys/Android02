<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/layout_im_network_unavailable_banner" />

        <!-- 对齐野火 ConversationSingleBroadFragment：首栏系统公告 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mRvHead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:nestedScrollingEnabled="false" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh_conversations"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_conversations"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/wechat_bg_page"
                    android:clipToPadding="false"
                    tools:listitem="@layout/item_conversation" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <TextView
                android:id="@+id/tv_empty"
                style="@style/WeChatTextSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/conversation_list_empty"
                android:visibility="gone" />

            <include
                android:id="@+id/conversation_list_error"
                layout="@layout/conversation_list_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/wechat_green"
        android:visibility="gone"
        tools:visibility="visible" />

</FrameLayout>
