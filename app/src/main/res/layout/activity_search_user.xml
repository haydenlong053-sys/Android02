<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main_space"
    android:orientation="vertical">


    <View
        android:id="@+id/hometool"
        android:layout_width="match_parent"
        android:layout_height="0dp" />
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/bg_main"
        android:gravity="center_vertical">

        <com.base.commonlibrary.shapeview.shape.ShapeConstraintLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:layout_marginStart="23dp"
            app:shapeCornersRadius="10dp"
            app:shapeSolidColor="@color/color_input_bg">

            <EditText
                android:id="@+id/edtSousuo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:drawableLeft="@mipmap/ic_search2"
                android:drawablePadding="8dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:hint="@string/sousuonicheng"
                android:imeOptions="actionSearch"
                android:paddingStart="20dp"
                android:singleLine="true"
                android:textColor="#A5A5A5"
                android:textColorHint="#A5A5A5"
                android:textSize="13sp" />

        </com.base.commonlibrary.shapeview.shape.ShapeConstraintLayout>
        
        <TextView
            android:id="@+id/quxiao"
            android:text="@string/quxiao"
            android:textColor="@color/color_text0"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_width="56dp"
            android:layout_height="40dp"/>

    </androidx.appcompat.widget.LinearLayoutCompat>


    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/smartLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</LinearLayout>