<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/llYzmPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="34dp"
            android:layout_marginTop="40dp"
            android:drawableLeft="@mipmap/ic_login_broad_phone"
            android:drawablePadding="12dp"
            android:text="@string/手机号"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="33dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rect_0b0a10_broad_10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etPhone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/请输入手机号"
                android:paddingHorizontal="22dp"
                android:textColor="#ffffff"
                android:textColorHint="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold" />
            <View
                android:background="#CCCCCC"
                android:layout_width="0.5dp"
                android:layout_height="18.5dp"/>
            <TextView
                android:id="@+id/tvGetCode"
                android:text="@string/获取验证码"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:layout_width="104dp"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="34dp"
            android:layout_marginTop="25dp"
            android:drawableLeft="@mipmap/ic_login_broad_yzm"
            android:drawablePadding="12dp"
            android:text="@string/验证码"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="33dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rect_0b0a10_broad_10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etYzm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/请输入验证码"
                android:textColor="#ffffff"
                android:textColorHint="#ffffff"
                android:paddingHorizontal="22dp"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/tvSubmit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="33dp"
        android:background="@mipmap/ic_bg_btn2_broad_01"
        android:gravity="center"
        android:text="@string/完成"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>