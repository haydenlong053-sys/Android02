<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AUIKit.Basic" parent="Theme.MaterialComponents.Light">
        <item name="android:windowBackground">@android:color/white</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/aui_primary</item>
        <item name="colorPrimaryVariant">@color/aui_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/aui_grey_light</item>
        <item name="colorSecondaryVariant">@color/aui_grey_light</item>
        <item name="colorOnSecondary">@color/aui_black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- 基础组件 -->
        <!--         Button       -->
        <item name="aui_button_appearance">@style/AUIBroadButton</item>
        <item name="aui_button_appearance_stroke">@style/AUIBroadButton.Stroke.Dark</item>
        <item name="aui_button_appearance_min">@style/AUIBroadButton.Mini</item>
        <item name="aui_button_appearance_min_stroke">@style/AUIBroadButton.Mini.Stroke</item>
        <item name="aui_button_appearance_circle">@style/AUIBroadButton.Circle</item>
        <item name="aui_button_appearance_circle_stroke">@style/AUIBroadButton.Circle.Stroke</item>
        <!--         EditText       -->
        <item name="aui_editText_appearance">@style/AUIEditBroadText</item>
        <item name="aui_editText_appearance_outline">@style/AUIEditBroadText.OutLine</item>
        <!--         BottomDialog       -->
        <item name="aui_bottomDialog_appearance">@style/AUIBottomBroadDialog</item>
        <!--         AlertDialog       -->
        <item name="aui_alertDialog_appearance">@style/AUIAlertBroadDialog.Dark</item>
        <item name="aui_alertDialog_appearance_outline">@style/AUIAlertBroadDialog.Outline</item>
        <!--         Dividers       -->
        <item name="aui_dividers_appearance">@style/AUIBroadDividers</item>
        <!--         TitleBar       -->
        <item name="aui_titleBar_appearance">@style/AUITitleBroadBar</item>
        <!--         NavigationBar       -->
        <item name="aui_navigationBar_appearance">@style/AUINavigationBroadBar</item>
        <!--         TabLayout       -->
        <item name="aui_tabLayout_appearance">@style/AUITabBroadLayout</item>
        <item name="aui_tabLayout_appearance_round">@style/AUITabBroadLayout.Round</item>
        <!--         AUICellBroadText       -->
        <item name="aui_cellText_appearance">@style/AUICellBroadText</item>
    </style>

</resources>