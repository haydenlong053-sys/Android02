<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/black">

    <com.hjq.shape.view.ShapeView
        android:id="@+id/backView"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_148"
        android:layout_marginBottom="-34dp"
        app:layout_constraintBottom_toBottomOf="@id/loginBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="#FF0F1B3A"
        app:shape_strokeColor="#FF3E5387"
        app:shape_strokeWidth="@dimen/dp_1"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/forgetPwdTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/account_verification"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@id/backView"
        app:layout_constraintStart_toStartOf="@id/backView"
        app:layout_constraintTop_toTopOf="@id/backView" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/forgetPwdTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_24"
        android:text="@string/please_enter_account_to_recover_password"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/backView"
        app:layout_constraintTop_toBottomOf="@id/forgetPwdTv"
        app:layout_constraintEnd_toEndOf="@id/backView"

        />

    <com.hjq.shape.view.ShapeEditText
        android:id="@+id/loginAccount"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_50"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_16"
        android:drawableStart="@mipmap/icon_login_broad_account"
        android:drawablePadding="@dimen/dp_12"
        android:hint="@string/please_enter_account"
        android:paddingHorizontal="@dimen/dp_16"
        android:textColor="@color/white"
        android:textColorHint="#7366A0F7"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/backView"
        app:layout_constraintStart_toStartOf="@id/backView"
        app:layout_constraintTop_toBottomOf="@id/forgetPwdTitle"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="@color/color_080E1E"
        app:shape_strokeColor="@color/color_080E1E"
        app:shape_strokeWidth="@dimen/dp_1" />




    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/loginBtn"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_50"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_32"
        android:gravity="center"
        android:text="@string/next_step"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/backView"
        app:layout_constraintStart_toStartOf="@id/backView"
        app:layout_constraintTop_toBottomOf="@id/loginAccount" />



</androidx.constraintlayout.widget.ConstraintLayout>