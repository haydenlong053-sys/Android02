<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">
    <include layout="@layout/layout_my_toolbar_style1" android:id="@+id/toolbar"/>

    <LinearLayout
        android:id="@+id/llCurrencyTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="17dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_rect_white_10dp"
        android:padding="8dp"
        >

        <!-- WEBX 标签（选中状态） -->
        <com.base.commonlibrary.shapeview.shape.ShapeTextView
            android:id="@+id/tvCurrencyWebx"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/webX_name"
            android:textColor="@color/color_3B47DD"
            android:textSize="16sp"
            android:textStyle="bold"
            app:shapeCornersRadius="10dp"
            app:shapeSolidColor="@color/white"
            app:shapeStrokeColor="@color/color_3B47DD"
            app:shapeStrokeWidth="1dp"
            />

        <!-- WX 标签（未选中状态） -->
        <com.base.commonlibrary.shapeview.shape.ShapeTextView
            android:id="@+id/tvCurrencyWx"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="WX"
            android:textStyle="bold"
            android:textColor="#333333"
            android:textSize="16sp"
            app:shapeCornersRadius="10dp"
            app:shapeSolidColor="#F2F3F5"
            app:shapeStrokeWidth="1dp"
            app:shapeStrokeColor="@color/color_F2F3F5"
            />
    </LinearLayout>


    <com.base.commonlibrary.shapeview.shape.ShapeConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="17dp"
        app:shapeSolidColor="@color/white"
        app:shapeCornersRadius="10dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/hb_total_numb"
            android:textColor="#EB534B"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/edtjine"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="29dp"
            android:paddingEnd="8dp"
            android:maxWidth="150dp"
            android:background="@color/transparent"
            android:textColor="@color/black"
            android:inputType="numberDecimal"
            android:textSize="16sp"
            android:textColorHint="@color/black_45"
            android:hint="0.00"
            android:gravity="end|center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvTotalAmountValue"
            />

        <TextView
            android:id="@+id/tvTotalAmountValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/webX_name"
            android:textColor="#EB534B"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

    </com.base.commonlibrary.shapeview.shape.ShapeConstraintLayout>

   <androidx.appcompat.widget.LinearLayoutCompat
       android:layout_width="match_parent"
       android:layout_height="50dp"
       android:visibility="gone"
       tools:visibility="gone"
       >
       <TextView
           android:gravity="center_vertical"
           android:drawablePadding="5dp"
           android:paddingEnd="20dp"
           android:drawableRight="@mipmap/ic_down"
           android:id="@+id/hongbaoleixing"
           android:layout_width="wrap_content"
           android:layout_height="match_parent"
           android:paddingStart="15dp"
           android:text="@string/putonghongboa"
           android:textColor="#BF8D3C"
           android:textSize="14sp"
           />
   </androidx.appcompat.widget.LinearLayoutCompat>

    <com.base.commonlibrary.shapeview.shape.ShapeConstraintLayout
        android:id="@+id/geshulayout"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="17dp"
        android:layout_marginTop="12dp"
        app:shapeCornersRadius="10dp"
        app:shapeSolidColor="@color/white"
        >

        <TextView
            android:drawablePadding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/hongboashuliang"
            android:textColor="#EB534B"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:paddingEnd="8dp"
            android:paddingStart="8dp"
            app:layout_constraintEnd_toStartOf="@+id/tvgeshu"
            android:id="@+id/edthongbaonun"
            android:gravity="end|center_vertical"
            android:background="@color/transparent"
            android:textColor="@color/black"
            android:inputType="number"
            android:textSize="16sp"
            android:textColorHint="@color/black_45"
            android:hint="@string/mine_input"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            />

        <TextView
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/tvgeshu"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:text="@string/hongboashuliangtips2"
            android:textColor="#EB534B"
            android:textSize="16sp"
            />
    </com.base.commonlibrary.shapeview.shape.ShapeConstraintLayout>

    <com.base.commonlibrary.shapeview.shape.ShapeConstraintLayout
        android:id="@+id/zhuanshulay"
        android:visibility="gone"
        tools:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:shapeCornersRadius="8dp"
        app:shapeSolidColor="@color/bg_main1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:text="@string/fageishui"
            android:textColor="@color/color_text0"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <ImageView
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/qunmingceng"
            android:id="@+id/quntouxiang"
            android:layout_width="25dp"
            android:layout_height="25dp" />

        <TextView
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:maxWidth="120dp"
            android:ellipsize="end"
            android:layout_marginEnd="35dp"
            android:maxLines="1"
            android:textColor="@color/color_text0"
            android:textSize="14sp"
            android:id="@+id/qunmingceng"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatImageView
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:src="@mipmap/ic_next" />
    </com.base.commonlibrary.shapeview.shape.ShapeConstraintLayout>

    <TextView
        android:id="@+id/quinrenshu"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="25dp"
        android:text="@string/qunrenshutis"
        android:textColor="#9F9F9F"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible"
        />

    <!-- 祝福语标签 -->
    <TextView
        android:id="@+id/tvGreetingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="祝福语"
        android:textColor="@color/black_65"
        android:textSize="14sp"
        />
    <com.base.commonlibrary.shapeview.shape.ShapeConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="17dp"
        app:shapeSolidColor="@color/white"
        app:shapeCornersRadius="10dp"
        >

        <EditText
            android:id="@+id/edtjieshao"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/transparent"
            android:padding="12dp"
            android:textColor="@color/black_45"
            android:textSize="16sp"
            android:textColorHint="@color/color_text_content_hint"
            android:text="@string/hb_good_word"

            />

    </com.base.commonlibrary.shapeview.shape.ShapeConstraintLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_marginTop="62dp"
        android:gravity="bottom"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/qianNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="54sp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/yuanqian"
            android:textColor="@color/black"
            android:textSize="24sp"
            />
    </androidx.appcompat.widget.LinearLayoutCompat>
    <TextView
        android:id="@+id/tvPhoneLogin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_rect_solid_3b47dd_16dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="39dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:text="@string/hb_send_hongbao"
        android:textColor="@color/white"
        android:textSize="16sp"
        />


</LinearLayout>