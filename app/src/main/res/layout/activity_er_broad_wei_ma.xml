<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#5456F6"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".lj.ErWeiMaBroadActivity">
    <View
        android:id="@+id/viHead"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imFinish1"
            android:layout_width="50dp"
            android:tint="@color/white"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:padding="18dp"
            android:src="@mipmap/ic_back" />
    </FrameLayout>
    <LinearLayout
        android:id="@+id/llContent"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="100dp"
        android:background="@mipmap/ic_erweima_bg"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/riIcon"
                app:riv_oval="true"
                android:src="@mipmap/ic_head"
                android:scaleType="centerCrop"
                android:layout_width="47dp"
                android:layout_height="47dp"/>
            <TextView
                android:id="@+id/tvName"
                tools:text="蜡笔小新"
                android:textSize="15sp"
                android:textColor="#222222"
                android:textStyle="bold"
                android:layout_marginLeft="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/imCode"
            android:layout_marginTop="65dp"
            android:layout_gravity="center_horizontal"
            android:layout_width="178dp"
            android:layout_height="178dp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvSave"
        android:textStyle="bold"
        android:textColor="#5456F6"
        android:textSize="16sp"
        android:layout_marginTop="54dp"
        android:layout_marginHorizontal="62.5dp"
        android:background="@drawable/bg_rect_white_broad_27dp"
        android:gravity="center"
        android:text="@string/点击保存图片"
        android:layout_width="match_parent"
        android:layout_height="55dp"/>
</LinearLayout>