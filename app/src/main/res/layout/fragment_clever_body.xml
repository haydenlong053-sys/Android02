<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/aiTime"
        android:layout_width="@dimen/dp_66"
        android:layout_height="@dimen/dp_66"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginEnd="@dimen/dp_8"
        android:scaleType="centerCrop"
        android:src="@mipmap/icon_ai_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.hjq.shape.view.ShapeView
        android:id="@+id/shapeView"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_62"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/aiTime"
        app:shape_radius="@dimen/dp_31"
        app:shape_shadowColor="#739e9e9e"
        app:shape_shadowSize="@dimen/dp_10"
        app:shape_solidColor="@color/white" />

    <com.cboda.baselibrary.view.magicindicator.MagicBroadIndicator
        android:id="@+id/aiMagicIndicator"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_42"
        android:layout_marginHorizontal="@dimen/dp_15"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/shapeView"
        app:layout_constraintEnd_toEndOf="@id/shapeView"
        app:layout_constraintStart_toStartOf="@id/shapeView"
        app:layout_constraintTop_toTopOf="@id/shapeView" />


    <FrameLayout
        android:id="@+id/viewPagerLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shapeView" />


</androidx.constraintlayout.widget.ConstraintLayout>


