<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mViewClose"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:paddingBottom="100dp"
    >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mLlSaveView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rect_white_16dp"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="88dp"
        tools:ignore="UselessParent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="H,343:64"
            android:scaleType="fitXY"
            android:src="@mipmap/ic_notice_icon_2"
            />
        <TextView
            android:id="@+id/mTvNoticeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/black_85"
            android:textSize="18sp"
            android:layout_marginHorizontal="35dp"
            android:layout_marginTop="60dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:textStyle="bold"
            android:singleLine="true"
            tools:text="这是公告弹窗标题最多多16个这是公告弹窗标题最多多16个"
            />

        <TextView
            android:id="@+id/mTvNoticeDes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textColor="@color/black_85"
            android:textSize="14sp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mTvNoticeTitle"
            app:layout_constraintBottom_toTopOf="@id/mIvNoticeIcon"
            android:lines="6"
            android:ellipsize="end"
            tools:text="字公告公告一"
            />
        <ImageView
            android:id="@+id/mIvNoticeIcon"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:layout_marginHorizontal="24dp"
            android:scaleType="centerCrop"
            tools:src="@mipmap/ic_auth_step_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mTvNoticeDes"
            android:layout_marginTop="8dp"
            android:visibility="visible"
            />

        <TextView
            android:id="@+id/mTvSure"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_rect_solid_3b47dd_16dp"
            android:text="@string/mine_look_go"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mIvNoticeIcon"
            android:layout_marginTop="16dp"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:layout_width="196dp"
        android:layout_height="140dp"
        android:scaleType="fitXY"
        android:src="@mipmap/ic_notice_icon_1"
        android:layout_gravity="center_horizontal"
        />

</FrameLayout>
