<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/expression_view"
        android:id="@+id/normal_layout"
        android:visibility="visible"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="55dp">

        <TextView
            android:layout_weight="1"
            android:id="@+id/tv_input"
            android:background="@drawable/bg_edit_radius"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="start|center_vertical"
            android:textColor="@color/white35"
            android:text="这里输入你想说的"
            android:layout_width="match_parent"
            android:layout_height="40dp"/>


       <androidx.constraintlayout.widget.ConstraintLayout
           android:visibility="gone"
           android:layout_marginStart="8dp"
           android:id="@+id/cl_manager"
           android:background="@drawable/bg_meeting_close"
           android:layout_width="40dp"
           android:layout_height="40dp">
           <com.cboda.agora.ui.ui.basic.AUIImageBroadView
               android:id="@+id/iv_manager"
               android:src="@drawable/ic_voice_bottom_broad_manager"
               app:layout_constraintEnd_toEndOf="parent"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintBottom_toBottomOf="parent"
               app:layout_constraintTop_toTopOf="parent"
               android:layout_width="24dp"
               android:layout_height="24dp"/>

           <View android:layout_width="12dp"
               app:layout_constraintStart_toEndOf="@id/iv_manager"
               app:layout_constraintBottom_toTopOf="@id/iv_manager"
               app:layout_constraintTop_toTopOf="@id/iv_manager"
               app:layout_constraintEnd_toEndOf="@id/iv_manager"
               android:id="@+id/redPoint"
               android:visibility="gone"
               android:layout_height="12dp"
               android:background="@drawable/bg_point_unread"/>
       </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_marginStart="8dp"
            android:id="@+id/cl_mic"
            android:visibility="gone"
            android:background="@drawable/bg_meeting_close"
            android:layout_width="40dp"
            android:layout_height="40dp">
            <com.cboda.agora.ui.ui.basic.AUIImageBroadView
                android:id="@+id/iv_mic"
                android:src="@drawable/ic_voice_bottom_mic_broad_on"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="24dp"
                android:layout_height="24dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>




    </LinearLayout>

    <View
        android:id="@+id/vKeyboardBg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/input_view"
        android:visibility="gone"
        android:background="@color/voice_dialog_bg_color"
        android:layout_width="match_parent"
        android:paddingStart="15dp"
        app:layout_constraintBottom_toTopOf="@+id/vKeyboardBg"
        android:layout_height="55dp">

        <com.cboda.agora.ui.ui.basic.AUIImageBroadView
            android:id="@+id/mic_icon"
            style="@style/ShapeAppearance.MaterialComponents.RoundComponent"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/voice_icon_mic_on"
            android:visibility="gone"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/input_bg"
            app:layout_constraintRight_toLeftOf="@+id/input_send"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/mic_icon"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_edit_radius"
            android:layout_width="0dp"
            android:layout_height="40dp">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/input_edit_view"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/icon_emoji"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/transparent"
                android:hint="Aa"
                android:textColorHint="@color/white35"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:ellipsize="end"
                android:maxLength="80"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_width="0dp"
                android:layout_height="22dp"/>

            <com.cboda.agora.ui.ui.basic.AUIImageBroadView
                android:id="@+id/icon_emoji"
                android:src="@drawable/voice_icon_broad_face"
                android:layout_marginEnd="9dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:layout_width="24dp"
                android:layout_height="24dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/input_send"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_send_blue"
            android:gravity="center"
            android:text="发送"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_width="44dp"
            android:layout_height="32dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.cboda.agora.ui.ui.chatBottomBar.impl.AUIEmojiBroadView
        android:id="@+id/expression_view"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>



</androidx.constraintlayout.widget.ConstraintLayout>