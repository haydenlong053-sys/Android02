<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginEnd="32dp"
        app:shapeCornersRadius="15dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/uxanzview"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="10dp"
            android:src="@mipmap/ic_broad_yixuanz"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/uxanzview2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="10dp"
            android:src="@mipmap/ic_broad_yixuanz"
            android:tint="#80ffffff"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.cboda.baselibrary.view.AppRoundBroadImage
            android:id="@+id/ivTouxiang"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@color/black" />

        <TextView
            android:id="@+id/tvname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="45dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textColor="@color/color_text0"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivTouxiang"
            app:layout_constraintTop_toTopOf="@+id/ivTouxiang"
            tools:text="亚历克斯福建省大不大方水电费哈吉斯发送" />

        <TextView
            android:id="@+id/tvname2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="45dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textColor="@color/color_text0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivTouxiang"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="亚历克斯福建省大不大方水电费哈吉斯发送" />


        <TextView
            android:id="@+id/tvnicheng"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:textColor="@color/color_text_content"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/ivTouxiang"
            app:layout_constraintTop_toBottomOf="@+id/tvname"
            tools:text="昵称：i后来" />
    </com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout>


</LinearLayout>