<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main_space"
    tools:context=".lj.PushBroadActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etContent"
            android:background="@drawable/bg_rect_broad_main"
            android:gravity="top"
            android:paddingHorizontal="20dp"
            android:paddingVertical="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginHorizontal="12dp"
            android:hint="@string/请填写消息内容"
            android:textColor="#999999"
            android:textColorHint="#999999"
            android:textSize="15sp"
            android:minHeight="188dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:paddingVertical="10dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_rect_broad_main">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ryImage"
                android:layout_marginHorizontal="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/llAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:gravity="center"
                android:orientation="vertical">


                <ImageView
                    android:id="@+id/ivFile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@mipmap/ic_add_broad_upload"/>

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="100dp"
                    android:singleLine="true"
                    android:visibility="invisible"
                    android:layout_marginTop="10dp"
                    android:text="文件名称"
                    android:textColor="#ffffffff"
                    android:textSize="12sp"
                    />
            </LinearLayout>


        </LinearLayout>



        <LinearLayout
            android:id="@+id/llTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:paddingHorizontal="15dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_rect_broad_main"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="提醒时间"
                android:textColor="@color/color_text0"
                android:textSize="14sp"
                />
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="5dp"
                android:drawableRight="@mipmap/ic_right"
                android:text="2025/01/01 12:00"
                android:hint="@string/请选择提醒时间"
                android:textColor="@color/color_text_content"
                android:textSize="12sp"
                />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/llType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:paddingHorizontal="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/bg_rect_broad_main"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="提醒方式"
                android:textColor="@color/color_text0"
                android:textSize="14sp"
                />
            <TextView
                android:id="@+id/tvType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="5dp"
                android:drawableRight="@mipmap/ic_right"
                android:text="仅一次"
                android:textColor="@color/color_text_content"
                android:textSize="12sp"
                />

        </LinearLayout>

        <TextView
            android:id="@+id/tvConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:gravity="center"
            android:textStyle="bold"
            android:background="@mipmap/ic_bg_btn2_broad_01"
            android:text="@string/确认"
            android:textColor="#ffffffff"
            android:textSize="16sp"
            />


    </LinearLayout>

</FrameLayout>