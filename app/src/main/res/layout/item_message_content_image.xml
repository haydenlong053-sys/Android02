<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.cboda.baselibrary.view.AppRoundBroadImage
        android:id="@+id/iv_message_image"
        android:layout_width="@dimen/wechat_image_bubble_size"
        android:layout_height="@dimen/wechat_image_bubble_size"
        android:adjustViewBounds="true"
        android:contentDescription="@string/message_image_preview"
        android:scaleType="centerCrop"
        app:app_round_borderRadius="@dimen/dp_12"
        app:app_round_borderRadius_type="1"
        tools:src="@color/black" />


</FrameLayout>
