<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorF7F8FA"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_12">

    <com.cboda.baselibrary.widge.VpGradeView
        android:id="@+id/squareDetailCommentAvatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/squareDetailCommentName"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_8"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/black"
        android:textSize="@dimen/sp_14"
        app:layout_constraintEnd_toStartOf="@id/squareDetailCommentTime"
        app:layout_constraintStart_toEndOf="@id/squareDetailCommentAvatar"
        app:layout_constraintTop_toTopOf="@id/squareDetailCommentAvatar"
        tools:text="阿梅回复堂吉诃德" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/squareDetailCommentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black_45"
        android:textSize="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/squareDetailCommentAvatar"
        tools:text="2小时前" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/squareDetailCommentContent"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_6"
        android:lineSpacingExtra="@dimen/dp_2"
        android:textColor="@color/black"
        android:textSize="@dimen/sp_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/squareDetailCommentAvatar"
        app:layout_constraintTop_toBottomOf="@id/squareDetailCommentName"
        tools:text="在大东山这边还可以用哦" />

    <View
        android:id="@+id/squareDetailCommentDivider"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_12"
        android:background="#14000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/squareDetailCommentContent" />

</androidx.constraintlayout.widget.ConstraintLayout>
