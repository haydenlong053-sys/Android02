<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:shapeCornersRadius="15dp"
        android:layout_marginHorizontal="16dp"
        app:shapeSolidColor="@color/bg_main1"
        >

        <ImageView
            android:id="@+id/ivTouxiang"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="15dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textColor="@color/color_text0"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/rightLayout"
            app:layout_constraintStart_toEndOf="@+id/ivTouxiang"
            app:layout_constraintTop_toTopOf="@+id/ivTouxiang"
            tools:text="亚历克斯福建省大不大方水电费哈吉斯发送" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/rightLayout"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvNotAgree"
                android:layout_width="55dp"
                android:layout_height="28dp"
                android:background="@mipmap/ic_bg_btn1_02"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/jujuele"
                android:textColor="@color/color_text_dialog_left"
                android:textStyle="bold"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@+id/tvAgree"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvContent"
                 />


            <TextView
                android:id="@+id/tvAgree"
                android:layout_width="55dp"
                android:layout_height="28dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:background="@mipmap/ic_bg_btn2_02"
                android:text="@string/jieshoule"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvNotAgree"
                app:layout_constraintTop_toBottomOf="@+id/tvContent"
                 />

            <TextView
                android:id="@+id/yitianjia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yitianjia"
                android:textColor="#A96EDE"
                android:textSize="14sp"
                />
        </androidx.appcompat.widget.LinearLayoutCompat>


        <TextView
            android:id="@+id/tvnicheng"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:textColor="#8B9DB4"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/ivTouxiang"
            app:layout_constraintTop_toBottomOf="@+id/tvname"
            tools:text="昵称：i后来1111111111111111111111111111111" />
    </com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />
</LinearLayout>