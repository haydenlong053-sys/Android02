<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:background="@color/black_85">


        <com.hjq.shape.layout.ShapeConstraintLayout
            android:id="@+id/refRelativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            app:shape_radius="@dimen/dp_12"
            app:shape_solidColor="#FFF4F5F7"
            app:shape_strokeColor="@color/white"
            app:shape_strokeWidth="@dimen/dp_1"
            tools:visibility="visible">

            <com.hjq.shape.view.ShapeView
                android:id="@+id/yyView1"
                android:layout_width="@dimen/dp_6"
                android:layout_height="@dimen/dp_35"
                android:layout_marginStart="-4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shape_angle="90"
                app:shape_endColor="#FF4444F0"
                app:shape_radius="@dimen/dp_3"
                app:shape_startColor="#FF5686F3" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:paddingVertical="@dimen/dp_12"
                app:layout_constraintEnd_toStartOf="@id/clearRefImageButton"
                app:layout_constraintStart_toEndOf="@id/yyView1"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/refEditText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#CC000000"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="你们在聊什么啊，怎么不喊我呢你们在聊什么啊，不喊我呢你们在聊什么啊" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/refNameTextBefore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/message_quote"
                    android:textColor="#72000000"
                    android:textSize="10sp"
                    app:layout_constraintStart_toStartOf="@id/refEditText"
                    app:layout_constraintTop_toBottomOf="@id/refEditText"
                    tools:ignore="SmallSp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/refNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_6"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#A5000000"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/refNameTextBefore"
                    app:layout_constraintBaseline_toBaselineOf="@id/refNameTextBefore"
                    tools:ignore="SmallSp"
                    tools:text="JOY Follow" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/clearRefImageButton"
                android:layout_width="@dimen/dp_27"
                android:layout_height="@dimen/dp_27"
                android:layout_marginEnd="@dimen/dp_3"
                android:padding="@dimen/dp_9"
                android:scaleType="centerCrop"
                android:src="@mipmap/icon_ai_close"
                android:tint="#FF313133"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </com.hjq.shape.layout.ShapeConstraintLayout>

        <com.hjq.shape.layout.ShapeLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:shape_radius="@dimen/dp_30"
            app:shape_solidColor="@color/color_bg_input">

            <LinearLayout
                android:id="@+id/inputContainerLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dp_10"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/extImageView"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="5dp"
                    android:contentDescription="@string/panel_more"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_msg_broad_add" />

                <ImageView
                    android:id="@+id/mIvVoiceCancel"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="5dp"
                    android:contentDescription="@string/voice_cancel"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_msg_voice_broad_cancel"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">


                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <EditText
                                    android:id="@+id/editText"
                                    style="@style/WeChatEditText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:background="@drawable/shape_session_text_broad_input2"
                                    android:gravity="center_vertical"
                                    android:hint="@string/msg_input"
                                    android:inputType="textMultiLine"
                                    android:maxLines="5"
                                    android:minHeight="42dp"
                                    android:paddingVertical="@dimen/dp_6"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="40dp"
                                    android:textColor="@color/color_text0"
                                    android:textColorHint="@color/black35"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:id="@+id/emotionImageView"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_gravity="bottom|end"
                                    android:layout_margin="5dp"
                                    android:contentDescription="@string/panel_emotion"
                                    android:scaleType="centerInside"
                                    android:src="@mipmap/ic_msg_broad_emo" />
                            </FrameLayout>
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/audioButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/shape_session_msg_voice_broad_bg"
                        android:visibility="gone"
                        tools:visibility="gone">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/mViewAnimateVoice"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:lottie_autoPlay="false"
                            app:lottie_fileName="voice_data.json"
                            app:lottie_loop="true" />
                    </FrameLayout>
                </FrameLayout>

                <ImageView
                    android:id="@+id/audioImageView"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="bottom"
                    android:layout_margin="5dp"
                    android:contentDescription="@string/panel_more_voice"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_msg_broad_voice" />

                <ImageView
                    android:id="@+id/mIvVoiceSend"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="bottom"
                    android:layout_margin="5dp"
                    android:contentDescription="@string/send"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_msg_voice_broad_send"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <Button
                    android:id="@+id/sendButton"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="50dp"
                    android:layout_height="35dp"
                    android:layout_gravity="bottom"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="2.5dp"
                    android:background="@drawable/shape_session_btn_broad_send"
                    android:gravity="center"
                    android:text="@string/send"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/disableInputTipView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dp_10"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="5dp"
                    android:contentDescription="@null"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_chat_mute_icon1" />

                <com.hjq.shape.layout.ShapeFrameLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_40"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    app:shape_radius="@dimen/dp_12"
                    app:shape_solidColor="#E4E5E7">

                    <com.hjq.shape.view.ShapeTextView
                        android:id="@+id/disableInputTipTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:drawableStart="@mipmap/ic_chat_mute_icon2"
                        android:drawablePadding="@dimen/dp_4"
                        android:singleLine="true"
                        android:text="@string/group_all_muted_hint"
                        android:textColor="@color/black_45"
                        android:textSize="14sp" />
                </com.hjq.shape.layout.ShapeFrameLayout>

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="bottom"
                    android:layout_margin="5dp"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_chat_mute_icon3" />

            </LinearLayout>
        </com.hjq.shape.layout.ShapeLinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_16" />
    </LinearLayout>
</merge>
