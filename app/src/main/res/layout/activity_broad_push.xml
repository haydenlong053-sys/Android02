<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    tools:context=".lj.PushBroadActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@drawable/bg_broad_main"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:id="@+id/viHead"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:id="@+id/tvFinish"
                android:text="@string/取消"
                android:textSize="15sp"
                android:textColor="@color/color_text0"
                android:gravity="center"
                android:layout_marginLeft="31dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <TextView
                android:id="@+id/tvPush"
                android:text="@string/发表"
                android:gravity="center"
                android:layout_marginRight="21dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingHorizontal="18dp"
                android:layout_gravity="right|center_vertical"
                android:background="@drawable/bg_broad_fabiao"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
        <EditText
            android:id="@+id/etContent"
            android:background="@null"
            android:gravity="top"
            android:paddingHorizontal="20dp"
            android:paddingVertical="25dp"
            android:layout_marginHorizontal="12dp"
            android:hint="@string/这一刻的想法"
            android:textColor="#999999"
            android:textColorHint="#999999"
            android:textSize="15sp"
            android:minHeight="88dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ryImage"
            android:layout_marginHorizontal="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:id="@+id/llSite"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="18dp"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <ImageView
                android:src="@mipmap/ic_circle_broad_site"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="@string/所在位置"
                android:textSize="14sp"
                android:textColor="#999999"
                android:layout_marginLeft="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvSite"
                android:textSize="14sp"
                android:layout_marginLeft="15dp"
                android:textColor="#999999"
                android:layout_width="0dp"
                android:layout_weight="10"
                android:gravity="right"
                android:layout_height="wrap_content"/>
            <ImageView
                android:layout_marginLeft="8dp"
                android:src="@mipmap/ic_next_broad_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>


    </LinearLayout>

</FrameLayout>