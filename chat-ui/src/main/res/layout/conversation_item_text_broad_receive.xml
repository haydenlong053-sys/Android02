<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/contentTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:autoLink="web"
        android:background="@drawable/bg_bubble_broad_receive"
        android:gravity="left|center_vertical"
        android:linksClickable="true"
        android:maxWidth="240dp"
        android:minHeight="40dp"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:text="text message content"
        android:textColorLink="@color/color_text0"
        android:textColor="@color/color_text0"
        android:textSize="16sp" />
    <TextView
        android:id="@+id/fContentTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left|center_vertical"
        android:layout_marginTop="1dp"
        android:layout_marginRight="24px"
        android:background="@drawable/shape_message_ref_broad_bg"
        android:maxWidth="250dp"
        android:maxLines="2"
        android:paddingLeft="5dp"
        android:paddingTop="2dp"
        android:paddingRight="5dp"
        android:paddingBottom="2dp"
        android:text="refff"
        android:visibility="visible" />
    <TextView
        android:id="@+id/refTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left|center_vertical"
        android:layout_marginLeft="16px"
        android:layout_marginTop="1dp"
        android:background="@drawable/shape_message_ref_broad_bg"
        android:maxWidth="250dp"
        android:maxLines="2"
        android:paddingLeft="5dp"
        android:paddingTop="2dp"
        android:paddingRight="5dp"
        android:paddingBottom="2dp"
        android:visibility="gone" />
</LinearLayout>
