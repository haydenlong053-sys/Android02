<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout
        android:id="@+id/rootView"
        android:layout_width="318dp"
        android:layout_height="205dp"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"
        app:shapeCornersRadius="15dp"
        app:shapeSolidColor="#ffffff">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@mipmap/ic_confim_top_broad_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="温馨提示"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@+id/tvAgree"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle">
            <TextView
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center"
                android:id="@+id/tvContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:text="本平台只允许年满18周岁的成年人使用，请确认你是否已成年"
                android:lineSpacingExtra="5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </androidx.core.widget.NestedScrollView>
        <com.cboda.baselibrary.shapeview.shape.ShapeTextBroadView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tvAgree"
            android:layout_width="160dp"
            android:layout_height="45dp"
            android:layout_marginBottom="25dp"
            android:text="确定"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:shapeCornersRadius="22.5dp"
            app:shapeSolidColor="#5456f6"/>
    </com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout>
</LinearLayout>
