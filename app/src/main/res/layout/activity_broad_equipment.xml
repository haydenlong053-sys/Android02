<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:src="@mipmap/ic_bg_top_broad_login" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:id="@+id/viHead"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivScan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:padding="17dp"
                    android:src="@mipmap/ic_scan_broad_login" />

                <TextView
                    android:id="@+id/tvLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="23dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="right|center_vertical"
                    android:layout_marginRight="17dp"
                    android:drawableLeft="@mipmap/ic_change_broad_yy"
                    android:drawableRight="@mipmap/ic_down_broad_white"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="中文"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </RelativeLayout>

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="30dp"
                android:src="@mipmap/ic_logo_broad_login" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:text="@string/app_name"
                android:textColor="@color/color_text0"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:paddingLeft="35dp">

                <RelativeLayout
                    android:id="@+id/rlUser"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginRight="50dp">

                    <ImageView
                        android:id="@+id/imUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:src="@mipmap/ic_login_bt_broad_bg"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:text="@string/用户名登录"
                        android:textColor="@color/color_text0"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:src="@mipmap/ic_login_bt_broad_bg"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:text="@string/助记词登录"
                        android:textColor="@color/color_text0"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/llUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="34dp"
                        android:layout_marginTop="30dp"
                        android:drawableLeft="@mipmap/ic_login_broad_user"
                        android:drawablePadding="12dp"
                        android:text="@string/用户名"
                        android:textColor="@color/color_text0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="33dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rect_broad_login"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etPhone"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/transparent"
                            android:hint="@string/请输入用户名"
                            android:importantForAutofill="no"
                            android:paddingHorizontal="22dp"
                            android:textColor="@color/color_text_content"
                            android:textColorHint="@color/color_text_content_hint"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="34dp"
                        android:layout_marginTop="22dp"
                        android:drawableLeft="@mipmap/ic_login_broad_password"
                        android:drawablePadding="12dp"
                        android:text="@string/密码"
                        android:textColor="@color/color_text0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="33dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rect_broad_login"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etNewPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/transparent"
                            android:hint="@string/请输入密码"
                            android:inputType="textPassword"
                            android:paddingHorizontal="22dp"
                            android:textColor="@color/color_text_content"
                            android:textColorHint="@color/color_text_content_hint"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <CheckBox
                            android:id="@+id/cb_check_pass"
                            style="@style/checkbox_password_style"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:gravity="center"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="34dp"
                        android:layout_marginTop="12dp"
                        android:drawableLeft="@mipmap/ic_login_broad_yzm"
                        android:drawablePadding="12dp"
                        android:text="@string/验证码"
                        android:textColor="@color/color_text0"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="33dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rect_broad_login"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/etYzm"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/请输入验证码"
                            android:inputType="textPassword"
                            android:paddingHorizontal="22dp"
                            android:textColor="@color/color_text_content"
                            android:textColorHint="@color/color_text_content_hint"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvGetCode"
                            android:layout_width="104dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/获取设备验证码"
                            android:textColor="@color/color_main1"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvYjdl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="34dp"
                    android:background="@drawable/bg_broad_zjclg"
                    android:gravity="center"
                    android:paddingVertical="40dp"
                    android:text="96位助记词一键登录"
                    android:textColor="@color/color_text_zjc"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>


            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="20dp"
                android:background="@mipmap/ic_bg_btn2_broad_01"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/登录"
                android:textColor="#ffffffff"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvZhuce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="10dp"
                android:background="@mipmap/ic_bg_btn1_broad_01"
                android:gravity="center"
                android:text="@string/立即注册"
                android:textColor="@color/color_text1"
                android:textSize="18sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbAgree"
                    style="@style/CustomCheckboxTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:text="@string/我已阅读并同意"
                    android:textColor="@color/color_text_content_hint"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvXy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/用户协议"
                    android:textColor="@color/color_text0"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/和"
                    android:textColor="@color/color_text_content_hint"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvYs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/隐私协议"
                    android:textColor="@color/color_text0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvThrid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/第三方信息共享清单"
                    android:textColor="@color/color_text0"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="30dp"
                android:text="wujie 开启崭新的世界"
                android:textColor="@color/color_text0"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>