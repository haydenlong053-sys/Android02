<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:background="@color/bg_main"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".lj.PushInfoBroadActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/rlIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="50dp">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/riIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_head_defaut"
                app:riv_oval="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_yinying"
                android:gravity="center">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_login_xiangji" />
            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                android:src="@mipmap/ic_add_head" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/shezhinichengb"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:drawableRight="@mipmap/ic_edit_name"
            android:drawablePadding="5dp"
            android:gravity="center_vertical"
            android:paddingVertical="10dp"
            android:text=""
            android:textColor="@color/color_text0"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/tvIdno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="ID："
            android:textColor="@color/color_text0"
            android:textSize="15sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/llSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:background="@drawable/bg_rect_input"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="30dp">



            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/ivQrcode"
                android:layout_width="140dp"
                android:layout_height="140dp"
                app:riv_corner_radius="10dp"
                android:scaleType="fitXY"
                />

        </LinearLayout>

        <TextView
            android:id="@+id/tvRegInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rect_input"
            android:layout_marginHorizontal="20dp"
            android:padding="20dp"
            android:text=""
            android:textColor="@color/color_text0"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_rect_input">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textSize="14sp"
                    android:textColor="@color/color_text0"
                    android:text="@string/用户名"/>

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="right"
                    android:padding="12dp"
                    android:hint="@string/请输入"
                    android:background="@null"
                    android:textSize="14sp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/line"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textSize="14sp"
                    android:textColor="@color/color_text0"
                    android:text="@string/密码"/>

                <EditText
                    android:id="@+id/etPsw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="right"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:hint="@string/请输入"
                    android:background="@null"
                    android:textSize="14sp"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:background="@mipmap/ic_bg_btn1_01"
            android:gravity="center"
            android:text="@string/点击保存二维码"
            android:textColor="@color/color_text0"
            android:textSize="16sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="40dp"
            android:background="@mipmap/ic_bg_btn2_01"
            android:gravity="center"
            android:text="@string/登录"
            android:textColor="#ffffffff"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>


</ScrollView>