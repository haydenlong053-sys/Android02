<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/row_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/dp_2">

        <com.cboda.baselibrary.widge.VpGradeView
            android:id="@+id/avatar_left"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_54"
            android:layout_marginTop="@dimen/dp_5"
            android:visibility="gone"
            app:user_img_width="@dimen/dp_42"
            app:user_vip_width="@dimen/dp_20"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/message_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/name_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginBottom="@dimen/dp_5"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLength="20"
                    android:maxWidth="150dp"
                    android:singleLine="true"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="张三" />

                <com.hjq.shape.view.ShapeTextView
                    android:id="@+id/join_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:textSize="10sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toEndOf="@id/tv_nickname"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shape_radius="4dp"
                    app:shape_solidColor="#1E3B47DD"
                    app:shape_solidSelectedColor="#1ED5271E"
                    app:shape_textColor="#3B47DD"
                    app:shape_textSelectedColor="#D5271E"
                    tools:ignore="SmallSp"
                    tools:text="12-30入群"
                    tools:visibility="visible" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/bubble_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/error_linear_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/dp_10"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <include layout="@layout/include_broad_error" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/dp_5"
                    android:layout_marginTop="@dimen/dp_15"
                    android:layout_marginBottom="@dimen/dp_5"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/single_receipt_image_view"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:layout_gravity="bottom"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:scaleType="center"
                    android:src="@mipmap/rec_broad_ei_pt"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <FrameLayout
                    android:id="@+id/group_receipt_frame_layout"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="bottom"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ProgressBar
                        android:id="@+id/delivery_progress_bar"
                        style="?android:progressBarStyleHorizontal"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:progressDrawable="@drawable/message_receipt_broad_progressbar"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/read_progress_bar"
                        style="?android:progressBarStyleHorizontal"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:progressDrawable="@drawable/message_receipt_broad_progressbar"
                        android:visibility="visible" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/fl_message_content_host"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:background="@drawable/bg_bubble_received"
                    tools:layout_height="100dp"
                    tools:layout_width="176dp" />
            </LinearLayout>
        </LinearLayout>

        <com.cboda.baselibrary.widge.VpGradeView
            android:id="@+id/avatar_right"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_54"
            android:layout_marginTop="@dimen/dp_5"
            android:visibility="gone"
            app:user_img_width="@dimen/dp_42"
            app:user_vip_width="@dimen/dp_20"
            tools:visibility="visible" />

        <CheckBox
            android:id="@+id/checkbox"
            style="@style/CustomCheckboxThemeLB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/dp_5"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_5"
            android:clickable="false"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/time_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingBottom="5dp"
        android:textColor="@color/gray11"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="下午 5:00"
        tools:visibility="visible" />
</LinearLayout>
