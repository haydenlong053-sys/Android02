<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_text_main"
        android:gravity="center_vertical"
        android:id="@+id/categoryTextView"
        android:paddingLeft="@dimen/item_margin_left_and_right"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="群主"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/contactLinearLayout"
        android:background="@drawable/selector_common_broad_item"
        android:paddingLeft="@dimen/item_margin_left_and_right"
        android:paddingTop="@dimen/item_margin_top_and_bottom"
        android:paddingRight="@dimen/item_margin_left_and_right"
        android:paddingBottom="@dimen/item_margin_top_and_bottom"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <CheckBox
            android:id="@+id/checkbox"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            style="@style/CustomCheckboxTheme"/>
        <com.cboda.baselibrary.view.AppRoundBroadImage
            android:id="@+id/portraitImageView"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <TextView
                android:textSize="17sp"
                android:textColor="@color/black"
                android:id="@+id/nameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black_65"
                android:id="@+id/descTextView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/dividerLine"
        android:visibility="visible"
        android:layout_marginLeft="72dp"
        style="@style/Line"/>
</LinearLayout>
