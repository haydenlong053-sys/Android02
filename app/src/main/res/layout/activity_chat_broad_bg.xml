<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="10dp"
    android:orientation="vertical"
    android:background="@color/bg_main_space"
    >
    <LinearLayout
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_rect_broad_main"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/llHf"
            android:paddingHorizontal="27dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:text="@string/恢复背景"
                android:textSize="15sp"
                android:textColor="@color/color_text0"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <ImageView
                android:src="@mipmap/ic_broad_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <View
            android:layout_marginHorizontal="27dp"
            style="@style/Line2"
            android:layout_width="match_parent"
            />
        <LinearLayout
            android:id="@+id/llXiangce"
            android:paddingHorizontal="27dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:text="@string/从相册中选择"
                android:textSize="15sp"
                android:textColor="@color/color_text0"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <ImageView
                android:src="@mipmap/ic_broad_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <View
            android:layout_marginHorizontal="27dp"
            style="@style/Line2"
            android:layout_width="match_parent"
            />
        <LinearLayout
            android:id="@+id/llPai"
            android:paddingHorizontal="27dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:text="@string/拍一张"
                android:textSize="15sp"
                android:textColor="@color/color_text0"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <ImageView
                android:src="@mipmap/ic_broad_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>


    </LinearLayout>
</LinearLayout>