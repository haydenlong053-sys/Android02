<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_marginTop="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/imIcon"
        android:layout_marginLeft="15dp"
        android:src="@mipmap/ic_bill_hongbao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:layout_marginRight="15dp"
        android:orientation="vertical"
        android:layout_marginLeft="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvTitle"
                android:text="红包退还红包退还"
                android:textSize="16sp"
                android:textColor="@color/color_text0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/tvPrice"
                android:text="+￥10.00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_text0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/tvTime"
                android:text="2024/01/01 12:00:11"
                android:layout_weight="1"
                android:textSize="12sp"
                android:maxLines="1"
                android:textColor="@color/color_text_content_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>
            <TextView
                android:maxLines="1"
                android:id="@+id/tvTuihuan"
                android:text="发给Anny的红包超时未领取退还"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#F0444C"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <View
            android:layout_marginTop="5dp"
            android:background="#11F0EFEF"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
    </LinearLayout>
</LinearLayout>