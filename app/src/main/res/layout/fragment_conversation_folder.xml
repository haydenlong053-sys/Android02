<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_msg_page_bg"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_folder_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/wechat_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="会话分组 (4)" />

        <TextView
            android:id="@+id/tv_folder_manage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:drawableStart="@mipmap/ic_h_icon_half"
            android:text="@string/conv_folder_manage"
            android:textColor="@color/color_brand_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        >

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_folders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- 与对话 Tab 空列表样式一致 -->
        <LinearLayout
            android:id="@+id/tv_folder_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:contentDescription="@string/conversation_list_empty"
                android:scaleType="fitCenter"
                android:src="@mipmap/no_data_msg2" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/conversation_list_empty_title"
                android:textColor="#2b2b4a"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/conversation_list_empty_hint"
                android:textColor="#9a9ab0"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
