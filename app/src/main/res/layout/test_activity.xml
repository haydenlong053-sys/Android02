<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.cboda.baselibrary.widge.CountPillView
        android:id="@+id/verticalDanmakuView"
        android:layout_width="@dimen/dp_42"
        android:layout_height="@dimen/dp_18"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/dp_100"
        app:cornerRadius="@dimen/dp_9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:pillBgColor="#99212234"
        app:rollLineGapExtra="@dimen/dp_5"
        app:suffixText="@string/msg_flower"
        app:suffixTextColor="#ffd957"
        app:suffixTextSize="10sp" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/addData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_120"
        android:text="添加数据"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>