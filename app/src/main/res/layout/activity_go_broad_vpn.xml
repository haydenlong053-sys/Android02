<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F6"
    >
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/选择连接节点"
            android:textSize="15sp"
            android:layout_marginLeft="29dp"
            android:layout_marginTop="26dp"
            android:textColor="#8B9DB4"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ryVpn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="25dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvCancel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="47dp"
                android:gravity="center"
                android:layout_marginRight="10dp"
                android:textColor="#5456F6"
                android:textSize="14sp"
                android:text="@string/取消"
                android:background="@drawable/bg_rect_broad_vpn" />
            <TextView
                android:id="@+id/tvConfirm"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="47dp"
                android:gravity="center"
                android:layout_marginRight="10dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:text="@string/连接"
                android:background="@drawable/bg_broad_queding" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>