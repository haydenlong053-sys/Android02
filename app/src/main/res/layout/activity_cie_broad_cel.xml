<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/smart"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.cboda.intelligent.widge.MyScrollBroadView
            android:id="@+id/ns"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imBg"
                    android:layout_width="match_parent"
                    android:layout_height="310dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_logo"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="67dp"
                        android:layout_marginTop="267dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="22dp"
                            android:layout_alignParentBottom="true"
                             />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="right"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="17dp"
                                android:layout_marginRight="10dp"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="亚历克斯" />

                            <com.makeramen.roundedimageview.RoundedImageView
                                android:id="@+id/riIcon"
                                android:layout_width="67dp"
                                android:layout_height="67dp"
                                android:layout_marginRight="15dp"
                                android:scaleType="centerCrop"
                                android:src="@mipmap/ic_head"
                                app:riv_corner_radius="10dp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/llMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="11dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:visibility="gone">

                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/riIcon1"
                            android:layout_width="33dp"
                            android:layout_height="33dp"
                            android:scaleType="centerCrop"
                            android:src="@mipmap/ic_head"
                            app:riv_corner_radius="5dp" />

                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/riIcon2"
                            android:layout_width="33dp"
                            android:layout_height="33dp"
                            android:layout_marginLeft="5dp"
                            android:scaleType="centerCrop"
                            android:src="@mipmap/ic_logo"
                            android:visibility="gone"
                            app:riv_corner_radius="5dp" />

                        <TextView
                            android:id="@+id/tvHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:layout_marginRight="12dp"
                            android:textColor="@color/color_text0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="@string/等人点赞了你" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:id="@+id/llNoData"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="140dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/ivNoData"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@mipmap/ic_empty_bg" />

                            <TextView
                                android:id="@+id/tvNoData"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="10dp"
                                android:gravity="center"
                                android:text="暂时没有数据"
                                android:textColor="#ff989898"
                                android:textSize="13sp"
                                android:visibility="visible" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/ryCircle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>
                </LinearLayout>

            </RelativeLayout>
        </com.cboda.intelligent.widge.MyScrollBroadView>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    <LinearLayout
        android:id="@+id/llTool"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/viHead"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <ImageView
                android:id="@+id/imFinish"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:padding="18dp"
                android:src="@mipmap/ic_back" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#333333"
                android:textSize="17sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/llAdd"
                android:gravity="center"
                android:layout_marginRight="20dp"
                android:layout_gravity="right|center_vertical"
                android:background="@drawable/bg_circle_broad_add"
                android:orientation="horizontal"
                android:layout_width="35dp"
                android:layout_height="35dp">
                <ImageView
                    android:id="@+id/imAdd"
                    android:src="@mipmap/ic_circle_add"
                    android:layout_width="17dp"
                    android:layout_height="17dp"/>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>
</RelativeLayout>