<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_broad_sex"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="15dp">

        <TextView
            android:id="@+id/tvDeleteForAll"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="36dp"
            android:gravity="center"
            android:text="@string/message_delete_for_all"
            android:textColor="#A96EDE"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            style="@style/Line2"
            android:layout_width="match_parent" />

        <TextView
            android:id="@+id/tvDeleteForMe"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="36dp"
            android:gravity="center"
            android:text="@string/message_delete_for_me"
            android:textColor="#333333"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="20dp"
        android:background="@mipmap/ic_bg_btn2_broad_01"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="@string/cancel"
        android:textColor="#ffffffff"
        android:textSize="16sp" />
</LinearLayout>
