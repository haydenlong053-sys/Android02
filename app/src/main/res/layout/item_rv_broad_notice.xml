<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="101dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <View
        android:id="@+id/mViewReadBlue"
        android:layout_width="8dp"
        android:layout_height="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_circle_3b37dd"
        />
    <TextView
        android:id="@+id/mTvDes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/mViewReadBlue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/mIvPic"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="8dp"
        android:lines="2"
        android:ellipsize="end"
        android:textColor="@color/black"
        android:textSize="16sp"
        tools:text="IM功能强势上线！关于Web4X新增交易机器的公告IM功能强势上线！关于Web4X新增交易机器的公告IM功能强势上线！关于Web4X新增交易机器的公告"
        />
    <ImageView
        android:id="@+id/mIvPic"
        android:layout_width="100dp"
        android:layout_height="69dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:scaleType="centerCrop"

        />
    <TextView
        android:id="@+id/mTvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/black_or_white_45"
        tools:text="2025-05-27 15:00"
        app:layout_constraintStart_toStartOf="@id/mTvDes"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="16dp"
        />

    <View
        android:id="@+id/mViewLine"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="16dp"
        android:background="@color/black_8"
        />
</androidx.constraintlayout.widget.ConstraintLayout>