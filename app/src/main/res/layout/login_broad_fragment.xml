<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/black">

    <com.hjq.shape.view.ShapeView
        android:id="@+id/backView"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_148"
        android:layout_marginBottom="-34dp"
        app:layout_constraintBottom_toBottomOf="@id/loginBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="#FF0F1B3A"
        app:shape_strokeColor="#FF3E5387"
        app:shape_strokeWidth="@dimen/dp_1"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/loginTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/account_login"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@id/backView"
        app:layout_constraintStart_toStartOf="@id/backView"
        app:layout_constraintTop_toTopOf="@id/backView" />

    <com.hjq.shape.view.ShapeEditText
        android:id="@+id/loginAccount"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_50"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_24"
        android:drawableStart="@mipmap/icon_login_account"
        android:drawablePadding="@dimen/dp_12"
        android:hint="@string/please_enter_account"
        android:paddingHorizontal="@dimen/dp_16"
        android:textColor="@color/white"
        android:textColorHint="#7366A0F7"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/backView"
        app:layout_constraintStart_toStartOf="@id/backView"
        app:layout_constraintTop_toBottomOf="@id/loginTv"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="@color/color_080E1E"
        app:shape_strokeColor="@color/color_080E1E"
        app:shape_strokeWidth="@dimen/dp_1" />


    <com.hjq.shape.view.ShapeEditText
        android:id="@+id/loginPwd"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_20"
        android:drawableStart="@mipmap/icon_login_pwd"
        android:drawablePadding="@dimen/dp_12"
        android:hint="@string/please_enter_password"
        android:inputType="textPassword"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_48"
        android:textColor="@color/white"
        android:textColorHint="#7366A0F7"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/loginAccount"
        app:layout_constraintStart_toStartOf="@id/loginAccount"
        app:layout_constraintTop_toBottomOf="@id/loginAccount"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="@color/color_080E1E"
        app:shape_strokeColor="@color/color_080E1E"
        app:shape_strokeWidth="@dimen/dp_1" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/loginLookPwd"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:background="@color/transparent"
        android:padding="@dimen/dp_16"
        android:scaleType="centerCrop"
        android:src="@mipmap/icon_pwd_close"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/loginPwd"
        app:layout_constraintEnd_toEndOf="@id/loginPwd"
        app:layout_constraintTop_toTopOf="@id/loginPwd"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/loginForgetPwd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_4"
        android:padding="@dimen/dp_20"
        android:text="@string/forget_password"
        android:textColor="#F19A38"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/backView"
        app:layout_constraintTop_toBottomOf="@id/loginLookPwd" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/loginRegisterAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_4"
        android:padding="@dimen/dp_20"
        android:text="@string/register_account"
        android:textColor="#F19A38"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/backView"
        app:layout_constraintTop_toTopOf="@id/loginForgetPwd" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/loginBtn"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_50"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:gravity="center"
        android:text="@string/login"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/backView"
        app:layout_constraintStart_toStartOf="@id/backView"
        app:layout_constraintTop_toBottomOf="@id/loginRegisterAccount" />


    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/oneLogin"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_46"
        android:layout_marginTop="@dimen/dp_24"
        android:paddingHorizontal="@dimen/dp_25"
        android:paddingVertical="@dimen/dp_12"
        android:text="@string/one_click_login"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backView"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="#1affffff"
        app:shape_strokeColor="#40ffffff"
        app:shape_strokeWidth="@dimen/dp_05" />
</androidx.constraintlayout.widget.ConstraintLayout>