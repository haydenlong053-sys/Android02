<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:id="@+id/chengyuanjinyan"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_text0"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/hengyuanjinyan"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_broad_next"
            android:scaleType="centerInside"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        style="@style/Line2"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:id="@+id/yijinyanmingdan"
        android:layout_width="match_parent"
        android:layout_height="62dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_text0"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/yijinyanmingdan"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_broad_next"
            android:scaleType="centerInside"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        style="@style/Line2"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:id="@+id/minganci"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_text0"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/mingancishezhi"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_broad_next"
            android:scaleType="centerInside"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/minganciDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        style="@style/Line2"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:id="@+id/zidongjinyanRow"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_text0"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/zidongjinyan"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/zidongjinyan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.SwitchCompat
            android:theme="@style/switchStyle"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/zidongjinyan"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/thumb_broad_selector"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:track="@drawable/track_broad_selector"/>
        <View
            android:id="@+id/zidongjinyanView"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/zidongjinyanDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        style="@style/Line2"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="62dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_text0"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/quanyuanjinyanle"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.SwitchCompat
            android:theme="@style/switchStyle"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/quanyuanjinyan"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/thumb_broad_selector"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:track="@drawable/track_broad_selector"/>
        <View
            android:id="@+id/quanyuanjinyanView"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
