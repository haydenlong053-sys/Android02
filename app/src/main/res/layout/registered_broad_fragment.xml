<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <View
            android:id="@+id/backView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/brandTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auth_brand_name"
            android:textColor="@color/color_3B47DD"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/register"
            android:textColor="@color/black"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/brandTv" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/register_welcome_subtitle"
            android:textColor="#999999"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title" />

        <!-- 助记词：保留业务字段，浅色卡片展示 -->
        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="12dp"
            android:textColor="@color/color_3B47DD"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title2"
            app:shape_radius="12dp"
            app:shape_solidColor="#1A3B47DD"
            app:shape_strokeColor="@color/color_3B47DD"
            app:shape_strokeWidth="1dp"
            tools:text="MNEMONIC WORDS"
            tools:visibility="gone" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/accountLabelTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/user_account"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/content"
            app:layout_goneMarginTop="28dp" />

        <com.hjq.shape.view.ShapeEditText
            android:id="@+id/loginAccount"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@mipmap/icon_login_broad_account"
            android:drawablePadding="12dp"
            android:ellipsize="end"
            android:hint="@string/auth_account_hint"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="48dp"
            android:textColor="@color/black"
            android:textColorHint="#BBBBBB"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/accountLabelTv"
            app:shape_radius="12dp"
            app:shape_solidColor="@color/white"
            app:shape_strokeColor="#E5E5E5"
            app:shape_strokeWidth="1dp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/loginLookPwd"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/transparent"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@mipmap/icon_clear_broad_text"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/loginAccount"
            app:layout_constraintEnd_toEndOf="@id/loginAccount"
            app:layout_constraintTop_toTopOf="@id/loginAccount"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/pwdLabelTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/密码"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loginAccount" />

        <com.hjq.shape.view.ShapeEditText
            android:id="@+id/loginPwd"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@mipmap/icon_login_broad_pwd"
            android:drawablePadding="12dp"
            android:hint="@string/请输入密码"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="48dp"
            android:textColor="@color/black"
            android:textColorHint="#BBBBBB"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pwdLabelTv"
            app:shape_radius="12dp"
            app:shape_solidColor="@color/white"
            app:shape_strokeColor="#E5E5E5"
            app:shape_strokeWidth="1dp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/loginPwdLook"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/transparent"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@mipmap/icon_pwd_broad_close"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@id/loginPwd"
            app:layout_constraintEnd_toEndOf="@id/loginPwd"
            app:layout_constraintTop_toTopOf="@id/loginPwd" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/confirmPwdLabelTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/confirm_password"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loginPwd" />

        <com.hjq.shape.view.ShapeEditText
            android:id="@+id/updatePwd"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@mipmap/icon_login_broad_pwd"
            android:drawablePadding="12dp"
            android:hint="@string/请再次输入密码"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="48dp"
            android:textColor="@color/black"
            android:textColorHint="#BBBBBB"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/confirmPwdLabelTv"
            app:shape_radius="12dp"
            app:shape_solidColor="@color/white"
            app:shape_strokeColor="#E5E5E5"
            app:shape_strokeWidth="1dp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/updatePwdLook"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/transparent"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@mipmap/icon_pwd_broad_close"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@id/updatePwd"
            app:layout_constraintEnd_toEndOf="@id/updatePwd"
            app:layout_constraintTop_toTopOf="@id/updatePwd" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/loginBtn"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_auth_btn_disabled"
            android:gravity="center"
            android:text="@string/register"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/updatePwd" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
