            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/aiUploadTitle3"
            app:shape_radius="@dimen/dp_18"
            app:shape_shadowColor="#999e9e9e"
            app:shape_shadowSize="@dimen/dp_6"
            app:shape_solidColor="@color/white"
            app:shape_strokeColor="@color/color_2563EB"
