<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F3F5">

    <com.hjq.shape.view.ShapeView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_480"
        app:layout_constraintTop_toTopOf="parent"
        app:shape_angle="90"
        app:shape_endColor="#9EB4F5"
        app:shape_startColor="@color/color_F2F3F5" />

    <com.hjq.shape.view.ShapeView
        android:id="@+id/returnView"
        android:layout_width="@dimen/dp_50"
        android:layout_height="@dimen/dp_50"
        android:layout_marginStart="@dimen/dp_5"
        android:layout_marginTop="@dimen/dp_5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shape_radius="@dimen/dp_30"
        app:shape_shadowColor="#A69e9e9e"
        app:shape_shadowSize="@dimen/dp_5"
        app:shape_solidColor="@color/white" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/mIvBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/ic_broad_back2"
        app:layout_constraintBottom_toBottomOf="@id/returnView"
        app:layout_constraintEnd_toEndOf="@id/returnView"
        app:layout_constraintStart_toStartOf="@id/returnView"
        app:layout_constraintTop_toTopOf="@id/returnView" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/backBtn"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:alpha="0"
        android:background="@color/transparent"
        app:layout_constraintBottom_toBottomOf="@id/returnView"
        app:layout_constraintEnd_toEndOf="@id/returnView"
        app:layout_constraintStart_toStartOf="@id/returnView"
        app:layout_constraintTop_toTopOf="@id/returnView" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/heroIv"
                android:layout_width="@dimen/dp_279"
                android:layout_height="@dimen/dp_120"
                android:layout_marginTop="24dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_group_join_pay_hero"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/titleTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/group_join_pay_page_title"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/heroIv" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/subtitleTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/group_join_pay_page_subtitle"
                android:textColor="@color/black_65"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleTv" />

            <!-- 群信息卡 -->
            <com.hjq.shape.layout.ShapeConstraintLayout
                android:id="@+id/groupInfoCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subtitleTv"
                app:shape_radius="16dp"
                app:shape_solidColor="@color/white">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/groupAvatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:riv_oval="true"
                    tools:src="@color/color_5F19E2_12" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/groupNameRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/groupAvatar"
                    app:layout_constraintTop_toTopOf="@id/groupAvatar">


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/groupNameTv"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_max="@dimen/dp_180"
                        tools:text="交流1群交流1群交流1群交流1群交流1群交流1群交流1群" />

                    <com.hjq.shape.view.ShapeTextView
                        android:id="@+id/paidTagTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="@string/group_join_pay_paid_tag"
                        android:textColor="@color/color_3B47DD"
                        android:textSize="11sp"
                        app:layout_constraintBottom_toBottomOf="@id/groupNameTv"
                        app:layout_constraintStart_toEndOf="@id/groupNameTv"
                        app:layout_constraintTop_toTopOf="@id/groupNameTv"
                        app:shape_radius="4dp"
                        app:shape_solidColor="@color/color_3B47DD_12" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/groupIdTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/black_35"
                    android:textSize="12sp"
                    app:layout_constraintStart_toEndOf="@id/groupAvatar"
                    app:layout_constraintTop_toBottomOf="@id/groupNameRow"
                    tools:text="群ID: 374545" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/groupMemberTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:textColor="@color/black_35"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/groupIdTv"
                    app:layout_constraintStart_toEndOf="@id/groupIdTv"
                    app:layout_constraintTop_toTopOf="@id/groupIdTv"
                    tools:text="群成员: 238" />
            </com.hjq.shape.layout.ShapeConstraintLayout>

            <!-- 进群费用卡 -->
            <com.hjq.shape.layout.ShapeConstraintLayout
                android:id="@+id/feeCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/groupInfoCard"
                app:shape_radius="16dp"
                app:shape_solidColor="@color/white">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/feeLabelTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/group_join_pay_fee_card_title"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/feeAmountTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="@color/color_3B47DD"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/feeAmountAfterTv"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/feeLabelTv"
                    tools:text="100" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/feeAmountAfterTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:gravity="center"
                    android:text="@string/人民币"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@id/feeAmountTv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/feeAmountTv" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/feeUsdTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/black_35"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/feeAmountTv"
                    tools:text="≈$12.35 USD" />
            </com.hjq.shape.layout.ShapeConstraintLayout>

            <!-- 支付说明卡 -->
            <com.hjq.shape.layout.ShapeLinearLayout
                android:id="@+id/tipsCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/feeCard"
                app:shape_radius="16dp"
                app:shape_solidColor="@color/white">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/group_join_pay_tips_title"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="12dp"
                        android:layout_marginTop="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_group_join_pay_check"
                        tools:ignore="ContentDescription" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/group_join_pay_tip_1"
                        android:textColor="@color/black_65"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_group_join_pay_check"
                        tools:ignore="ContentDescription" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/group_join_pay_tip_2"
                        android:textColor="@color/black_65"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_group_join_pay_check"
                        tools:ignore="ContentDescription" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/group_join_pay_tip_3"
                        android:textColor="@color/black_65"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.hjq.shape.layout.ShapeLinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/payBtn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:shape_radius="@dimen/dp_16"
            app:shape_solidColor="@color/color_3B47DD"
            tools:text="立即支付 100 DUALX进群" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
