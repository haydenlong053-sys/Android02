            app:layout_constraintEnd_toEndOf="@id/shapeView"
            app:layout_constraintStart_toStartOf="@id/shapeView"
            app:layout_constraintTop_toTopOf="@id/shapeView"
            tools:src="@mipmap/icon_ai_upload_broad_document"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/aiUploadTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#333333"
