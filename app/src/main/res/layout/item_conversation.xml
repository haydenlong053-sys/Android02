<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/wechat_list_item_padding_h"
        android:paddingTop="@dimen/wechat_list_item_padding_v"
        android:paddingEnd="@dimen/wechat_list_item_padding_h"
        android:paddingBottom="@dimen/wechat_list_item_padding_v">

        <!-- 多选勾选框（管理模式下显示） -->
        <ImageView
            android:id="@+id/iv_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_check_cnv_broad_normal"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 头像 + 群天数角标（对齐野火会话列表 VpGradeView） -->
        <com.cboda.baselibrary.widge.VpGradeView
            android:id="@+id/avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:user_img_width="@dimen/wechat_avatar_size"
            app:user_vip_width="25dp"
            app:user_grade_height="14dp"
            app:user_grade_pad="4dp"
            app:user_grade_text_size="8dp"
            app:user_vip_margin_bottom="-10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_name"
                    style="@style/WeChatTextPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="用户537174" />

                <TextView
                    android:id="@+id/tv_register_day"
                    style="@style/WeChatTextSecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="30天"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_preview_type"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    tools:src="@drawable/ic_msg_voice"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    style="@style/WeChatTextSecondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="[语音]" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧：时间在上，未读/免打扰红点在下 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_time"
                style="@style/WeChatTextSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                tools:text="19:18" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="20dp">

                <TextView
                    android:id="@+id/tv_unread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_unread_badge"
                    android:gravity="center"
                    android:minWidth="20dp"
                    android:minHeight="20dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="9"
                    tools:visibility="visible" />

                <!-- 免打扰：有未读时只显示红点（不显示数字） -->
                <View
                    android:id="@+id/v_mute_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_unread_badge"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="76dp"
        android:background="@color/wechat_divider" />
</LinearLayout>
