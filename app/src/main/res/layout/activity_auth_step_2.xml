<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <TextView
        android:id="@+id/mTvDes1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/mine_google_auth_des_6"
        android:textColor="@color/black_or_white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"
        />

    <TextView
        android:id="@+id/mTvDes2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mine_google_auth_des_7"
        android:textColor="@color/black_or_white_65"
        android:textSize="14sp"
        android:layout_marginTop="30dp"
        tools:ignore="MissingConstraints"
        app:layout_constraintStart_toStartOf="@id/mTvDes1"
        app:layout_constraintTop_toBottomOf="@id/mTvDes1"
        />
    <LinearLayout
        android:id="@+id/mLlGoogleAuthCopy"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_rect_mine_10dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@id/mTvDes1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mTvDes2"
        android:layout_marginEnd="16dp"
        >

        <EditText
            android:id="@+id/mEtCopy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:maxLength="6"
            android:gravity="center|start"
            android:hint="@string/mine_google_auth_des_8"
            android:importantForAutofill="no"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textColorHint="@color/black_or_white_45"
            android:textColor="@color/black_or_white"
            android:textSize="16sp"
            tools:ignore="TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/mTvCopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/mine_google_auth_copy"
            android:gravity="center|start"
            android:textColor="@color/color_3B47DDk"
            android:textSize="16sp"
            />
    </LinearLayout>


    <TextView
        android:id="@+id/mTvSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rect_submit_16dp"
        android:padding="12dp"
        android:text="@string/mine_google_auth_submit"
        android:textColor="@color/white_or_black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        />

</androidx.constraintlayout.widget.ConstraintLayout>