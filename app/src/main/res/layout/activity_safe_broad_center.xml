<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_main2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black_or_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="33dp"
        android:text="@string/mine_double_auth"
        android:layout_marginHorizontal="16dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black_or_white_65"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/mine_double_auth_des"
        android:layout_marginHorizontal="16dp"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/mLlGoogleAuth"
        android:background="@drawable/bg_rect_mine_broad_10dp"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black_or_white"
            android:gravity="start|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/mine_google_auth"
            android:drawablePadding="8dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            app:drawableStartCompat="@mipmap/ic_google_broad_auth"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/mine_auth_broad_state"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/mLlPassWord"
        android:background="@drawable/bg_rect_mine_broad_10dp"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black_or_white"
            android:gravity="start|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/mine_pay_password"
            android:drawablePadding="8dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            app:drawableStartCompat="@mipmap/ic_pay_password_broad_auth"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/mine_auth_broad_state"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/mLlSecurity"
        android:background="@drawable/bg_rect_mine_broad_10dp"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black_or_white"
            android:gravity="start|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/mine_security_auth"
            android:drawablePadding="8dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            app:drawableStartCompat="@mipmap/ic_security_broad_auth"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/mine_auth_broad_state"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/mLlLoginPwd"
        android:background="@drawable/bg_rect_mine_broad_10dp"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black_or_white"
            android:gravity="start|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/account_pwd"
            android:drawablePadding="8dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            app:drawableStartCompat="@mipmap/ic_security_broad_login_pwd"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_3B47DD"
            android:gravity="end|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_look_go"
            android:layout_marginEnd="@dimen/dp_16"/>
    </LinearLayout>
</LinearLayout>
