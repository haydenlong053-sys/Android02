<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="300dp"
        android:layout_height="180dp"
        android:background="@drawable/shape_white_round_broad_10">
        <TextView
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="正在下载"
            android:textColor="#36C34E"
            android:textSize="17dp"
            android:textStyle="bold"
            android:layout_marginTop="26dp"/>
        <TextView
            android:id="@+id/tv_current_progress"
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="#36C34E"
            android:textSize="12dp"
            android:textStyle="bold"
            android:layout_marginTop="73dp"/>

        <ProgressBar
            android:layout_marginTop="91dp"
            android:id="@+id/bottom_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:max="100"
            android:layout_marginLeft="28dp"
            android:layout_marginRight="28dp"
            android:progressDrawable="@drawable/down_load_progress_broad_bar"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="正在努力的更新中，请稍等……"
            android:textColor="#666666"
            android:textSize="10dp"
            android:layout_marginLeft="27dp"
            android:layout_marginTop="109dp"/>

        <RelativeLayout
            android:id="@+id/rl_cancle_down_load_layout"
            android:layout_width="84dp"
            android:layout_height="48dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true">
            <TextView
                android:text="取消"
                android:layout_centerInParent="true"
                android:textSize="14dp"
                android:textColor="#666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </RelativeLayout>


    </RelativeLayout>

</LinearLayout>
