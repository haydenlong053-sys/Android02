<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvBiaoti"
            android:text="@string/温馨提示"
            android:textSize="17sp"
            android:textColor="@color/color_text0"
            android:textStyle="bold"
            android:layout_marginTop="19dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="35dp"
            android:layout_marginTop="23dp"
            android:gravity="center"
            android:text="发现新版本，请前往AppStore更新"
            android:textColor="@color/color_text_content"
            android:textSize="15sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="25dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvCancel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="47dp"
                android:gravity="center"
                android:layout_marginRight="10dp"
                android:textColor="@color/color_text_dialog_left"
                android:textSize="14sp"
                android:text="@string/取消"
                android:background="@mipmap/ic_bg_btn1_02" />
            <TextView
                android:id="@+id/tvConfirm"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="47dp"
                android:gravity="center"
                android:layout_marginRight="10dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:text="@string/确定"
                android:background="@mipmap/ic_bg_btn2_02" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>