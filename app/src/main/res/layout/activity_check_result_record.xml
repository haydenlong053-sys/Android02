<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/layout_my_toolbar_style1" android:id="@+id/toolbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.hjq.shape.view.ShapeView
            android:id="@+id/shapeView"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_72"
            android:layout_marginHorizontal="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_radius="@dimen/dp_31"
            app:shape_shadowColor="#999e9e9e"
            app:shape_shadowSize="@dimen/dp_10"
            app:shape_solidColor="@color/white" />

        <com.cboda.baselibrary.view.magicindicator.MagicIndicator
            android:id="@+id/aiMagicIndicator"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_52"
            android:layout_marginHorizontal="@dimen/dp_15"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@id/shapeView"
            app:layout_constraintEnd_toEndOf="@id/shapeView"
            app:layout_constraintStart_toStartOf="@id/shapeView"
            app:layout_constraintTop_toTopOf="@id/shapeView"
            />


        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:paddingBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shapeView" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>

