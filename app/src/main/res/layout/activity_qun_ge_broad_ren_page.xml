<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_rect_white_broad_16dp"
                android:paddingVertical="24dp"
                >

                <com.cboda.baselibrary.widge.VpGradeView
                    android:id="@+id/ivTouxiang"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_92"
                    app:user_img_width="@dimen/dp_80"
                    app:user_vip_width="@dimen/dp_27"
                    app:user_grade_text_size="11sp"
                    app:user_grade_height="16dp"
                    app:user_grade_pad="8dp"
                    app:user_vip_margin_bottom="-18dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:visibility="visible" />



                <TextView
                    android:id="@+id/tvname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxWidth="200dp"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivTouxiang"
                    tools:text="亚历克斯福建省大不大方水电费哈吉斯发送" />

                <ImageView
                    android:id="@+id/ivxingbie"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:src="@mipmap/ic_msg_icon_boy"
                    app:layout_constraintBottom_toBottomOf="@+id/tvname"
                    app:layout_constraintStart_toEndOf="@+id/tvname"
                    app:layout_constraintTop_toTopOf="@+id/tvname" />

                <TextView
                    android:id="@+id/tvnicheng"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="17dp"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxWidth="200dp"
                    android:maxLines="1"
                    android:textColor="@color/black_65"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvname"
                    tools:text="昵称：i后来"
                    />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvnicheng"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    >

                    <com.hjq.shape.view.ShapeTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivTouxiang"
                        app:shape_strokeColor="@color/black_12"
                        app:shape_solidColor="@color/color_F7F8FA"
                        app:shape_strokeWidth="0.5dp"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="8dp"
                        android:text="活跃"
                        app:shape_radius="10dp"
                        />

                    <com.hjq.shape.view.ShapeTextView
                        android:id="@+id/mTvJoinGroupDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivTouxiang"
                        app:shape_strokeColor="@color/black_12"
                        app:shape_solidColor="@color/color_F7F8FA"
                        app:shape_strokeWidth="0.5dp"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="8dp"
                        tools:text="入群:100天"
                        app:shape_radius="10dp"
                        android:layout_marginStart="8dp"
                        />

                    <com.hjq.shape.view.ShapeTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivTouxiang"
                        app:shape_strokeColor="@color/black_12"
                        app:shape_solidColor="@color/color_F7F8FA"
                        app:shape_strokeWidth="0.5dp"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="8dp"
                        android:text="邀请入群"
                        app:shape_radius="10dp"
                        android:layout_marginStart="8dp"
                        />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:id="@+id/mTvManageDes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:text="@string/qunguanli"
                android:layout_marginTop="8dp"
                android:layout_marginStart="@dimen/dp_17"
                android:textColor="@color/black_65"
                />

            <com.hjq.shape.layout.ShapeLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp">
                <com.hjq.shape.layout.ShapeLinearLayout
                    android:id="@+id/shezhijinyan"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    app:shape_radius="@dimen/dp_12"
                    app:shape_solidColor="@color/white"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="@dimen/dp_12"
                    >
                    <com.hjq.shape.layout.ShapeFrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:shape="oval"
                        app:shape_solidColor="@color/color_F7F8FA"
                        android:layout_marginTop="16dp"
                        >
                        <ImageView
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:src="@mipmap/ic_g_mute"
                            android:layout_gravity="center"
                            />
                    </com.hjq.shape.layout.ShapeFrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/shezhijinyan"
                        android:textColor="@color/black"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="禁止在群内发言"
                        android:textColor="@color/black_65"
                        android:layout_marginTop="2dp"
                        android:textSize="11sp"
                        />



                </com.hjq.shape.layout.ShapeLinearLayout>

                <com.hjq.shape.layout.ShapeLinearLayout
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    app:shape_radius="@dimen/dp_12"
                    app:shape_solidColor="@color/white"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="@dimen/dp_12"
                    android:visibility="gone"
                    tools:visibility="visible"
                    >
                    <com.hjq.shape.layout.ShapeFrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:shape="oval"
                        app:shape_solidColor="@color/color_F7F8FA"
                        android:layout_marginTop="16dp"
                        >
                        <ImageView
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:src="@mipmap/ic_g_fank"
                            android:layout_gravity="center"
                            />
                    </com.hjq.shape.layout.ShapeFrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="撤回发言"
                        android:textColor="@color/black"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="撤回10分钟内发言"
                        android:textColor="@color/black_65"
                        android:layout_marginTop="2dp"
                        android:textSize="11sp"
                        />



                </com.hjq.shape.layout.ShapeLinearLayout>

                <com.hjq.shape.layout.ShapeLinearLayout
                    android:id="@+id/yichubenqun"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    app:shape_radius="@dimen/dp_12"
                    app:shape_solidColor="@color/white"
                    android:gravity="center_horizontal"
                    >
                    <com.hjq.shape.layout.ShapeFrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:shape="oval"
                        app:shape_solidColor="@color/color_F7F8FA"
                        android:layout_marginTop="16dp"
                        >
                        <ImageView
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:src="@mipmap/ic_g_bank"
                            android:layout_gravity="center"
                            />
                    </com.hjq.shape.layout.ShapeFrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/yichubenqun"
                        android:textColor="@color/black"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="移出后无法查看消息"
                        android:textColor="@color/black_65"
                        android:layout_marginTop="2dp"
                        android:textSize="11sp"
                        />



                </com.hjq.shape.layout.ShapeLinearLayout>

            </com.hjq.shape.layout.ShapeLinearLayout>


        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mViewSetManger"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_rect_white_broad_16dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:visibility="visible"
            >

            <TextView
                android:id="@+id/mTvMangerDes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/group_set_as_manager"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/mScChangeManger"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/mScChangeManger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="15dp"
                android:background="@null"
                android:theme="@style/switchStyle"
                android:thumb="@drawable/thumb_broad_selector"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:track="@drawable/track_broad_selector" />

            <View
                android:id="@+id/changeMangerView"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pengyouquanlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rect_white_broad_16dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:visibility="visible"
            >

            <TextView
                android:id="@+id/pengyouquan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginVertical="25dp"
                android:text="@string/朋友圈"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/pengyouquan"
                app:layout_constraintEnd_toStartOf="@id/mViewGo"
                android:layout_marginHorizontal="6dp"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/mViewGo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:src="@mipmap/ic_set_broad_more"
                app:layout_constraintBottom_toBottomOf="@id/pengyouquan"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/pengyouquan" />
            <View
                android:id="@+id/mViewJump"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>



        <TextView
            android:id="@+id/tianjiadaotongxun"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_rect_white_broad_16dp"
            android:layout_margin="16dp"
            android:gravity="center"
            android:text="@string/tianjiadaotongxun"
            android:textColor="@color/color_3B47DD"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/mLlOpenFri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rect_white_broad_16dp"
            android:layout_margin="16dp"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:gravity="center"
                android:drawableStart="@mipmap/ic_m_icon_rejuse"
                android:drawablePadding="@dimen/dp_9"
                android:text="不可私聊"
                android:textColor="@color/black_45"
                android:textSize="16sp"
                 />

        </LinearLayout>


        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/mViewFriendActions"
            android:layout_width="match_parent"
            android:layout_height="81dp"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:visibility="visible">
            <com.hjq.shape.layout.ShapeLinearLayout
                android:id="@+id/mViewChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                app:shape_radius="@dimen/dp_12"
                app:shape_solidColor="@color/white"
                android:gravity="center"
                android:layout_marginEnd="@dimen/dp_12"

                >
                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@mipmap/ic_g_chat"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="启动对话"
                    android:textColor="@color/color_3B47DD"
                    android:layout_marginTop="8dp"
                    android:textSize="12sp" />


            </com.hjq.shape.layout.ShapeLinearLayout>
            <com.hjq.shape.layout.ShapeLinearLayout
                android:id="@+id/mViewCall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                app:shape_radius="@dimen/dp_12"
                app:shape_solidColor="@color/white"
                android:gravity="center"
                android:layout_marginEnd="@dimen/dp_12"

                >
                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@mipmap/ic_g_call"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="语音聊天"
                    android:textColor="@color/color_3B47DD"
                    android:layout_marginTop="8dp"
                    android:textSize="12sp" />


            </com.hjq.shape.layout.ShapeLinearLayout>
            <com.hjq.shape.layout.ShapeLinearLayout
                android:id="@+id/mViewMore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                app:shape_radius="@dimen/dp_12"
                app:shape_solidColor="@color/white"
                android:gravity="center"
                android:layout_marginEnd="@dimen/dp_12"

                >
                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@mipmap/ic_g_more"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="更多操作"
                    android:textColor="@color/color_3B47DD"
                    android:layout_marginTop="8dp"
                    android:textSize="12sp" />


            </com.hjq.shape.layout.ShapeLinearLayout>



        </com.hjq.shape.layout.ShapeLinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

