<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hjq.shape.view.ShapeView
        android:id="@+id/returnView"
        android:layout_width="@dimen/dp_50"
        android:layout_height="@dimen/dp_50"
        android:layout_marginStart="@dimen/dp_11"
        android:layout_marginTop="@dimen/dp_0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shape_radius="@dimen/dp_30"
        app:shape_shadowColor="#A69e9e9e"
        app:shape_shadowSize="@dimen/dp_5"
        app:shape_solidColor="@color/white" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/ic_broad_back2"
        app:layout_constraintBottom_toBottomOf="@id/returnView"
        app:layout_constraintEnd_toEndOf="@id/returnView"
        app:layout_constraintStart_toStartOf="@id/returnView"
        app:layout_constraintTop_toTopOf="@id/returnView" />

    <com.hjq.shape.view.ShapeView
        android:id="@+id/clearView"
        android:layout_width="@dimen/dp_50"
        android:layout_height="@dimen/dp_50"
        android:layout_marginEnd="@dimen/dp_11"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/returnView"
        app:shape_radius="@dimen/dp_30"
        app:shape_shadowColor="#A69e9e9e"
        app:shape_shadowSize="@dimen/dp_5"
        app:shape_solidColor="@color/white" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/icon_squre_notice_clear"
        app:layout_constraintBottom_toBottomOf="@id/clearView"
        app:layout_constraintEnd_toEndOf="@id/clearView"
        app:layout_constraintStart_toStartOf="@id/clearView"
        app:layout_constraintTop_toTopOf="@id/clearView" />


    <androidx.appcompat.widget.AppCompatTextView
        app:layout_constraintStart_toEndOf="@id/returnView"
        app:layout_constraintEnd_toStartOf="@id/clearView"
        app:layout_constraintTop_toTopOf="@id/returnView"
        app:layout_constraintBottom_toBottomOf="@id/returnView"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:text="消息中心"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>