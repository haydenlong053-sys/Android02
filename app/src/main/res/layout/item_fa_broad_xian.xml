<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_marginHorizontal="16.5dp"
        style="@style/Line2"
        android:layout_width="match_parent"
        />
    <LinearLayout
        android:id="@+id/llItem"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <ImageView
            android:id="@+id/imIcon"
            android:src="@mipmap/ic_broad_baidu"
            android:layout_width="33.5dp"
            android:layout_height="33.5dp"/>
        <TextView
            android:id="@+id/tvTitle"
            android:text="@string/百度"
            android:textColor="@color/color_text0"
            android:textSize="15sp"
            android:layout_marginLeft="7dp"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <ImageView
            android:src="@mipmap/ic_broad_next"
            android:layout_marginLeft="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>