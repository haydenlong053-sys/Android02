            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="@id/aiProjectIv3"
            app:layout_constraintStart_toStartOf="@id/aiProjectIv3"
            app:layout_constraintTop_toTopOf="@id/aiProjectContent5" />

        <Space
