<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/mLlSysCurrency"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/bg_rect_mine_transfer"
            >
            <TextView
                android:id="@+id/mTvSysCurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mine_sys_currency"
                android:textSize="12sp"
                android:textColor="@color/color_3B47DDk"
                />
            <TextView
                android:id="@+id/mTvSysCurrencyValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="899899.66"
                android:textSize="20sp"
                android:textColor="@color/color_3B47DDk"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                />

        </LinearLayout>
        <LinearLayout
            android:id="@+id/mLlSysPoint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/bg_rect_mine_transfer"
            android:layout_marginStart="11dp"
            >
            <TextView
                android:id="@+id/mTvSysPoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mine_sys_point"
                android:textSize="12sp"
                android:textColor="@color/black_65"
                />
            <TextView
                android:id="@+id/mTvSysPointValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2299.01"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                />

        </LinearLayout>

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mClMoneyAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rect_mine_eeeff0_10dp"
        >
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            app:layout_constraintDimensionRatio="H,343:101"
            android:scaleType="fitXY"
            android:src="@mipmap/ic_bg_transfer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription"
            />
        <TextView
            android:id="@+id/mTvMyMoneyAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_my_money_address"
            android:textSize="12sp"
            android:textColor="@color/black_65"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/mTvMoneyQrcode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_money_qrcode"
            android:padding="12dp"
            android:layout_marginEnd="4dp"
            android:textSize="12sp"
            android:textColor="@color/black_65"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />



        <LinearLayout
            android:id="@+id/mLlMoneyAddressCopy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="13dp"
            >
            <TextView
                android:id="@+id/mTvMoneyAddressKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="GHFSHSGDJDFYDYGHFSHSGDJDFYDYGHFSHSGDJDFYDYGHFSHSGDJDFYDYGHFSHSGDJDFYDYGHFSHSGDJDFYDYGHFSHSGDJDFYDYGHFSHSGDJDFYDY"
                android:gravity="center|start"
                android:textColor="@color/black_65"
                android:textSize="16sp"
                android:lines="1"
                android:ellipsize="end"
                />

            <ImageView
                android:id="@+id/mIvCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/dp_5"
                android:src="@mipmap/ic_copy"
                android:layout_marginEnd="6dp"
                tools:ignore="ContentDescription" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/mLlInputAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_rect_mine_eeeff0_10dp"
        android:gravity="center"
        android:orientation="horizontal"
        >

        <EditText
            android:id="@+id/mEtInputAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center|start"
            android:hint="@string/mine_input_money_address"
            android:text=""
            android:importantForAutofill="no"
            android:padding="16dp"
            android:textColorHint="@color/black_35"
            android:textColor="@color/black"
            android:textSize="14sp"
            tools:ignore="TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/mTvPaste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/mine_google_auth_copy"
            android:gravity="center|start"
            android:textColor="@color/color_3B47DDk"
            android:textSize="14sp"
            />
    </LinearLayout>

    <EditText
        android:id="@+id/mEtInputMoney"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rect_mine_eeeff0_10dp"
        android:gravity="center|start"
        android:hint="@string/mine_input_money"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:padding="16dp"
        android:textColorHint="@color/black_35"
        android:textColor="@color/black"
        android:textSize="14sp"
        tools:ignore="TouchTargetSizeCheck"
        android:layout_marginHorizontal="16dp"
        />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_handling_fee"
            android:gravity="center"
            android:textColor="@color/black_or_white_45"
            android:textSize="14sp"
            />
        <TextView
            android:id="@+id/mTvHandlingFee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:gravity="center"
            android:textColor="@color/color_select_black45_3b47dd"
            android:textSize="14sp"
            />
    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_Actual_amount_received"
            android:gravity="center"
            android:textColor="@color/black_or_white_45"
            android:textSize="14sp"
            />
        <TextView
            android:id="@+id/mTvActualAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/color_select_black45_3b47dd"
            android:textSize="14sp"
            />
    </LinearLayout>


    <TextView
        android:id="@+id/mTvSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rect_submit_16dp"
        android:text="@string/mine_google_auth_submit"
        android:textColor="@color/white"
        android:padding="12dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="16dp"
        android:gravity="center"
        android:layout_gravity="bottom"
        />

</LinearLayout>