<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:background="@color/black"
    android:layout_height="match_parent">

    <com.hjq.shape.view.ShapeView
        android:id="@+id/indicatorView"
        android:layout_width="@dimen/dp_208"
        android:alpha="0.3"
        android:layout_height="@dimen/dp_36"
        app:shape_radius="@dimen/dp_8"
        app:shape_solidColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.cboda.baselibrary.view.magicindicator.MagicBroadIndicator
        android:id="@+id/magicIndicator"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_margin="@dimen/dp_1"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/indicatorView"
        app:layout_constraintEnd_toEndOf="@id/indicatorView"
        app:layout_constraintStart_toStartOf="@id/indicatorView"
        app:layout_constraintTop_toTopOf="@id/indicatorView" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/magicIndicator" />
</androidx.constraintlayout.widget.ConstraintLayout>