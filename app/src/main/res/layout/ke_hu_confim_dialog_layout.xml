<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/yellow">

    <com.base.commonlibrary.shapeview.shape.ShapeConstraintLayout
        android:id="@+id/rootView"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"
        app:shapeCornersRadius="15dp"
        app:shapeSolidColor="@color/color_dialog">


        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="温馨提示"
            android:textColor="@color/color_text0"
            android:textSize="19sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="本平台只允许年满18周岁的成年人使用"
            android:textColor="@color/color_text_content"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle" />


        <TextView
            android:id="@+id/tvNotAgree"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="26dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="退出软件"
            android:textColor="@color/color_text_dialog_left"
            android:textSize="14sp"
            android:background="@mipmap/ic_bg_btn1_02"
            app:layout_constraintEnd_toStartOf="@+id/tvAgree"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvContent"
    />


        <TextView
            android:id="@+id/tvAgree"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:background="@mipmap/ic_bg_btn2_02"
            android:layout_marginStart="4dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="26dp"
            android:gravity="center"
            android:text="我已成年"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvNotAgree"
            app:layout_constraintTop_toBottomOf="@+id/tvContent"
         />


        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            app:layout_constraintTop_toBottomOf="@+id/tvAgree" />

    </com.base.commonlibrary.shapeview.shape.ShapeConstraintLayout>
</LinearLayout>