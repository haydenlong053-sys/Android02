<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_call_plugin_container_fl"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:layout_gravity="center"
    >

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical">
        <FrameLayout
            android:id="@+id/mViewRootMeetMain"
            android:layout_width="@dimen/dp_88"
            android:layout_height="@dimen/dp_96"
            android:background="@drawable/bg_meet_mini_bg"
            >
            <com.cboda.baselibrary.view.MeetVoiceWaveBroadView
                android:id="@+id/mVoiceWaveView"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_4"
                android:layout_gravity="center_horizontal"
                />
            <com.cboda.baselibrary.view.AppRoundBroadImage
                android:id="@+id/chat_call_zoom_avatar_iv"
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_56"
                android:layout_gravity="center_horizontal"
                android:scaleType="centerCrop"
                android:visibility="visible"
                app:app_round_round_type="0"
                app:app_round_border_color="#D4AF37"
                app:app_round_border_width="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_16"
                android:src="@mipmap/ic_head_broad_defaut"
                tools:src="@mipmap/ic_head_broad_defaut"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/mIvIconMic"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/bg_mic_icon"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_56"
                android:layout_gravity="end"
                tools:ignore="ContentDescription" />
            <com.hjq.shape.view.ShapeTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_40"
                android:lines="1"
                android:ellipsize="end"
                app:shape_radius="@dimen/dp_4"
                app:shape_solidColor="@color/color_D4AF37"
                android:paddingVertical="@dimen/dp_1"
                android:paddingHorizontal="@dimen/dp_4"
                android:textSize="9sp"
                android:textColor="@color/white"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_gravity="center_horizontal"
                android:text="@string/msg_meeting_main_mic"
                />
            <TextView
                android:id="@+id/mTvUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_78"
                android:gravity="center"
                android:maxWidth="@dimen/dp_65"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="111"
                android:textSize="10sp"
                android:textColor="@color/white"
                />
        </FrameLayout>

        <include layout="@layout/meet_call_plugin_layout_four_site"/>
    </LinearLayout>



</FrameLayout>