<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <LinearLayout
        android:layout_marginTop="50dp"
        android:gravity="center_vertical|right"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tvRightTxt"
            android:text="@string/预览字体大小"
            android:padding="16dp"
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="@drawable/bg_rect_eeeeed_broad_5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_marginLeft="13dp"
            android:layout_marginRight="27dp"
            android:src="@mipmap/ic_broad_head"
            android:layout_width="45dp"
            android:layout_height="45dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_marginLeft="27dp"
            android:layout_marginRight="13dp"
            android:src="@mipmap/ic_broad_head"
            android:layout_width="45dp"
            android:layout_height="45dp"/>
        <TextView
            android:id="@+id/tvLeftTxt"
            android:text="@string/拖动下面滑条可设置字大小"
            android:padding="18dp"
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="@drawable/bg_rect_eeeeed_broad_5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="0dp"/>
    <com.cboda.intelligent.widge.FontSizeBroadView
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/fsv_font_size"
        android:layout_width="match_parent"
        android:layout_height="146dp"
        android:background="@color/bg_main_space"
        app:circleRadius="11dp"
        app:lineColor="#999999"
        app:txtCircleColor="@color/white"
        app:textFontColor="@color/black"
        app:standerSize="16" />
</LinearLayout>