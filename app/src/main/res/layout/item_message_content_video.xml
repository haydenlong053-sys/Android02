<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/videoContentLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="2dp">

    <com.cboda.baselibrary.view.RoundedImageBroadView
        android:id="@+id/iv_video_cover"
        android:layout_width="@dimen/dp_140"
        android:layout_height="@dimen/dp_140"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:riv_corner_radius="@dimen/dp_12"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:src="@color/black" />

    <ImageView
        android:id="@+id/iv_video_play"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_centerInParent="true"
        android:contentDescription="@null"
        android:src="@mipmap/img_video_play_broad_session" />

    <TextView
        android:id="@+id/tv_video_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@id/iv_video_cover"
        android:layout_alignBottom="@id/iv_video_cover"
        android:layout_margin="4dp"
        android:padding="2dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        tools:text="00:12" />
</RelativeLayout>
