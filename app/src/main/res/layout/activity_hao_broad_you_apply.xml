<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_F7F8FA"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.hjq.shape.view.ShapeTextView
        android:textSize="16sp"
        android:id="@+id/tv_cancel"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:text="@string/quxiao"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/btn_cancel"/>
    <com.hjq.shape.view.ShapeTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:id="@+id/tvPhoneLogin"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="@string/mine_sure"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/btn_ok"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginBottom="@dimen/dp_15"
        app:layout_constraintBottom_toTopOf="@+id/tvPhoneLogin"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black_65"
                android:id="@+id/tv_apply_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/fasonghaouyoushenqing"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.hjq.shape.layout.ShapeConstraintLayout
                android:id="@+id/layout_apply_reason"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_apply_title"
                app:shape_radius="@dimen/dp_10"
                app:shape_solidColor="@color/white">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/color_text0"
                    android:textColorHint="@color/black_35"
                    android:gravity="start|top"
                    android:id="@+id/edtshenqing"
                    android:background="@null"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/fasonghaouyoushenqing"
                    android:maxLines="4"
                    android:maxLength="100"
                    android:inputType="textMultiLine"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </com.hjq.shape.layout.ShapeConstraintLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black_65"
                android:id="@+id/tv_remark_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/shezhibneizhutispb"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_apply_reason"/>
            <com.hjq.shape.layout.ShapeConstraintLayout
                android:id="@+id/layout_remark"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_remark_title"
                app:shape_radius="@dimen/dp_10"
                app:shape_solidColor="@color/white">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/color_text0"
                    android:textColorHint="@color/black_35"
                    android:gravity="start|center_vertical"
                    android:id="@+id/edtbeizhu"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/shezhibneizhutispa"
                    android:maxLength="16"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </com.hjq.shape.layout.ShapeConstraintLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black_65"
                android:id="@+id/tv_circle_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/set_circle_tags"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_remark"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/layout_circle_row1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_13"
                android:layout_marginEnd="@dimen/dp_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_circle_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
