<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F3F5"
    android:orientation="vertical">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/page_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.hjq.shape.view.ShapeView
            android:id="@+id/page_title_left_icon"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:layout_marginStart="@dimen/dp_5"
            android:layout_marginTop="@dimen/dp_5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_radius="@dimen/dp_30"
            app:shape_shadowColor="#A69e9e9e"
            app:shape_shadowSize="@dimen/dp_5"
            app:shape_solidColor="@color/white" />

        <ImageView
            android:id="@+id/mIvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_broad_back2"
            app:layout_constraintBottom_toBottomOf="@id/page_title_left_icon"
            app:layout_constraintEnd_toEndOf="@id/page_title_left_icon"
            app:layout_constraintStart_toStartOf="@id/page_title_left_icon"
            app:layout_constraintTop_toTopOf="@id/page_title_left_icon" />


        <Space
            android:id="@+id/rightView"
            android:layout_width="@dimen/dp_60"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/page_title_left_icon" />

        <com.hjq.shape.view.ShapeView
            android:id="@+id/page_title_right_icon"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:layout_marginStart="@dimen/dp_5"
            app:layout_constraintBottom_toBottomOf="@id/page_title_left_icon"
            app:layout_constraintEnd_toStartOf="@id/rightView"
            app:layout_constraintTop_toTopOf="@id/page_title_left_icon"
            app:shape_radius="@dimen/dp_30"
            app:shape_shadowColor="#A69e9e9e"
            app:shape_shadowSize="@dimen/dp_5"
            app:shape_solidColor="@color/white" />


        <ImageView
            android:id="@+id/mIvBack2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_broad_gengduo"
            app:layout_constraintBottom_toBottomOf="@id/page_title_right_icon"
            app:layout_constraintEnd_toEndOf="@id/page_title_right_icon"
            app:layout_constraintStart_toStartOf="@id/page_title_right_icon"
            app:layout_constraintTop_toTopOf="@id/page_title_right_icon" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            app:layout_constraintBottom_toBottomOf="@id/page_title_left_icon"
            app:layout_constraintEnd_toStartOf="@id/page_title_right_icon"
            app:layout_constraintStart_toEndOf="@id/page_title_left_icon"
            app:layout_constraintTop_toTopOf="@id/page_title_left_icon">

            <com.hjq.shape.layout.ShapeConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_0"
                android:layout_marginHorizontal="@dimen/dp_0"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_18"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shape_radius="@dimen/dp_30"
                app:shape_shadowColor="#A69e9e9e"
                app:shape_shadowSize="@dimen/dp_5"
                app:shape_solidColor="@color/white">

                <TextView
                    android:id="@+id/page_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textAlignment="gravity"
                    android:textColor="@color/color_text0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/titleGradeAndTime"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    tools:text="用户信息" />

                <LinearLayout
                    android:id="@+id/titleGradeAndTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/page_title"
                    tools:visibility="visible">

                    <com.hjq.shape.view.ShapeTextView
                        android:id="@+id/titleGrade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp_4"
                        android:textColor="#A5000000"
                        android:textSize="10sp"
                        app:shape_radius="@dimen/dp_4"
                        tools:text="信誉：89分" />

                    <com.hjq.shape.view.ShapeTextView
                        android:id="@+id/titleTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:paddingHorizontal="@dimen/dp_4"
                        android:textColor="#A5000000"
                        android:textSize="10sp"
                        app:shape_radius="@dimen/dp_4"
                        tools:text="信誉：89分" />
                </LinearLayout>
            </com.hjq.shape.layout.ShapeConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.cboda.baselibrary.widge.HighPerformanceDanmakuView
            android:id="@+id/verticalDanmakuView"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_400"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/dp_15"
            android:layout_marginBottom="@dimen/message_list_danmaku_bottom_margin"
            android:clickable="false"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="@dimen/message_list_danmaku_bottom_margin">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/danmakuIv"
                android:layout_width="@dimen/dp_66"
                android:layout_height="@dimen/dp_74"
                android:paddingTop="@dimen/dp_8"
                android:scaleType="centerCrop"
                android:src="@mipmap/icon_dm"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <com.hjq.shape.view.ShapeView
                android:id="@+id/danmakuView"
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_50"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/danmakuIv"
                app:layout_constraintEnd_toEndOf="@id/danmakuIv"
                app:shape_radius="@dimen/dp_4"
                app:shape_solidColor="@color/color_EB534B"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

</LinearLayout>