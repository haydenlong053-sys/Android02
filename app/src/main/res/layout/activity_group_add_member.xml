<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/wechat_bg_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/wechat_bg_white"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <EditText
            android:id="@+id/et_search_keyword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/create_group_search_hint"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="text"
            style="@style/WeChatEditText"/>
        <Button
            android:id="@+id/btn_search_users"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_group_search"
            android:layout_marginStart="8dp"
            style="@style/WeChatButtonSecondary"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/group_add_member_select"
        style="@style/WeChatSectionLabel"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_members"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress_members"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/wechat_green"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/tv_members_empty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_group_members_empty"
            style="@style/WeChatTextSecondary"/>
    </FrameLayout>
    <Button
        android:id="@+id/btn_confirm_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/group_add_member_confirm"
        style="@style/WeChatButtonPrimary"/>
</LinearLayout>
