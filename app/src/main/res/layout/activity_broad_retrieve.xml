<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".lj.EquipmentBroadActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:src="@mipmap/ic_login_broad_bg" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/viHead"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <ImageView
                android:id="@+id/imFinish"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:padding="18dp"
                android:src="@mipmap/ic_broad_back" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#333333"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLanguage"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_marginRight="17dp"
                android:layout_gravity="center_vertical|right"
                android:background="@drawable/bg_rect_b3b3b9_broad_12dp"
                android:drawableRight="@mipmap/ic_login_broad_qiehuan"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="中文"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </FrameLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_broad_logo" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:orientation="horizontal"
                    android:paddingLeft="35dp">

                    <RelativeLayout
                        android:id="@+id/rlYzm"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp">
                        <ImageView
                            android:id="@+id/imYzm"
                            android:layout_alignParentBottom="true"
                            android:src="@mipmap/ic_login_bt_broad_bg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvYzm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:text="@string/验证码找回"
                            android:textColor="#222222"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_marginLeft="50dp">
                        <ImageView
                            android:id="@+id/imPassword"
                            android:visibility="gone"
                            android:layout_alignParentBottom="true"
                            android:src="@mipmap/ic_login_bt_broad_bg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:text="@string/支付密码找回"
                            android:textColor="#515763"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/llYzmPhone"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="34dp"
                        android:layout_marginTop="40dp"
                        android:drawableLeft="@mipmap/ic_login_broad_phone"
                        android:drawablePadding="12dp"
                        android:text="@string/手机号"
                        android:textColor="#4D5668"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="33dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rect_f7f8fa_broad_22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvDiqu"
                            android:text="+86"
                            android:textSize="14sp"
                            android:drawablePadding="5dp"
                            android:drawableRight="@mipmap/ic_login_broad_xiala"
                            android:paddingLeft="19dp"
                            android:paddingRight="5dp"
                            android:paddingVertical="6dp"
                            android:textColor="#333333"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <View
                            android:background="#CCCCCC"
                            android:layout_width="0.5dp"
                            android:layout_height="18.5dp"/>
                        <EditText
                            android:id="@+id/etPhone"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:inputType="number"
                            android:background="@null"
                            android:hint="@string/请输入手机号"
                            android:paddingHorizontal="10dp"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="34dp"
                        android:layout_marginTop="25dp"
                        android:drawableLeft="@mipmap/ic_login_broad_yzm"
                        android:drawablePadding="12dp"
                        android:text="@string/验证码"
                        android:textColor="#4D5668"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="33dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rect_f7f8fa_broad_22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/etYzm"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/请输入验证码"
                            android:inputType="number"
                            android:paddingHorizontal="22dp"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <View
                            android:background="#CCCCCC"
                            android:layout_width="0.5dp"
                            android:layout_height="18.5dp"/>
                        <TextView
                            android:id="@+id/tvGetCode"
                            android:text="@string/获取验证码"
                            android:gravity="center"
                            android:textSize="12sp"
                            android:textColor="#484949"
                            android:layout_width="104dp"
                            android:layout_height="match_parent"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/llPassword"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="34dp"
                        android:layout_marginTop="40dp"
                        android:drawableLeft="@mipmap/ic_login_broad_phone"
                        android:drawablePadding="12dp"
                        android:text="@string/手机号"
                        android:textColor="#4D5668"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="33dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rect_f7f8fa_broad_22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/etPasswordPhone"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/请输入手机号"
                            android:paddingHorizontal="22dp"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="34dp"
                        android:layout_marginTop="25dp"
                        android:drawableLeft="@mipmap/ic_login_broad_phone"
                        android:drawablePadding="12dp"
                        android:text="@string/支付密码"
                        android:textColor="#4D5668"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="33dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rect_f7f8fa_broad_22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/etPayPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/请输入支付密码"
                            android:paddingHorizontal="22dp"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="34dp"
                        android:layout_marginTop="25dp"
                        android:drawableLeft="@mipmap/ic_login_broad_yzm"
                        android:drawablePadding="12dp"
                        android:text="@string/图文验证码"
                        android:textColor="#4D5668"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="33dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rect_f7f8fa_broad_22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/etPasswordYzm"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/请输入图文验证码"
                            android:paddingHorizontal="22dp"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                       <ImageView
                           android:id="@+id/ivYzm"
                           android:layout_marginRight="25dp"
                           android:background="@color/white"
                           android:layout_width="72dp"
                           android:layout_height="28dp"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="34dp"
                    android:layout_marginTop="32dp"
                    android:drawableLeft="@mipmap/ic_login_broad_password"
                    android:drawablePadding="12dp"
                    android:text="@string/新密码"
                    android:textColor="#4D5668"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="33dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rect_f7f8fa_broad_22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etNewPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/请输入新密码"
                        android:inputType="textPassword"
                        android:paddingHorizontal="22dp"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imNewEyes"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:paddingRight="28dp"
                        android:src="@mipmap/ic_broad_biyan" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="34dp"
                    android:layout_marginTop="32dp"
                    android:drawableLeft="@mipmap/ic_login_broad_password"
                    android:drawablePadding="12dp"
                    android:text="@string/密码"
                    android:textColor="#4D5668"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="33dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rect_f7f8fa_broad_22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/请确认新密码"
                        android:inputType="textPassword"
                        android:paddingHorizontal="22dp"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imEnterEyes"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:paddingRight="28dp"
                        android:src="@mipmap/ic_broad_biyan" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginHorizontal="33dp"
                    android:background="@drawable/bg_broad_button"
                    android:gravity="center"
                    android:text="@string/立即提交"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="35dp"
                    android:layout_marginBottom="30dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbAgree"
                        style="@style/CustomCheckboxTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:padding="5dp"
                        android:text="@string/我已阅读并同意"
                        android:textColor="#999999"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvXy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="@string/用户协议"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="@string/和"
                        android:textColor="#999999"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvYs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="@string/隐私协议"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</RelativeLayout>