<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main2"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="32dp"
        android:text="@string/设置密保问题"
        android:textColor="@color/black_or_white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:text="@string/密保问题"
        android:textColor="@color/black_or_white_65"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/mLlQuestionTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_rect_mine_broad_10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mTvQuestionTable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center|start"
            android:paddingHorizontal="12dp"
            android:paddingVertical="18dp"
            android:textColor="@color/color_3B47DDk"
            android:textSize="16sp"
            tools:ignore="TouchTargetSizeCheck"
            tools:text="@string/mine_diy_question" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:src="@mipmap/ic_select_broad_type"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <TextView
        android:id="@+id/mTvDiyDes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:text="@string/密保问题"
        android:textColor="@color/black_or_white_65"
        android:textSize="14sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/mEtDiyQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_rect_mine_broad_10dp"
        android:gravity="center|start"
        android:hint="@string/mine_input_question"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:paddingVertical="18dp"
        android:textColor="@color/black_or_white"
        android:textColorHint="@color/black_or_white_45"
        android:textSize="16sp"
        android:visibility="gone"
        tools:ignore="LabelFor,TouchTargetSizeCheck" />


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:text="@string/密保答案"
        android:textColor="@color/black_or_white_65"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/mEtAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_rect_mine_broad_10dp"
        android:gravity="center|start"
        android:hint="@string/mine_input"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:paddingVertical="18dp"
        android:singleLine="true"
        android:textColor="@color/black_or_white"
        android:textColorHint="@color/black_or_white_45"
        android:textSize="16sp"
        tools:ignore="LabelFor,TouchTargetSizeCheck" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/mTvSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_rect_submit_broad_16dp"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/mine_sure"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mTvCancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_rect_blue_broad_line"
        android:gravity="center"
        android:text="@string/cancel"
        android:textColor="@color/color_3B47DDk"
        android:textSize="16sp" />
</LinearLayout>