                android:maxWidth="@dimen/dp_65"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="name1"
                android:textSize="10sp"
                android:textColor="@color/white"
                />


        </FrameLayout>
        <FrameLayout
            android:layout_width="0dp"
