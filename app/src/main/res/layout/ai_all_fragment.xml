            app:layout_constraintEnd_toEndOf="@id/view8"
            app:layout_constraintStart_toStartOf="@id/aiProjectIv5"
            app:layout_constraintTop_toBottomOf="@id/aiProjectTitle5" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/aiProjectContent9"
