<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    tools:viewBindingIgnore="true">

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tvBadge2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minWidth="@dimen/dp_13"
        android:minHeight="@dimen/dp_13"
        android:paddingHorizontal="@dimen/dp_2"
        android:text="5"
        android:textColor="@color/white"
        android:textSize="8sp"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        app:shape_radius="@dimen/dp_60"
        app:shape_solidColor="#FF2E2E"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_5"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvBadge2"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="发现"
        tools:textColor="@color/black"
        tools:textSize="14sp"
        tools:textStyle="bold" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tvBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="-5dp"
        android:gravity="center"
        android:minWidth="@dimen/dp_13"
        android:minHeight="@dimen/dp_13"
        android:paddingHorizontal="@dimen/dp_2"
        android:textColor="@color/white"
        android:textSize="8sp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="@id/tvTitle"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        app:shape_radius="@dimen/dp_60"
        app:shape_solidColor="#FF2E2E"
        tools:text="1"
        tools:visibility="visible" />


</androidx.constraintlayout.widget.ConstraintLayout>