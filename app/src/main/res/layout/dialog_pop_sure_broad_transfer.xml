<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    >
    <LinearLayout
        android:id="@+id/mLlSaveView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rect_white_broad_16dp"
        android:layout_marginHorizontal="30dp"
        android:orientation="vertical"
        android:gravity="center"
        tools:ignore="UselessParent">

        <TextView
            android:id="@+id/mTvDes1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mine_transfer_des3"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:textSize="18sp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mine_transfer_des4"
            android:textColor="@color/black_65"
            android:gravity="start"
            android:textSize="14sp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rect_mine_eeeff0_broad_10dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="24dp"
            android:padding="12dp">
            <ImageView
                android:id="@+id/mIvAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                tools:src="@mipmap/ic_icon_broad_avatar"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
            <TextView
                android:id="@+id/mTvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="好的好的名字"
                android:textColor="@color/black"
                android:gravity="start"
                android:textSize="14sp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@id/mIvAvatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/mTvUID"
                />
            <TextView
                android:id="@+id/mTvUID"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/mine_user_uid"
                android:textColor="@color/black_65"
                android:gravity="start"
                android:textSize="12sp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@id/mIvAvatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mTvName"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mine_numb"
            android:textColor="@color/black_65"
            android:gravity="start"
            android:textSize="14sp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_rect_mine_eeeff0_broad_10dp"
            android:padding="12dp"
            android:gravity="center"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mine_transfer_des2"
                android:gravity="center|start"
                android:textColor="@color/black_65"
                android:textSize="14sp"
                />
            <TextView
                android:id="@+id/mTvMoney"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="26465"
                android:textColor="@color/black"
                android:textSize="14sp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/webX_name"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:visibility="gone"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/mTvCancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rect_mine_3b47dd_broad_10dp"
                android:text="@string/quxiao"
                android:gravity="center"
                android:textColor="@color/color_3B47DDk"
                android:textSize="16sp"
                />
            <TextView
                android:id="@+id/mTvSure"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="23dp"
                android:background="@drawable/bg_rect_solid_3b47dd_broad_10dp"
                android:text="@string/mine_sure"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                />
        </LinearLayout>


    </LinearLayout>

</FrameLayout>
