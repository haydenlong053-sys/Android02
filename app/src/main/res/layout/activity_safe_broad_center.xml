<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main2"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mine_double_auth"
        android:textColor="@color/black_or_white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="33dp"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mine_double_auth_des"
        android:textColor="@color/black_or_white_65"
        android:textSize="14sp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        />
    <LinearLayout
        android:id="@+id/mLlGoogleAuth"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rect_mine_broad_10dp"
        android:gravity="center"
        >
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            android:text="@string/mine_google_auth"
            android:gravity="center|start"
            android:textColor="@color/black_or_white"
            android:textSize="14sp"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@mipmap/ic_google_broad_auth" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/mine_auth_broad_state"
            android:layout_marginEnd="16dp"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mLlPassWord"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rect_mine_broad_10dp"
        android:gravity="center"
        >
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            android:text="@string/mine_pay_password"
            android:gravity="center|start"
            android:textColor="@color/black_or_white"
            android:textSize="14sp"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@mipmap/ic_pay_password_broad_auth" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/mine_auth_broad_state"
            android:layout_marginEnd="16dp"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mLlSecurity"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rect_mine_broad_10dp"
        android:gravity="center"
        >
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            android:text="@string/mine_security_auth"
            android:gravity="center|start"
            android:textColor="@color/black_or_white"
            android:textSize="14sp"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@mipmap/ic_security_broad_auth" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/mine_auth_broad_state"
            android:layout_marginEnd="16dp"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mLlLoginPwd"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rect_mine_broad_10dp"
        android:gravity="center"
        >
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            android:text="@string/account_pwd"
            android:gravity="center|start"
            android:textColor="@color/black_or_white"
            android:textSize="14sp"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@mipmap/ic_security_broad_login_pwd" />

    </LinearLayout>
</LinearLayout>