<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/text_bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxWidth="240dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp"
    tools:background="@drawable/bg_bubble_broad_receive">

    <TextView
        android:id="@+id/tv_quote_ref"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_message_ref_broad_bg"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp"
        android:textColor="#99000000"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="张三: 你好"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:autoLink="web"
        android:gravity="start|center_vertical"
        android:linksClickable="true"
        android:minHeight="20dp"
        android:textColor="@color/color_text0"
        android:textColorLink="@color/color_text0"
        android:textSize="16sp"
        tools:text="你好，这是一条文本消息" />
</LinearLayout>
