<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/mViewTopBg"
    android:minHeight="317dp"
    android:background="@drawable/bg_rect_white_only_top_broad_18dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="UselessParent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:id="@+id/mIvClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_auth_broad_close"
                tools:ignore="ContentDescription"
                android:padding="16dp"
                />

            <TextView
                android:id="@+id/mTvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="18dp"
                android:text="@string/mine_auth_google_code"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="16sp"
                 />

            <ImageView
                android:id="@+id/mIvGo"
                android:layout_width="48dp"
                android:layout_height="54dp"
                android:src="@mipmap/ic_auth_broad_go"
                tools:ignore="ContentDescription"
                android:padding="20dp"
                android:visibility="invisible"
                />

        </LinearLayout>
        <TextView
            android:id="@+id/mTvDes2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_google_auth_des_7"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            tools:ignore="MissingConstraints"
           android:layout_marginHorizontal="16dp"
            />
        <LinearLayout
            android:id="@+id/mLlGoogleAuthCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_rect_save_broad_10dp"
            android:gravity="center"
            android:orientation="horizontal"
            >

            <EditText
                android:id="@+id/mEtCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center|start"
                android:hint="@string/mine_google_auth_des_8"
                android:maxLength="6"
                android:importantForAutofill="no"
                android:inputType="number"
                android:padding="16dp"
                android:textColorHint="@color/black_35"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:imeOptions="actionDone"
                android:singleLine="true"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/mTvCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/mine_google_auth_copy"
                android:gravity="center|start"
                android:textColor="@color/color_3B47DDk"
                android:textSize="16sp"
                />
        </LinearLayout>


    </LinearLayout>

    <TextView
        android:id="@+id/mTvNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rect_submit_broad_16dp"
        android:padding="12dp"
        android:text="@string/mine_google_auth_des_5"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:layout_gravity="bottom"
        />
</FrameLayout>
