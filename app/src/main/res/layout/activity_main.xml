<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wechat_bg_page"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/wechat_bg_white"
        android:gravity="center"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:text="@string/app_name"
        android:textColor="@color/wechat_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        style="@style/WeChatSectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_select_user_hint" />

    <ListView
        android:id="@+id/user_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/wechat_bg_page"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent" />

    <Button
        style="@style/WeChatButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:onClick="openConversationList"
        android:text="@string/app_login" />

</LinearLayout>
