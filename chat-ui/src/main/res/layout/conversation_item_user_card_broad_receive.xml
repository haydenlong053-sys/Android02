<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayout"
        android:layout_width="@dimen/dp_239"
        android:layout_height="@dimen/dp_124"
        android:background="@drawable/bg_chat_user_card_receive"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        >

        <com.cboda.baselibrary.view.AppRoundBroadImage
            android:id="@+id/userCardPortraitImageView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/avatar_broad_def"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/userCardNameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/userCardPortraitImageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/userCardPortraitImageView"
            android:layout_marginTop="2dp"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/black"
            tools:text="用用户名用户名用户名用户名用户名用户名用户名用户名户名"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/userIdTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/userCardNameTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/userCardNameTextView"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="wfchat_id"
            android:textSize="12sp"
            android:textColor="@color/black_65"
            />
        <com.hjq.shape.view.ShapeTextView
            android:layout_width="0dp"
            android:layout_height="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/userCardPortraitImageView"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="@color/color_3B47DD"
            android:text="@string/chat_add_friend"
            android:gravity="center"
            app:shape_strokeColor="@color/color_3B47DD"
            app:shape_strokeWidth="0.5dp"
            app:shape_radius="16dp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
