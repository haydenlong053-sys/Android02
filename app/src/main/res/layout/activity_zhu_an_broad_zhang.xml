<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/bg_main_space">
    <View
        android:id="@+id/zhuanzhangvitool"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/fanhui"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:padding="18dp"
            android:src="@mipmap/ic_back" />

    </FrameLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="80dp">


        <ImageView
            android:layout_marginEnd="32dp"
            android:id="@+id/ivTouxiang"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />



        <TextView
            android:id="@+id/tvname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:ellipsize="end"
            android:maxWidth="260dp"
            android:maxLines="1"
            android:textColor="@color/color_text0"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivTouxiang"
            android:text="@string/zhuanzhuanggei" />

        <TextView
            android:id="@+id/tvnicheng"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_marginStart="24dp"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:textColor="@color/color_text_content"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvname"
            android:text="@string/shoujihaoshi" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shapeCornersTopLeftRadius="15dp"
        app:shapeCornersTopRightRadius="15dp"
        app:shapeSolidColor="@color/bg_main1" >

        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:layout_marginTop="30dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:text="@string/zhuanzhangjine"
                android:textColor="@color/color_text0"
                android:textSize="13sp"
                />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_marginStart="25dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/color_text_content"
                    android:textSize="19sp"
                    />
                <EditText
                    android:ellipsize="end"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:background="@null"
                    android:inputType="numberDecimal"
                    android:id="@+id/qianNum"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textColor="@color/color_text0"
                    android:textSize="29sp"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>

    </com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout>

</LinearLayout>