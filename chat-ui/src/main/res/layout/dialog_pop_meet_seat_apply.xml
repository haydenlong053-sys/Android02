<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rect_white_only_top_broad_18dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    >


    <TextView
        android:id="@+id/tvMeetSeatApplyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_18"
        android:gravity="center"
        android:text="@string/msg_meeting_apply_list"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMeetSeatApplyList"
        android:layout_width="match_parent"
        android:layout_height="480dp"
        android:overScrollMode="never"
        tools:listitem="@layout/item_meet_seat_apply_broad" />

</LinearLayout>
