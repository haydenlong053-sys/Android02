<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/ll_code"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginRight="8dp">
            <com.cboda.baselibrary.shapeview.shape.ShapeTextBroadView
                android:inputType="numberPassword"
                app:shapeCornersRadius="5dp"
                app:shapeSolidColor="#2C2C2C"
                android:id="@+id/tv_code1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#9C1FFB"
                android:textSize="22dp"
                android:background="@null"
                android:gravity="center"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginRight="8dp">
            <com.cboda.baselibrary.shapeview.shape.ShapeTextBroadView
                android:inputType="numberPassword"
                app:shapeCornersRadius="5dp"
                app:shapeSolidColor="#2C2C2C"
                android:id="@+id/tv_code2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#9C1FFB"
                android:textSize="22dp"
                android:background="@null"
                android:gravity="center"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginRight="8dp">
            <com.cboda.baselibrary.shapeview.shape.ShapeTextBroadView
                android:inputType="numberPassword"
                app:shapeCornersRadius="5dp"
                app:shapeSolidColor="#2C2C2C"
                android:id="@+id/tv_code3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#9C1FFB"
                android:textSize="22dp"
                android:background="@null"
                android:gravity="center"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginRight="8dp">
            <com.cboda.baselibrary.shapeview.shape.ShapeTextBroadView
                android:inputType="numberPassword"
                app:shapeCornersRadius="5dp"
                app:shapeSolidColor="#2C2C2C"
                android:id="@+id/tv_code4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#9C1FFB"
                android:textSize="22dp"
                android:background="@null"
                android:gravity="center"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginRight="8dp">
            <com.cboda.baselibrary.shapeview.shape.ShapeTextBroadView
                android:inputType="numberPassword"
                app:shapeCornersRadius="5dp"
                app:shapeSolidColor="#2C2C2C"
                android:id="@+id/tv_code5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#9C1FFB"
                android:textSize="22dp"
                android:background="@null"
                android:gravity="center"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginRight="8dp">
            <com.cboda.baselibrary.shapeview.shape.ShapeTextBroadView
                android:inputType="numberPassword"
                app:shapeCornersRadius="5dp"
                app:shapeSolidColor="#2C2C2C"
                android:id="@+id/tv_code6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#9C1FFB"
                android:textSize="22dp"
                android:background="@null"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <com.lxkj.aiim.widge.SecurityEditText
        android:id="@+id/et_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/ll_code"
        android:layout_alignBottom="@+id/ll_code"
        android:background="@android:color/transparent"
        android:textColor="@android:color/transparent"
        android:cursorVisible="false"
        android:maxLength="4"
        android:inputType="numberPassword"/>
</RelativeLayout>

