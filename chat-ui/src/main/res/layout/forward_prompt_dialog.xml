<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="分享给:"
        android:textSize="16sp"
        android:textColor="@color/black"
        />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/portraitImageView"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/avatar_def" />


        <TextView
            android:id="@+id/nameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="@dimen/item_margin_left_and_right"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textSize="18sp"
            tools:text="imndx" />
    </LinearLayout>

    <TextView
        android:id="@+id/contentTextView"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rect_line_f3f4f8_10dp"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="visible"
        android:singleLine="true"
        tools:text="message" />

    <com.cboda.chatui.widget.BubbleImageBroadView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/contentImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"
        android:adjustViewBounds="true"
        android:background="#D9D9D9"
        android:maxHeight="150dp"
        android:minWidth="80dp"
        android:minHeight="80dp"
        android:scaleType="fitCenter"
        app:bubble_angle="5dp"
        app:bubble_showArrow="false"
        app:bubble_showShadow="false"
        app:bubble_showText="false" />


    <EditText
        android:id="@+id/editText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="@drawable/bg_rect_solid_f3f4f8_10dp"
        android:hint="发消息"
        android:textColorHint="@color/black65"
        android:gravity="center_vertical"
        android:imeOptions="actionDone"
        android:textSize="14sp"
        android:singleLine="true"
        android:visibility="visible" />

</LinearLayout>