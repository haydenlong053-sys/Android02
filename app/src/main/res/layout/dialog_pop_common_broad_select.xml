<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rect_white_only_top_broad_18dp"
    android:layout_gravity="bottom">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:id="@+id/mIvClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_auth_close"
                tools:ignore="ContentDescription"
                android:padding="16dp"
                />

            <TextView
                android:id="@+id/mTvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="18dp"
                android:text="@string/请选择密保问题"
                android:gravity="center"
                android:textColor="@color/color_3B47DDk"
                android:textSize="16sp"
                />

            <ImageView
                android:id="@+id/mIvGo"
                android:layout_width="48dp"
                android:layout_height="54dp"
                android:src="@mipmap/ic_auth_go"
                tools:ignore="ContentDescription"
                android:padding="20dp"
                android:visibility="invisible"
                />

        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="@color/colorF7F8FA"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="@color/colorF7F8FA"/>
        <TextView
            android:id="@+id/mTvCancel"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:text="@string/quxiao"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:layout_gravity="bottom"
            />
    </LinearLayout>

</FrameLayout>
