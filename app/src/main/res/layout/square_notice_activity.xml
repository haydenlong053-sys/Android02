<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main2">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.hjq.shape.view.ShapeView
            android:id="@+id/returnView"
            android:layout_width="@dimen/dp_62"
            android:layout_height="@dimen/dp_62"
            android:layout_marginStart="@dimen/dp_11"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_radius="@dimen/dp_31"
            app:shape_shadowColor="#739e9e9e"
            app:shape_shadowSize="@dimen/dp_10"
            app:shape_solidColor="@color/white" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/backIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_broad_back2"
            app:layout_constraintBottom_toBottomOf="@id/returnView"
            app:layout_constraintEnd_toEndOf="@id/returnView"
            app:layout_constraintStart_toStartOf="@id/returnView"
            app:layout_constraintTop_toTopOf="@id/returnView" />

        <com.hjq.shape.view.ShapeView
            android:id="@+id/clearView"
            android:layout_width="@dimen/dp_62"
            android:layout_height="@dimen/dp_62"
            android:layout_marginEnd="@dimen/dp_11"
            app:layout_constraintBottom_toBottomOf="@id/returnView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/returnView"
            app:shape_radius="@dimen/dp_31"
            app:shape_shadowColor="#739e9e9e"
            app:shape_shadowSize="@dimen/dp_10"
            app:shape_solidColor="@color/white" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/clearIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/icon_squre_notice_clear"
            app:layout_constraintBottom_toBottomOf="@id/clearView"
            app:layout_constraintEnd_toEndOf="@id/clearView"
            app:layout_constraintStart_toStartOf="@id/clearView"
            app:layout_constraintTop_toTopOf="@id/clearView" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/titleTv"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/square_notice_title"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/returnView"
            app:layout_constraintEnd_toStartOf="@id/clearView"
            app:layout_constraintStart_toEndOf="@id/returnView"
            app:layout_constraintTop_toTopOf="@id/returnView" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.hjq.shape.layout.ShapeConstraintLayout
        android:id="@+id/ruleCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_14"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="@color/color_3B47DD_12">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ruleIcon"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_square_publish_info"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ruleTitle"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_8"
            android:text="@string/square_notice_rule_title"
            android:textColor="@color/black_90"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/ruleArrow"
            app:layout_constraintStart_toEndOf="@id/ruleIcon"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ruleSubtitle"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_4"
            android:layout_marginEnd="@dimen/dp_8"
            android:text="@string/square_notice_rule_subtitle"
            android:textColor="@color/black_45"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/ruleArrow"
            app:layout_constraintStart_toEndOf="@id/ruleIcon"
            app:layout_constraintTop_toBottomOf="@id/ruleTitle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ruleArrow"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@mipmap/ic_broad_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/color_3B47DD"
            tools:ignore="ContentDescription" />
    </com.hjq.shape.layout.ShapeConstraintLayout>

    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/smart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ruleCard">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/dp_16"
                tools:listitem="@layout/item_square_notice_message" />

            <LinearLayout
                android:id="@+id/llNoData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp_140"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_140"
                    android:layout_height="@dimen/dp_140"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_empty_broad_bg" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/square_notice_empty"
                    android:textColor="@color/black_45"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
