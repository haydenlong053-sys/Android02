<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <View
            android:id="@+id/viHead"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <TextView
            android:text="@string/发现"
            android:textColor="@color/color_text0"
            android:textSize="18sp"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="60dp"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="13dp"
                    android:background="@drawable/bg_rect_broad_main"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/llFenxaing"
                        android:paddingHorizontal="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="55dp">
                        <ImageView
                            android:src="@mipmap/ic_broad_haoyoufenxiang"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:text="@string/好友分享"
                            android:textColor="@color/color_text0"
                            android:textSize="15sp"
                            android:layout_marginLeft="14dp"
                            android:textStyle="bold"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>
                        <com.cboda.intelligent.widge.BadgeBroadView
                            android:id="@+id/badgeView"
                            android:layout_width="40dp"
                            android:layout_height="24dp"/>
                        <ImageView
                            android:src="@mipmap/ic_next"
                            android:layout_marginLeft="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <View
                        android:id="@+id/viLine"
                        android:layout_marginHorizontal="16.5dp"
                        android:background="#09F0F0F0"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"/>
                    <LinearLayout
                        android:id="@+id/llSao"
                        android:paddingHorizontal="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="55dp">
                        <ImageView
                            android:src="@mipmap/ic_faxian_broad_soayisao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:text="@string/扫一扫"
                            android:textColor="@color/color_text0"
                            android:textSize="15sp"
                            android:layout_marginLeft="14dp"
                            android:textStyle="bold"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>
                        <ImageView
                            android:src="@mipmap/ic_next"
                            android:layout_marginLeft="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:text="@string/发现"
                    android:layout_marginLeft="31dp"
                    android:layout_marginTop="25dp"
                    android:textSize="15sp"
                    android:textColor="@color/color_text0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="13dp"
                    android:background="@drawable/bg_rect_broad_main"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/llQiandao"
                        android:paddingHorizontal="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="55dp">
                        <ImageView
                            android:layout_marginLeft="6dp"
                            android:src="@mipmap/ic_broad_qiandaohongbao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:text="@string/签到红包"
                            android:textColor="@color/color_text0"
                            android:textSize="15sp"
                            android:layout_marginLeft="14dp"
                            android:textStyle="bold"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>
                        <ImageView
                            android:src="@mipmap/ic_next"
                            android:layout_marginLeft="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/ryFaxian"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


    </LinearLayout>


</FrameLayout>