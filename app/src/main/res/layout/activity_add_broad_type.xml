<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main_space"
    >
    <TextView
        android:text="@string/可以通过以下方式搜索到我"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="3dp"
        android:textColor="@color/color_text0"
        android:textSize="12sp"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="43dp"/>
    <LinearLayout
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:background="@color/bg_main1"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <TextView
            android:text="@string/用户名"
            android:textSize="15sp"
            android:textColor="@color/color_text0"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/imYonghu"
            android:src="@mipmap/ic_broad_kai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:background="@color/bg_main1"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <TextView
            android:text="@string/账户ID"
            android:textSize="15sp"
            android:textColor="@color/color_text0"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/imID"
            android:src="@mipmap/ic_broad_kai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:paddingHorizontal="20dp"
        android:layout_marginTop="0.5dp"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:background="@color/bg_main1"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <TextView
            android:text="@string/手机号"
            android:textSize="15sp"
            android:textColor="@color/color_text0"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/imPhone"
            android:src="@mipmap/ic_broad_kai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:text="@string/可以通过以下方式添加我为好友"
        android:layout_marginLeft="20dp"
        android:textColor="@color/color_text0"
        android:textSize="12sp"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="43dp"/>
    <LinearLayout
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:background="@color/bg_main1"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <TextView
            android:text="@string/群聊"
            android:textSize="15sp"
            android:textColor="@color/color_text0"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/imQun"
            android:src="@mipmap/ic_broad_kai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:paddingHorizontal="20dp"
        android:layout_marginTop="0.5dp"
        android:gravity="center_vertical"
        android:background="@color/bg_main1"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <TextView
            android:text="@string/名片"
            android:textSize="15sp"
            android:textColor="@color/color_text0"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/imMingpian"
            android:src="@mipmap/ic_broad_kai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:paddingHorizontal="20dp"
        android:layout_marginTop="0.5dp"
        android:gravity="center_vertical"
        android:background="@color/bg_main1"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <TextView
            android:text="@string/二维码"
            android:textSize="15sp"
            android:textColor="@color/color_text0"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/imErweima"
            android:src="@mipmap/ic_broad_kai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>