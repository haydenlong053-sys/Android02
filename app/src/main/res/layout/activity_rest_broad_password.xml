<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#4d5668"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34dp"
        android:layout_marginTop="32dp"
        android:text="@string/新密码"
        android:drawableLeft="@mipmap/ic_login_broad_yzm"
        android:drawablePadding="12dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_rect_f7f8fa_broad_22dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="33dp">
        <EditText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:id="@+id/etNewPassword"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/请输入新密码"
            android:layout_weight="1"
            android:paddingHorizontal="22dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#4d5668"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34dp"
        android:layout_marginTop="32dp"
        android:text="@string/确认新密码"
        android:drawableLeft="@mipmap/ic_login_broad_yzm"
        android:drawablePadding="12dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_rect_f7f8fa_broad_22dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="33dp">
        <EditText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:id="@+id/etConfirmNewPassword"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/请确认新密码"
            android:layout_weight="1"
            android:paddingHorizontal="22dp"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvSubmit"
        android:background="@drawable/bg_broad_button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:text="@string/完成"
        android:layout_marginHorizontal="33dp"/>
</LinearLayout>
