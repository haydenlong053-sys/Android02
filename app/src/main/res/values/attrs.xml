<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="MyUnreadCountTextView">
        <attr name="my_paint_color" format="color|reference"/>
    </declare-styleable>


    <declare-styleable name="TopNavigationLayout">
        <attr name="backIcon" format="reference" />
        <attr name="navigationTitle" format="string" />
        <attr name="textColor" format="color" />
        <attr name="showRightIcon" format="boolean" />
        <attr name="rightIcon" format="reference" />

    </declare-styleable>

    <declare-styleable name="FontSizeView">
        <attr name="lineColor" format="color" />
        <attr name="txtCircleColor" format="color" />
        <attr name="lineWidth" format="dimension" />
        <attr name="circleRadius" format="dimension" />

        <attr name="totalCount1" format="integer" />
        <attr name="textFontColor" format="color" />
        <attr name="smallSize" format="integer" />
        <attr name="standerSize" format="integer" />

        <attr name="bigSize" format="integer" />
        <attr name="defaultPosition" format="integer" />
    </declare-styleable>

        <declare-styleable name="AvatarShadowView">
            <attr name="shadowColor" format="color"/>
            <attr name="shadowDx" format="dimension"/>
            <attr name="shadowDy" format="dimension"/>
            <attr name="shadowRadius" format="dimension"/>
        </declare-styleable>
</resources>