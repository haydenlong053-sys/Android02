<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AUIKit.AUIChatListBroadView">
        <item name="aui_chatListView_appearance">@style/AUIChatListBroadView.Appearance</item>
    </style>
    <style name="Theme.AUIKit.AUIChatBottomView">
        <item name="aui_chatBottomView_appearance">@style/AUIChatBottomView.Appearance</item>
    </style>

    <style name="Theme.AUIKit.AUIEmojiBroadView">
        <item name="aui_emojiView_appearance">@style/AUIEmojiBroadView.Appearance</item>
    </style>
    <style name="Theme.AUIKit.Basic" parent="Theme.MaterialComponents.Light">
        <item name="android:windowBackground">@android:color/white</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/aui_primary</item>
        <item name="colorPrimaryVariant">@color/aui_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/aui_grey_light</item>
        <item name="colorSecondaryVariant">@color/aui_grey_light</item>
        <item name="colorOnSecondary">@color/aui_black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- 基础组件 -->
        <!--         Button       -->
        <item name="aui_button_appearance">@style/AUIBroadButton</item>
        <item name="aui_button_appearance_stroke">@style/AUIBroadButton.Stroke.Dark</item>
        <item name="aui_button_appearance_min">@style/AUIBroadButton.Mini</item>
        <item name="aui_button_appearance_min_stroke">@style/AUIBroadButton.Mini.Stroke</item>
        <item name="aui_button_appearance_circle">@style/AUIBroadButton.Circle</item>
        <item name="aui_button_appearance_circle_stroke">@style/AUIBroadButton.Circle.Stroke</item>
        <!--         EditText       -->
        <item name="aui_editText_appearance">@style/AUIEditBroadText</item>
        <item name="aui_editText_appearance_outline">@style/AUIEditBroadText.OutLine</item>
        <!--         BottomDialog       -->
        <item name="aui_bottomDialog_appearance">@style/AUIBottomBroadDialog</item>
        <!--         AlertDialog       -->
        <item name="aui_alertDialog_appearance">@style/AUIAlertBroadDialog.Dark</item>
        <item name="aui_alertDialog_appearance_outline">@style/AUIAlertBroadDialog.Outline</item>
        <!--         Dividers       -->
        <item name="aui_dividers_appearance">@style/AUIBroadDividers</item>
        <!--         TitleBar       -->
        <item name="aui_titleBar_appearance">@style/AUITitleBroadBar</item>
        <!--         NavigationBar       -->
        <item name="aui_navigationBar_appearance">@style/AUINavigationBroadBar</item>
        <!--         TabLayout       -->
        <item name="aui_tabLayout_appearance">@style/AUITabBroadLayout</item>
        <item name="aui_tabLayout_appearance_round">@style/AUITabBroadLayout.Round</item>
        <!--         AUICellBroadText       -->
        <item name="aui_cellText_appearance">@style/AUICellBroadText</item>
    </style>
    <style name="Theme.AUIKit.AUIAction">
        <item name="aui_action_appearance">@style/AUIAction.Appearance</item>
    </style>
    <!-- 系统基础主题 -->
    <style name="Theme.AUIKit" parent="Theme.AUIKit.Basic">

        <!-- 麦位组件 -->
        <item name="aui_micSeats_appearance">@style/AUIMicSeats.Appearance</item>
        <item name="aui_micSeatItem_appearance">@style/AUIMicSeatItem.Appearance</item>
        <item name="aui_micSeatDialog_appearance">@style/AUIMicSeatDialog.Appearance</item>

        <!-- 点歌器组件 -->
        <item name="aui_jukebox_appearance">@style/AUIJukebox.Appearance</item>
        <item name="aui_jukeboxChoose_appearance">@style/AUIJukeboxChoose.Appearance</item>
        <item name="aui_jukeboxChosen_appearance">@style/AUIJukeboxChosen.Appearance</item>
        <item name="aui_jukeboxChooseItem_appearance">@style/AUIJukeboxChooseItem.Appearance</item>
        <item name="aui_jukeboxChosenItem_appearance">@style/AUIJukeboxChosenItem.Appearance</item>

        <!--  播放器组件      -->
        <item name="aui_musicPlayer_appearance">@style/AUIMusicPlayer.Appearance</item>
        <item name="aui_musicPlayerControllerDialog_appearance">@style/AUIMusicPlayerControllerDialog.Appearance</item>
        <item name="aui_musicPlayerPresetDialog_appearance">@style/AUIMusicPlayerPresetDialog</item>
        <item name="aui_musicPlayerEffectPresetItem_appearance">@style/AUIMusicPlayerEffectPresetItem.Appearance</item>

        <!--  头部组件      -->
        <item name="aui_roomInfo_appearance">@style/AUIRoomInfo.Appearance</item>
        <item name="aui_memberInfo_appearance">@style/AUIMemberInfo.Appearance</item>
        <item name="aui_memberInfoList_appearance">@style/AUIRoomMemberListBroadView</item>

        <!--  底部组件      -->
        <item name="aui_chatBottomView_appearance">@style/AUIChatBottomView.Appearance</item>
        <item name="aui_emojiView_appearance">@style/AUIEmojiBroadView.Appearance</item>

        <!--  聊天列表组件      -->
        <item name="aui_chatListView_appearance">@style/AUIChatListBroadView.Appearance</item>

        <!--  礼物列表、礼物dialog组件      -->
        <item name="aui_giftBarrage_appearance">@style/AUIGiftBarrageBroadView.Appearance</item>
        <item name="aui_giftBottomDialog_appearance">@style/AUIGiftBottomDialog.Appearance</item>

        <!--  邀请、申请组件      -->
        <item name="aui_action_appearance">@style/AUIAction.Appearance</item>

    </style>


</resources>