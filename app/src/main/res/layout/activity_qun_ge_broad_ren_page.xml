<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_rect_white_broad_16dp"
            android:paddingVertical="24dp"
            >

            <com.cboda.baselibrary.view.RoundedImageBroadView
                android:id="@+id/ivTouxiang"
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:scaleType="centerCrop"
                app:riv_oval="true"
                />
            <com.hjq.shape.view.ShapeTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:shape_solidColor="@color/color_7A66FA"
                app:shape_radius="8dp"
                android:paddingVertical="1dp"
                android:paddingHorizontal="8dp"
                android:textColor="@color/white"
                android:text="78分"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="@id/ivTouxiang"
                app:layout_constraintEnd_toEndOf="@id/ivTouxiang"
                app:layout_constraintTop_toTopOf="@id/ivTouxiang"
                android:layout_marginTop="64dp"

                />

            <TextView
                android:id="@+id/tvname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxWidth="200dp"
                android:maxLines="1"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivTouxiang"
                tools:text="亚历克斯福建省大不大方水电费哈吉斯发送" />

            <ImageView
                android:id="@+id/ivxingbie"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="5dp"
                android:src="@mipmap/ic_msg_icon_boy"
                app:layout_constraintBottom_toBottomOf="@+id/tvname"
                app:layout_constraintStart_toEndOf="@+id/tvname"
                app:layout_constraintTop_toTopOf="@+id/tvname" />

            <TextView
                android:id="@+id/tvnicheng"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxWidth="200dp"
                android:maxLines="1"
                android:textColor="@color/black_65"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvname"
                tools:text="昵称：i后来"
                />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvnicheng"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="16dp"
                android:gravity="center"
                >

                <com.hjq.shape.view.ShapeTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivTouxiang"
                    app:shape_strokeColor="@color/black_12"
                    app:shape_solidColor="@color/color_F7F8FA"
                    app:shape_strokeWidth="0.5dp"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="8dp"
                    android:text="活跃"
                    app:shape_radius="10dp"
                    />

                <com.hjq.shape.view.ShapeTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivTouxiang"
                    app:shape_strokeColor="@color/black_12"
                    app:shape_solidColor="@color/color_F7F8FA"
                    app:shape_strokeWidth="0.5dp"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="8dp"
                    android:text="入群:100天"
                    app:shape_radius="10dp"
                    android:layout_marginStart="8dp"
                    />

                <com.hjq.shape.view.ShapeTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivTouxiang"
                    app:shape_strokeColor="@color/black_12"
                    app:shape_solidColor="@color/color_F7F8FA"
                    app:shape_strokeWidth="0.5dp"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="8dp"
                    android:text="邀请入群"
                    app:shape_radius="10dp"
                    android:layout_marginStart="8dp"
                    />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <View
            style="@style/Line2"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/shezhijinyan"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/shezhijinyan"
                android:textColor="@color/color_text0"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_broad_next" />
        </androidx.appcompat.widget.LinearLayoutCompat>


    </androidx.appcompat.widget.LinearLayoutCompat>


    <View
        android:layout_width="match_parent"
        android:layout_height="9dp" />


    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/gongnenglay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_main1"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/yichubenqun"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center"
            android:text="@string/yichubenqun"
            android:textColor="#FF5145"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#09F3F3F3" />

        <TextView
            android:id="@+id/chehuishifenzhong"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center"
            android:text="@string/chehuishifenzhongfayan"
            android:textColor="#FF5145"
            android:textSize="15sp"
            android:visibility="gone"
            tools:visibility="gone"
            />

        <View
            style="@style/Line2"
            android:layout_width="match_parent" />


    </androidx.appcompat.widget.LinearLayoutCompat>

    <TextView
        android:id="@+id/tianjiadaotongxun"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@color/bg_main1"
        android:gravity="center"
        android:text="@string/tianjiadaotongxun"
        android:textColor="#7A7BF8"
        android:textSize="15sp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>