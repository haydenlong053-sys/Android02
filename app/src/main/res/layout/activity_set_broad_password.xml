<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34dp"
        android:layout_marginTop="32dp"
        android:text="@string/原密码"
        android:drawableLeft="@mipmap/ic_login_broad_yzm"
        android:drawablePadding="12dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_rect_0b0a10_broad_10dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="33dp">
        <EditText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:textColorHint="#ffffff"
            android:id="@+id/etOldPassword"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/请输入原密码"
            android:layout_weight="1"
            android:paddingHorizontal="22dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34dp"
        android:layout_marginTop="32dp"
        android:text="@string/新密码"
        android:drawableLeft="@mipmap/ic_login_broad_yzm"
        android:drawablePadding="12dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_rect_0b0a10_broad_10dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="33dp">
        <EditText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:textColorHint="#ffffff"
            android:id="@+id/etNewPassword"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/请输入新密码"
            android:layout_weight="1"
            android:paddingHorizontal="22dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34dp"
        android:layout_marginTop="32dp"
        android:text="@string/确认新密码"
        android:drawableLeft="@mipmap/ic_login_broad_yzm"
        android:drawablePadding="12dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_rect_0b0a10_broad_10dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="33dp">
        <EditText
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:textColorHint="#ffffff"
            android:id="@+id/etConfirmNewPassword"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/请确认新密码"
            android:layout_weight="1"
            android:paddingHorizontal="22dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:paddingHorizontal="44dp">
        <TextView
            android:textSize="13sp"
            android:textColor="#5456f6"
            android:gravity="center_vertical"
            android:id="@+id/tvZhaohui"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/忘记原密码"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvSubmit"
        android:background="@mipmap/ic_bg_btn2_broad_01"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:text="@string/完成"
        android:layout_marginHorizontal="33dp"/>
</LinearLayout>
