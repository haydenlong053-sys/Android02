<?xml version="1.0" encoding="utf-8"?>
<com.cboda.chatui.widget.InputAwareBroadLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLinearLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/qungonggao"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:visibility="gone">

        <com.cboda.chatui.MarqueeTextBroadView
            android:id="@+id/gonggaoxinxi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="23dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="群公告：群公告群公告：群公告群公告：群公告群公告：群公告群公告：群公告群公告：群公告群公告：群公告群公告：群公告"
            android:textColor="@color/color_text_gonggao"
            android:textSize="13sp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/qunMeetingNotice"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:visibility="gone">

        <com.cboda.chatui.MarqueeTextBroadView
            android:id="@+id/tvQunMeeting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="23dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="群通知：已经开启语音房，点击可加入!"
            android:textColor="@color/color_text_gonggao"
            android:textSize="13sp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!--内容-->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/conversationBackgroundScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/conversationBackgroundImageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipeRefreshLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/msgRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


                <com.cboda.chatui.widget.TopInterceptBroadView
                    android:id="@+id/mViewIntercept"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />


                <com.cboda.baselibrary.widge.VerticalDanmakuView
                    android:id="@+id/verticalDanmakuView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_400"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="@dimen/dp_15"
                    android:layout_marginBottom="@dimen/dp_15"
                    android:clickable="false"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/danmakuIv"
                    android:layout_width="@dimen/dp_66"
                    android:layout_height="@dimen/dp_74"
                    android:layout_gravity="bottom|end"
                    android:paddingTop="@dimen/dp_8"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/icon_dm"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>


            <com.cboda.chatui.conversation.ConversationInputBroadPanel
                android:id="@+id/inputPanelFrameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_24" />

            <TextView
                android:id="@+id/tvPhoneLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="40dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="40dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/shape_tousu_broad_liaotian"
                android:gravity="center"
                android:text="确定"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/multiMessageActionContainerLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="@dimen/dp_15"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/unreadCountLinearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:gravity="right"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/unreadCountTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/shape_unread_message_count_label_broad_bg"
                android:maxLines="1"
                android:paddingHorizontal="15dp"
                android:paddingVertical="7dp"
                android:text="12条消息"
                android:textColor="@color/white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/unreadMentionCountTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/shape_unread_message_count_label_broad_bg"
                android:paddingHorizontal="15dp"
                android:paddingVertical="7dp"
                android:text="12条@消息"
                android:textColor="@color/white"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ongoingCallRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </FrameLayout>

</com.cboda.chatui.widget.InputAwareBroadLayout>