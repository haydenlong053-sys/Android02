<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/voice_background_color"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent">

    <io.agora.auikit.ui.basic.AUIImageBroadView
        android:layout_marginTop="3dp"
        android:layout_marginStart="12dp"
        android:id="@+id/iv_left_room"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="center"
        android:background="@drawable/bg_meeting_broad_close"
        android:src="@drawable/ic_meet_close"
        android:layout_centerVertical="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:maxEms="8"
        android:maxLines="1"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_left_room"
        app:layout_constraintBottom_toBottomOf="@id/iv_left_room"
        android:ellipsize="end"
        android:id="@+id/tv_room_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="公共事业群公共事业群公共事公共事业群公共事业群公共事业群公共事业群业群公共事业群 聊天室"
        android:layout_marginStart="8dp"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/iv_left_room"
        />
    <!-- 正在加入会议提示 -->
    <LinearLayout
        android:layout_marginTop="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_left_room"
        android:id="@+id/loadingView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_margin="16dp"
        android:padding="8dp">

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminate="true"
            style="?android:attr/progressBarStyleSmall"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tv_status_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在加入会议..."
            android:textColor="@android:color/white"
            android:textSize="16sp"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginTop="6dp"
        android:visibility="visible"
        android:id="@+id/cl_count_down"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#A6000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_left_room">

        <LinearLayout
            android:layout_marginTop="75dp"
            android:background="#D9000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="@id/ll_round_count_down"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>

        <LinearLayout
            android:id="@+id/ll_round_count_down"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="86dp"
            android:background="@drawable/bg_meeting_count_down"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_count_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white65"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="剩余00:20:01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="待开始"
                android:textColor="#25A6FF"
                android:textSize="14sp" />


        </LinearLayout>

        <TextView
            android:textStyle="bold"
            android:id="@+id/tv_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="65dp"
            android:textColor="@color/white"
            android:textSize="32sp"
            app:layout_constraintEnd_toStartOf="@+id/ll_time_line"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_round_count_down"
            tools:text="12:00" />

        <LinearLayout
            android:id="@+id/ll_time_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/tv_start_time"
            app:layout_constraintEnd_toStartOf="@id/tv_end_time"
            app:layout_constraintStart_toEndOf="@id/tv_start_time"
            app:layout_constraintTop_toTopOf="@id/tv_start_time">

            <View
                android:layout_width="36dp"
                android:layout_height="1dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#29FFFFFF" />

            <TextView
                android:id="@+id/tv_time_name"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_time_broad_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/voice_white_80"
                android:textSize="12sp"
                tools:text="3小时" />

            <View
                android:layout_width="36dp"
                android:layout_height="1dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#29FFFFFF" />

        </LinearLayout>

        <TextView
            android:textStyle="bold"
            android:id="@+id/tv_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="32sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ll_time_line"
            app:layout_constraintTop_toTopOf="@id/tv_start_time"
            tools:text="15:00" />

        <TextView
            android:id="@+id/tv_start_date"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="@id/tv_start_time"
            app:layout_constraintStart_toStartOf="@id/tv_start_time"
            app:layout_constraintTop_toBottomOf="@id/tv_start_time"
            android:textSize="14sp"
            android:textColor="@color/white65"
            tools:text="2025年9月30日"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tv_end_date"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="@id/tv_end_time"
            app:layout_constraintStart_toStartOf="@id/tv_end_time"
            app:layout_constraintTop_toBottomOf="@id/tv_end_time"
            android:textSize="14sp"
            android:textColor="@color/white65"
            tools:text="2025年9月30日"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.example.asceneskit.AUIVoiceRoomBroadView
        android:id="@+id/VoiceRoomView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keyBackground="@color/aui_black_blurry"
        android:visibility="gone"
        />


</androidx.constraintlayout.widget.ConstraintLayout>