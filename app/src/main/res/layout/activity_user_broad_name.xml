<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".lj.UserNameBroadActivity">
    <TextView
        android:text="@string/用户名"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="50dp"
        android:textColor="#89909F"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="13dp"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/bg_rect_f5f6f7_broad_22dp"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <EditText
            android:id="@+id/etUserName"
            android:textColor="#344361"
            android:hint="@string/请输入用户名称"
            android:textSize="14sp"
            android:paddingHorizontal="25dp"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/ivClear"
            android:paddingHorizontal="10dp"
            android:src="@mipmap/ic_edit_delate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvSave"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="37dp"
        android:background="@drawable/bg_broad_button"
        android:gravity="center"
        android:text="@string/完成"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>