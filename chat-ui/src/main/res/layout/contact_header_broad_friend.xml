<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llNewFriend"
        android:background="@drawable/selector_common_broad_item"
        android:paddingLeft="@dimen/item_margin_left_and_right"
        android:paddingRight="@dimen/item_margin_left_and_right"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <RelativeLayout
            android:layout_width="46dp"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ivNewFriend"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/ic_broad_xinpengyou"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_text_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/new_friend"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/unreadFriendRequestCountTextView"
            android:background="@drawable/shape_red_broad_dot"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:text="99"
            android:layout_alignTop="@+id/ivNewFriend"
            android:layout_alignRight="@+id/ivNewFriend"/>
    </LinearLayout>
    <View
        android:layout_marginLeft="68dp"
        style="@style/Line2"/>
</LinearLayout>
