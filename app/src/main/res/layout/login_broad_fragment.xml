<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/backView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/brandTv"
            android:layout_width="@dimen/dp_92"
            android:layout_height="@dimen/dp_92"
            android:src="@mipmap/icon_logo2"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/loginTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/new_app_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/brandTv"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="#7373a2"
            android:id="@+id/loginSubtitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/login_welcome_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loginTv"/>
        <com.hjq.shape.layout.ShapeConstraintLayout
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:paddingHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loginSubtitleTv"
            app:shape_angle="90"
            app:shape_endColor="#f8f7fd"
            app:shape_radius="@dimen/dp_20"
            app:shape_startColor="@color/transparent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/accountLabelTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/user_account"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.hjq.shape.view.ShapeEditText
                android:textSize="15sp"
                android:textColor="@color/black"
                android:textColorHint="#bbbbbb"
                android:id="@+id/loginAccount"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:hint="@string/auth_account_hint"
                android:maxLines="1"
                android:drawablePadding="12dp"
                android:inputType="text"
                android:drawableStart="@mipmap/icon_login_broad_account1"
                android:paddingHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/accountLabelTv"
                app:shape_radius="12dp"
                app:shape_solidColor="@color/white"
                app:shape_strokeColor="#e5e5e5"
                app:shape_strokeWidth="1dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/pwdLabelTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/密码"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/loginAccount"/>
            <com.hjq.shape.view.ShapeEditText
                android:textSize="15sp"
                android:textColor="@color/black"
                android:textColorHint="#bbbbbb"
                android:id="@+id/loginPwd"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:hint="@string/请输入密码"
                android:maxLines="1"
                android:drawablePadding="12dp"
                android:inputType="textPassword"
                android:drawableStart="@mipmap/icon_login_broad_pwd1"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pwdLabelTv"
                app:shape_radius="12dp"
                app:shape_solidColor="@color/white"
                app:shape_strokeColor="#e5e5e5"
                app:shape_strokeWidth="1dp"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/loginLookPwd"
                android:background="@color/transparent"
                android:padding="14dp"
                android:visibility="visible"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/icon_pwd_broad_close"
                android:tint="@color/color_9699A3"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="@+id/loginPwd"
                app:layout_constraintEnd_toEndOf="@+id/loginPwd"
                app:layout_constraintTop_toTopOf="@+id/loginPwd"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/loginCaptchaLayout"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/loginPwd">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/captchaLabelTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/图形验证码"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.hjq.shape.view.ShapeEditText
                        android:textSize="15sp"
                        android:textColor="@color/black"
                        android:textColorHint="#bbbbbb"
                        android:id="@+id/loginCaptcha"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:hint="@string/请输入图形验证码"
                        android:maxLines="1"
                        android:inputType="text"
                        android:layout_marginEnd="10dp"
                        android:paddingHorizontal="16dp"
                        app:shape_radius="12dp"
                        app:shape_solidColor="@color/white"
                        app:shape_strokeColor="#e5e5e5"
                        app:shape_strokeWidth="1dp"/>
                    <com.hjq.shape.view.ShapeImageView
                        android:id="@+id/loginCaptchaImage"
                        android:padding="4dp"
                        android:layout_width="96dp"
                        android:layout_height="50dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/图形验证码"
                        android:layout_marginEnd="8dp"
                        app:shape_radius="12dp"
                        app:shape_solidColor="@color/white"
                        app:shape_strokeColor="#e5e5e5"
                        app:shape_strokeWidth="1dp"/>
                    <com.hjq.shape.view.ShapeImageView
                        android:id="@+id/loginCaptchaRefresh"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_captcha_refresh"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/图形验证码"
                        app:shape_radius="12dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <com.hjq.shape.view.ShapeTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/loginBtn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="32dp"
                android:text="@string/login"
                android:alpha="0.7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/loginCaptchaLayout"
                app:shape_angle="90"
                app:shape_endColor="#9069fc"
                app:shape_radius="@dimen/dp_12"
                app:shape_startColor="#6232f9"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="15sp"
                android:textColor="#6332ed"
                android:id="@+id/loginRegisterAccount"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/go_to_register"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/loginBtn"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="13sp"
                android:textColor="#999999"
                android:id="@+id/loginForgetPwd"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/forget_password"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/loginRegisterAccount"/>
            <com.hjq.shape.view.ShapeTextView
                android:textSize="14sp"
                android:textColor="#999999"
                android:id="@+id/oneLogin"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/one_click_login"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/loginForgetPwd"
                app:shape_radius="12dp"
                app:shape_solidColor="@color/transparent"
                app:shape_strokeColor="#dddddd"
                app:shape_strokeWidth="1dp"/>
        </com.hjq.shape.layout.ShapeConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
