<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/yellow">

    <com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout
        android:id="@+id/rootView"
        android:layout_width="318dp"
        android:layout_height="300dp"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"
        app:shapeCornersRadius="12dp"
        app:shapeSolidColor="#FFFFFF">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivupadtebg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@mipmap/ic_update"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:text="发现新版本"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@+id/ivupadtebg"
            app:layout_constraintTop_toTopOf="@+id/ivupadtebg" />

        <TextView
            android:id="@+id/tvUpdateVer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="47dp"
            android:text="V.1.0.0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@+id/ivupadtebg"
            app:layout_constraintTop_toTopOf="@+id/ivupadtebg" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="100dp"
            android:layout_marginBottom="15dp"
            app:layout_constraintBottom_toTopOf="@+id/tvAgree"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvUpdateContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:lineSpacingExtra="5dp"
                android:textColor="#333333"
                android:textSize="14sp"
                tools:text="1.版本更新内容" />

        </androidx.core.widget.NestedScrollView>


        <TextView
            android:id="@+id/tvNotAgree"
            android:layout_width="160dp"
            android:layout_height="70dp"
            android:layout_marginStart="10dp"
            android:background="@mipmap/ic_not_agree"
            android:paddingStart="52dp"
            android:paddingTop="20dp"
            android:text="暂不更新"
            android:textColor="#999999"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.cboda.baselibrary.shapeview.shape.ShapeTextBroadView
            android:id="@+id/tvAgree"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="23dp"
            android:layout_marginEnd="23dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="立即更新"
            android:textColor="#FC485B"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeCornersRadius="20dp"
            app:shapeStrokeColor="#FC485B"
            app:shapeStrokeWidth="1dp" />

    </com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout>
</LinearLayout>