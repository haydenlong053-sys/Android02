<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_content_type"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="@null"
        android:visibility="gone"
        tools:src="@drawable/ic_msg_voice"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:maxWidth="@dimen/wechat_bubble_max_width"
        android:paddingStart="@dimen/wechat_bubble_padding_h"
        android:paddingTop="@dimen/wechat_bubble_padding_v"
        android:paddingEnd="@dimen/wechat_bubble_padding_h"
        android:paddingBottom="@dimen/wechat_bubble_padding_v"
        android:textColor="@color/wechat_text_primary"
        android:textSize="16sp"
        tools:background="@drawable/bg_bubble_received"
        tools:text="[语音] 5''" />
</LinearLayout>
