<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_main"
    android:orientation="vertical">
    <com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginStart="23dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="23dp"
        app:shapeCornersRadius="10dp"
        app:shapeSolidColor="@color/color_input_bg">

        <EditText
            android:id="@+id/edtBeizhu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:gravity="start"
            android:hint="@string/mingancihit"
            android:padding="15dp"
            android:paddingEnd="15dp"
            android:textColor="@color/color_text0"
            android:textColorHint="@color/color_text_content_hint"
            android:textSize="14sp" />


    </com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout>
    <TextView
        android:layout_marginTop="22dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:text="@string/mingancihit2"
        android:textColor="@color/color_text_content_hint"
        android:textSize="14sp"
        />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/rightLayout"
        android:layout_marginStart="31dp"
        android:orientation="horizontal"
        android:layout_marginTop="35dp"
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="31dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">



        <TextView
            android:id="@+id/tvAgree"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@mipmap/ic_bg_btn2_01"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:textStyle="bold"
            android:text="@string/baocunle"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvNotAgree"
            app:layout_constraintTop_toBottomOf="@+id/tvContent"
           />

    </androidx.appcompat.widget.LinearLayoutCompat>


</LinearLayout>