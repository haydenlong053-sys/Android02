<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivTopBg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_214"
        android:scaleType="fitXY"
        android:src="@drawable/ic_gc_top_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <com.hjq.shape.view.ShapeView
        android:id="@+id/shapeView"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_62"
        android:layout_marginHorizontal="@dimen/dp_74"
        android:layout_marginTop="@dimen/dp_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shape_radius="@dimen/dp_31"
        app:shape_shadowColor="#739e9e9e"
        app:shape_shadowSize="@dimen/dp_10"
        app:shape_solidColor="@color/white" />

    <com.cboda.baselibrary.view.magicindicator.MagicBroadIndicator
        android:id="@+id/gpMagicIndicator"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_margin="@dimen/dp_11"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/shapeView"
        app:layout_constraintEnd_toEndOf="@id/shapeView"
        app:layout_constraintStart_toStartOf="@id/shapeView"
        app:layout_constraintTop_toTopOf="@id/shapeView" />

    <com.cboda.baselibrary.widge.NestedViewPager
        android:id="@+id/gpViewPagerLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shapeView" />
</androidx.constraintlayout.widget.ConstraintLayout>