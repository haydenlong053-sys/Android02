<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- 发送好友申请标题 -->
    <TextView
        android:id="@+id/tv_apply_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:text="@string/fasonghaouyoushenqing"
        android:textColor="@color/color_text0"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 发送好友申请输入框（多行） -->
    <com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout
        android:id="@+id/layout_apply_reason"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_apply_title"
        app:shapeCornersRadius="12dp"
        app:shapeSolidColor="@color/color_input_bg">

        <EditText
            android:id="@+id/edtshenqing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:gravity="top|start"
            android:hint="@string/fasonghaouyoushenqing"
            android:inputType="textMultiLine"
            android:maxLength="100"
            android:maxLines="4"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="@color/color_text0"
            android:textColorHint="@color/color_text_content_hint"
            android:textSize="14sp" />

    </com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout>

    <!-- 备注名标题 -->
    <TextView
        android:id="@+id/tv_remark_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/shezhibneizhutispb"
        android:textColor="@color/color_text0"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_apply_reason" />

    <!-- 备注名输入框 -->
    <com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout
        android:id="@+id/layout_remark"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_remark_title"
        app:shapeCornersRadius="12dp"
        app:shapeSolidColor="@color/color_input_bg">

        <EditText
            android:id="@+id/edtbeizhu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:gravity="center_vertical|start"
            android:hint="@string/shezhibneizhutispa"
            android:maxLength="16"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/color_text0"
            android:textColorHint="@color/color_text_content_hint"
            android:textSize="14sp" />

    </com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout>

    <!-- 圈子标签标题 -->
    <TextView
        android:id="@+id/tv_circle_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/set_circle_tags"
        android:textColor="@color/color_text0"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_remark" />

    <!-- 第一行：亲密圈 / 社交圈 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/layout_circle_row1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_circle_title" />

    <!-- 发送按钮 -->
    <TextView
        android:id="@+id/tvPhoneLogin"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_rect_solid_3b47dd_10dp"
        android:gravity="center"
        android:text="@string/fasongshenqing"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tv_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 取消按钮 -->
    <TextView
        android:id="@+id/tv_cancel"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_rect_mine_3b47dd_10dp"
        android:gravity="center"
        android:text="@string/quxiao"
        android:textColor="@color/color_3B47DD"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>