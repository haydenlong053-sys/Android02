<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="InitTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/launch_broad_bg</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <!-- 全屏主题：隐藏状态栏和导航栏 -->
    <style name="Theme.App.Fullscreen" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="transparentFrameWindowStyle" parent="android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="main_menu_animstyle">
        <item name="android:windowEnterAnimation">@anim/photo_dialog_in_broad_anim</item>
        <item name="android:windowExitAnimation">@anim/photo_dialog_out_broad_anim</item>
    </style>

    <style name="main_menu_animstyle2">
        <item name="android:windowEnterAnimation">@anim/photo_dialog_in_broad_anim2</item>
        <item name="android:windowExitAnimation">@anim/photo_dialog_out_broad_anim2</item>
    </style>

    <style name="bottom_up_popup_animation">
        <item name="android:windowEnterAnimation">@anim/popup_broad_show</item>
        <item name="android:windowExitAnimation">@anim/popup_broad_hide</item>
    </style>

    <style name="pop_animation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/pop_broad_in</item>
        <!--
                <item name="android:windowExitAnimation">@anim/pop_broad_out</item>
        -->
    </style>

    <style name="commentDialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/main_menu_animstyle</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="dialog_trans" parent="@android:style/Theme.NoTitleBar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="switchStyle" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">#00000000</item>
        <item name="colorSwitchThumbNormal">#00000000</item>
        <item name="android:colorForeground">#00000000</item>
    </style>

    <style name="CustomCheckboxTheme" parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="android:button">@drawable/custom_checkbox_broad_selector</item>
    </style>

    <style name="slide_bar_popup_animation">
        <item name="android:windowEnterAnimation">@anim/popup_broad_show1</item>
        <item name="android:windowExitAnimation">@anim/popup_broad_hide1</item>
    </style>


    <declare-styleable name="SlideView">
        <attr name="isEnd" format="boolean" />
    </declare-styleable>


    <style name="ani_bottom" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/in_from_broad_bottom</item>  <!--进入时的动画-->
        <item name="android:windowExitAnimation">@anim/out_to_broad_bottom</item>    <!--退出时的动画-->
    </style>

    <style name="MyDialogStyle">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- 密码查看check-->
    <style name="checkbox_password_style" parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="android:button">@drawable/check_password_broad_selector</item>
        <item name="android:padding">10dp</item>
    </style>

    <!--    自研-->
    <style name="WeChatActionBar" parent="Widget.AppCompat.Light.ActionBar.Solid">
        <item name="background">@color/wechat_toolbar</item>
        <item name="titleTextStyle">@style/WeChatActionBarTitle</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="WeChatActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/wechat_text_primary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="WeChatTextPrimary">
        <item name="android:textColor">@color/wechat_text_primary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="WeChatTextSecondary">
        <item name="android:textColor">@color/wechat_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="WeChatTextCaption">
        <item name="android:textColor">@color/wechat_text_hint</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="WeChatButtonPrimary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="WeChatButtonSecondary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/wechat_green</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="WeChatEditText">
        <item name="android:background">@drawable/bg_edit_text</item>
        <item name="android:textColor">@color/wechat_text_primary</item>
        <item name="android:textColorHint">@color/wechat_text_hint</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="WeChatSectionLabel">
        <item name="android:textColor">@color/wechat_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>


</resources>