<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".lj.CircleDetailActivity">
    <LinearLayout
        android:orientation="vertical"
        android:paddingHorizontal="17dp"
        android:paddingTop="20dp"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/riIcon"
                android:src="@mipmap/ic_head"
                android:scaleType="centerCrop"
                app:riv_corner_radius="5dp"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tvName"
                    tools:text="亚历克斯"
                    android:textSize="16sp"
                    android:textColor="@color/color_text0"
                    android:textStyle="bold"
                    android:layout_marginLeft="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textIsSelectable="true"
                    android:textColorHighlight="#D7DBE1"
                    android:id="@+id/tvContent"
                    tools:text="今日无事，玩一把，儿童节快乐"
                    android:textSize="14sp"
                    android:layout_marginBottom="7dp"
                    android:textColor="@color/color_text_content"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <RelativeLayout
                    android:id="@+id/rlVideo"
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="12dp"
                    android:layout_width="200dp"
                    android:layout_height="200dp">

                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/riVideo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:src="@mipmap/ic_zhanwei"
                        app:riv_corner_radius="10dp" />

                    <ImageView
                        android:id="@+id/imVideo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:src="@mipmap/ic_video" />
                </RelativeLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ryImage"
                    android:layout_marginLeft="7.5dp"
                    android:layout_marginRight="44dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvSite"
                    tools:text="成都市·飞跃从零探险乐园"
                    android:textColor="#536596"
                    android:textSize="13sp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp">

                    <LinearLayout
                        android:id="@+id/llMoreLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:textColor="#ABABAB"
                            android:textSize="13sp"
                            tools:text="2024年6月1日 22:10" />

                        <ImageView
                            android:id="@+id/imDelate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="5dp"
                            android:src="@mipmap/ic_circle_delate" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:id="@+id/llMore"
                            android:layout_width="29dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_rect_f8f8f8_5dp"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@mipmap/ic_circle_more" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/llMoreShow"
                        android:visibility="gone"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginRight="40dp"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/bg_rect_4c4c48_3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp">
                        <LinearLayout
                            android:id="@+id/llDianzan"
                            android:paddingHorizontal="18dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">
                            <ImageView
                                android:id="@+id/imDianzan"
                                android:src="@mipmap/ic_circle_zan_false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:text="@string/点赞"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:layout_marginLeft="4.5dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <View
                            android:background="#3F3F3F"
                            android:layout_width="0.5dp"
                            android:layout_height="18dp"/>
                        <LinearLayout
                            android:id="@+id/llPinglun"
                            android:paddingHorizontal="18dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">
                            <ImageView
                                android:src="@mipmap/ic_circle_pinglun"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:text="@string/评论"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:layout_marginLeft="4.5dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/llPinglunAll"
            android:visibility="visible"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:background="#F8F8F8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/llDianzanAll"
                android:paddingLeft="21dp"
                android:paddingRight="15dp"
                android:orientation="horizontal"
                android:minHeight="44dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/imDianzanAll"
                    android:layout_marginTop="22dp"
                    android:src="@mipmap/ic_dianzan_num_false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <com.lxkj.aiim.lj.view.ExpandableTextView
                    android:id="@+id/tvDianzanName"
                    android:visibility="visible"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="17dp"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#475A83"
                    android:textSize="15sp"
                    tools:text="Addy，十天，牛大田" />
            </LinearLayout>
            <View
                android:background="#E8E8E8"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:id="@+id/llPinglunItem"
                android:paddingLeft="21dp"
                android:paddingRight="15dp"
                android:orientation="horizontal"
                android:minHeight="44dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_marginTop="21dp"
                    android:src="@mipmap/ic_pinglun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ryHuifu"
                    android:layout_marginLeft="9dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>