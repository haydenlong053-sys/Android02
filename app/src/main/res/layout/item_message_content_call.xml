<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/call_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:maxWidth="240dp"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingStart="15dp"
    android:paddingTop="12dp"
    android:paddingEnd="15dp"
    android:paddingBottom="12dp"
    tools:background="@drawable/bg_bubble_broad_receive">

    <ImageView
        android:id="@+id/iv_call_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        tools:src="@mipmap/ic_msg_cell_voice_broad_call"
        tools:tint="#1FA3FF" />

    <TextView
        android:id="@+id/tv_call_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/color_text0"
        android:textSize="16sp"
        tools:text="通话时长 00:00" />
</LinearLayout>
