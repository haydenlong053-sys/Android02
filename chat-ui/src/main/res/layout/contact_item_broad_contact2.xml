<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_text_main2"
        android:gravity="center_vertical"
        android:id="@+id/categoryTextView"
        android:paddingLeft="24dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="群主"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contactLinearLayout"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="@dimen/item_margin_left_and_right">
            <CheckBox
                android:id="@+id/checkbox"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                style="@style/CustomCheckboxTheme"/>
            <com.cboda.baselibrary.view.AppRoundBroadImage
                android:id="@+id/portraitImageView"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_head_broad_defaut"
                android:scaleType="centerCrop"
                app:app_round_round_type="0"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="11dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/color_text_main"
                    android:id="@+id/nameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="wfc"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/gray11_1"
                    android:id="@+id/descTextView"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="wfc desc"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@+id/dividerLine"
            android:visibility="visible"
            android:layout_marginHorizontal="8dp"
            style="@style/Line3"/>
    </LinearLayout>
</LinearLayout>
