<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:background="@color/bg_main"
    android:orientation="vertical">

    <com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
       >

        <ImageView
            android:id="@+id/ivTouxiang"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="15dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textColor="@color/color_text0"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/rightLayout"
            app:layout_constraintStart_toEndOf="@+id/ivTouxiang"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="亚历克斯福建省大不大方水电费哈吉斯发送" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/rightLayout"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.cboda.baselibrary.shapeview.shape.ShapeTextBroadView
                android:id="@+id/tvNotAgree"
                android:layout_width="65dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/yichuuser"
                android:textColor="@color/color_yichu"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@+id/tvAgree"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvContent"
                app:shapeCornersRadius="7dp"
                app:shapeStrokeWidth="1dp"
                app:shapeStrokeColor="@color/color_yichu" />


        </androidx.appcompat.widget.LinearLayoutCompat>


    </com.cboda.baselibrary.shapeview.shape.ShapeConstraintBroadLayout>

</LinearLayout>