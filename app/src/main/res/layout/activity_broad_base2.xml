<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mViewRootBg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main2"
    android:fitsSystemWindows="false">

    <ImageView
        android:id="@+id/mIvBgTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:background="@mipmap/ic_bg_top_broad_main"
        android:scaleType="fitXY" />


    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/backLottie"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible" />


    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/llTitleLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:id="@+id/vitool"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <FrameLayout
                android:id="@+id/mFlTitleLayout"
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/backIcon"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:padding="18dp"
                    android:src="@mipmap/ic_broad_back"
                    android:tint="@color/black_or_white" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/black_or_white"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="测试标题" />
                </FrameLayout>


                <TextView
                    android:id="@+id/tvRight"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical|end"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="24dp"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/rightIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:padding="15dp" />

            </FrameLayout>

        </LinearLayout>


    </androidx.appcompat.widget.LinearLayoutCompat>


</RelativeLayout>
