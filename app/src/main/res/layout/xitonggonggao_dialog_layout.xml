<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/yellow">

    <com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout
        android:id="@+id/rootView"
        android:layout_width="320dp"
        android:layout_height="400dp"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"
        app:shapeCornersRadius="15dp"
        app:shapeSolidColor="#FFFFFF">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@mipmap/ic_confim_top_bg"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="系统公告"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <WebView
            android:id="@+id/tvContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toTopOf="@+id/tvAgree"
            app:layout_constraintEnd_toStartOf="@+id/xiayitiao"
            app:layout_constraintStart_toEndOf="@+id/shangyitiao"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/shangyitiao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:rotation="180"
            android:src="@mipmap/ic_next"
            android:tint="#333333"
            app:layout_constraintBottom_toBottomOf="@+id/tvContent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvContent" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/xiayitiao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:src="@mipmap/ic_next"
            android:tint="#333333"
            app:layout_constraintBottom_toBottomOf="@+id/tvContent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvContent" />

        <com.cboda.baselibrary.shapeview.shape.ShapeTextView
            android:id="@+id/tvNotAgree"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/quxiao"
            android:textColor="#5456F6"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvAgree"
            app:layout_constraintStart_toStartOf="parent"
            app:shapeCornersRadius="22dp"
            app:shapeSolidColor="#DDDEFC" />


        <com.cboda.baselibrary.shapeview.shape.ShapeTextView
            android:id="@+id/tvAgree"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="26dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/shanchu"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvNotAgree"
            app:shapeCornersRadius="22dp"
            app:shapeSolidColor="#5456F6" />


        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            app:layout_constraintTop_toBottomOf="@+id/tvAgree" />

    </com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout>
</LinearLayout>