<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <com.cboda.baselibrary.view.magicindicator.MagicBroadIndicator
        android:id="@+id/sqMagicIndicator"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_30"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.cboda.baselibrary.widge.NestedViewPager
        android:id="@+id/sqViewPager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sqMagicIndicator" />
</androidx.constraintlayout.widget.ConstraintLayout>