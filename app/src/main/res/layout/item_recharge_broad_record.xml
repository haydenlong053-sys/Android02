<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/llButton"
        android:paddingHorizontal="22dp"
        android:layout_marginTop="9dp"
        android:layout_marginHorizontal="15dp"
        android:background="@drawable/bg_rect_main"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="70dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvTitle"
                android:text="余额充值"
                android:textSize="14sp"
                android:textColor="@color/color_text0"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvTime"
                android:text="2024/01/01 12:00"
                android:textSize="12sp"
                android:textColor="#999999"
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tvPrice"
            android:text="￥1000"
            android:textSize="14sp"
            android:textColor="#FF5145"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_marginLeft="3dp"
            android:src="@mipmap/ic_zhankai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/llZhankai"
        android:layout_marginTop="9dp"
        tools:visibility="visible"
        android:layout_marginHorizontal="15dp"
        android:background="@drawable/bg_rect_main"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/llChongzhi"
            android:paddingHorizontal="25dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="55dp">
            <TextView
                android:text="@string/收款人"
                android:textColor="@color/color_text0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvShoukuanUser"
                android:text="时来运转"
                android:textSize="13sp"
                android:textColor="@color/color_text_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <View
            android:layout_marginHorizontal="16.5dp"
            android:background="#11F0F0F0"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:paddingHorizontal="25dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="55dp">
            <TextView
                android:text="@string/收款账户"
                android:textColor="@color/color_text0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvShoukuanZhanghu"
                android:text="456354456364535"
                android:textSize="13sp"
                android:textColor="@color/color_text_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <View
            android:layout_marginHorizontal="16.5dp"
            android:background="#11F0F0F0"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:paddingHorizontal="25dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="55dp">
            <TextView
                android:text="@string/凭证记录"
                android:textColor="@color/color_text0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/imPingzheng"
                tools:src="@mipmap/ic_zhanwei"
                android:layout_marginLeft="8dp"
                android:layout_width="50dp"
                android:layout_height="31dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>