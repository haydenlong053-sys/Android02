<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    xmlns:tools="http://schemas.android.com/tools"
    android:theme="?attr/aui_chatListView_appearance"
    android:background="@drawable/bg_chat_system_broad_msg"
    android:gravity="center_vertical"
    android:layout_marginStart="15dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    >

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Stefano"
        android:textSize="12sp"
        android:textColor="#94A3B8"
        />

    <TextView
        android:id="@+id/content"
        android:layout_marginStart="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        tools:text="Joined"
        android:textColor="#94A3B8"
        />

    <com.cboda.agora.ui.ui.basic.AUIImageBroadView
        android:id="@+id/icon_system"
        android:visibility="gone"
        android:src="?attr/aui_barrage_system_endIcon_resource"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        android:layout_width="18dp"
        android:layout_height="18dp"/>
</LinearLayout>