<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp">
        <View
            android:id="@+id/backView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/brandLogo"
            android:layout_width="@dimen/dp_92"
            android:layout_height="@dimen/dp_92"
            android:layout_marginTop="12dp"
            android:src="@mipmap/icon_logo2"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/brandTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/new_app_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/brandLogo"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/brandTv"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="#7373a2"
            android:gravity="center"
            android:id="@+id/title2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/brandTv"/>
        <com.hjq.shape.view.ShapeTextView
            android:textSize="12sp"
            android:textColor="@color/color_3B47DD"
            android:id="@+id/content"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title2"
            app:shape_radius="12dp"
            app:shape_solidColor="#1a3b47dd"
            app:shape_strokeColor="@color/color_3B47DD"
            app:shape_strokeWidth="1dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/accountLabelTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/user_account"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content"
            app:layout_goneMarginTop="28dp"/>
        <com.hjq.shape.view.ShapeEditText
            android:textSize="15sp"
            android:textColor="@color/black"
            android:textColorHint="#bbbbbb"
            android:ellipsize="end"
            android:id="@+id/loginAccount"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="@string/auth_account_hint"
            android:maxLines="1"
            android:drawablePadding="12dp"
            android:drawableStart="@mipmap/icon_login_broad_account"
            android:paddingStart="16dp"
            android:paddingEnd="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/accountLabelTv"
            app:shape_radius="12dp"
            app:shape_solidColor="@color/white"
            app:shape_strokeColor="#e5e5e5"
            app:shape_strokeWidth="1dp"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/loginLookPwd"
            android:background="@color/transparent"
            android:padding="14dp"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/icon_clear_broad_text"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/loginAccount"
            app:layout_constraintEnd_toEndOf="@+id/loginAccount"
            app:layout_constraintTop_toTopOf="@+id/loginAccount"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/pwdLabelTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/密码"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loginAccount"/>
        <com.hjq.shape.view.ShapeEditText
            android:textSize="15sp"
            android:textColor="@color/black"
            android:textColorHint="#bbbbbb"
            android:id="@+id/loginPwd"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="@string/请输入密码"
            android:maxLines="1"
            android:drawablePadding="12dp"
            android:inputType="textPassword"
            android:drawableStart="@mipmap/icon_login_broad_pwd"
            android:paddingStart="16dp"
            android:paddingEnd="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pwdLabelTv"
            app:shape_radius="12dp"
            app:shape_solidColor="@color/white"
            app:shape_strokeColor="#e5e5e5"
            app:shape_strokeWidth="1dp"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/loginPwdLook"
            android:background="@color/transparent"
            android:padding="14dp"
            android:visibility="visible"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/icon_pwd_broad_close"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/loginPwd"
            app:layout_constraintEnd_toEndOf="@+id/loginPwd"
            app:layout_constraintTop_toTopOf="@+id/loginPwd"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/confirmPwdLabelTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/confirm_password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loginPwd"/>
        <com.hjq.shape.view.ShapeEditText
            android:textSize="15sp"
            android:textColor="@color/black"
            android:textColorHint="#bbbbbb"
            android:id="@+id/updatePwd"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="@string/please_again_input_pwd"
            android:maxLines="1"
            android:drawablePadding="12dp"
            android:inputType="textPassword"
            android:drawableStart="@mipmap/icon_login_broad_pwd"
            android:paddingStart="16dp"
            android:paddingEnd="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/confirmPwdLabelTv"
            app:shape_radius="12dp"
            app:shape_solidColor="@color/white"
            app:shape_strokeColor="#e5e5e5"
            app:shape_strokeWidth="1dp"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/updatePwdLook"
            android:background="@color/transparent"
            android:padding="14dp"
            android:visibility="visible"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/icon_pwd_broad_close"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/updatePwd"
            app:layout_constraintEnd_toEndOf="@+id/updatePwd"
            app:layout_constraintTop_toTopOf="@+id/updatePwd"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/captchaLabelTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/图形验证码"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/updatePwd"/>
        <com.hjq.shape.view.ShapeEditText
            android:textSize="15sp"
            android:textColor="@color/black"
            android:textColorHint="#bbbbbb"
            android:id="@+id/loginCaptcha"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="@string/请输入图形验证码"
            android:maxLines="1"
            android:inputType="text"
            android:layout_marginEnd="10dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toStartOf="@+id/loginCaptchaImage"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/captchaLabelTv"
            app:shape_radius="12dp"
            app:shape_solidColor="@color/white"
            app:shape_strokeColor="#e5e5e5"
            app:shape_strokeWidth="1dp"/>
        <com.hjq.shape.view.ShapeImageView
            android:id="@+id/loginCaptchaImage"
            android:padding="4dp"
            android:layout_width="96dp"
            android:layout_height="50dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/图形验证码"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/loginCaptcha"
            app:layout_constraintEnd_toStartOf="@+id/loginCaptchaRefresh"
            app:layout_constraintStart_toEndOf="@+id/loginCaptcha"
            app:layout_constraintTop_toTopOf="@+id/loginCaptcha"
            app:shape_radius="12dp"
            app:shape_solidColor="@color/white"
            app:shape_strokeColor="#e5e5e5"
            app:shape_strokeWidth="1dp"/>
        <com.hjq.shape.view.ShapeImageView
            android:id="@+id/loginCaptchaRefresh"
            android:padding="13dp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_captcha_refresh"
            android:scaleType="centerInside"
            android:contentDescription="@string/图形验证码"
            app:layout_constraintBottom_toBottomOf="@+id/loginCaptcha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/loginCaptchaImage"
            app:layout_constraintTop_toTopOf="@+id/loginCaptcha"
            app:shape_radius="12dp"
            app:shape_solidColor="#f2f2f5"/>
        <com.hjq.shape.view.ShapeTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/loginBtn"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:text="@string/register"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loginCaptcha"
            app:shape_angle="90"
            app:shape_endColor="#9069fc"
            app:shape_radius="@dimen/dp_12"
            app:shape_startColor="#6232f9"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
