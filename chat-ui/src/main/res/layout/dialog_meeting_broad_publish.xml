<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="296dp"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_broad_normal"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/bg_dialog_broad_top"
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <TextView
            android:layout_centerInParent="true"
            android:textStyle="bold"
            android:text="@string/创建会议主题"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </RelativeLayout>

    <EditText
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        tools:text="公共事业群 会议室"
        android:textColor="@color/color_text_content"
        android:textColorHint="@color/color_text_content_hint"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_edit_broad_text"
        android:textSize="14sp"
        android:hint="@string/请输入会议主题"
        android:id="@+id/et_meeting_title"
        android:maxLines="1"
        android:layout_width="match_parent"
        android:layout_height="46dp"/>

    <LinearLayout
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_marginStart="24dp"
            android:textSize="14sp"
            android:textColor="@color/color_text_content"
            android:text="@string/全员开麦"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4sp"
            android:translationY="-2.13sp"
            />
        <View
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="1dp"/>
        <ImageView
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:id="@+id/iv_switch_mic"
            android:src="@mipmap/ic_switch_kai"
            android:layout_width="48dp"
            android:layout_height="28dp"/>

    </LinearLayout>
    <View style="@style/Line"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_marginStart="24dp"
            android:textSize="14sp"
            android:textColor="@color/color_text_content"
            android:text="@string/全员禁言"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4sp"
            android:translationY="-2.13sp"
            />
        <View
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="1dp"/>
        <ImageView
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:id="@+id/iv_switch_mute"
            android:src="@mipmap/ic_switch_kai"
            android:layout_width="48dp"
            android:layout_height="28dp"/>

    </LinearLayout>

    <Button
        android:id="@+id/btn_open"
        android:text="@string/open"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_btn_broad_accent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>







</LinearLayout>