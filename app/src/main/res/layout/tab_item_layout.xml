<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:background="@color/yellow">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvSelectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="美妆" />

            <TextView
                android:id="@+id/tvTabName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:visibility="gone"
                tools:text="美妆" />
        </FrameLayout>

        <com.cboda.baselibrary.shapeview.shape.ShapeTextView
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tabIndicator"
            android:layout_width="30dp"
            android:layout_height="6dp"
            app:shapeCornersRadius="3dp"
            app:shapeGradientStartColor="#A1FFB0"
            app:shapeGradientEndColor="#46FBFF"
            android:layout_marginTop="-4dp"
            android:layout_marginStart="2dp"
            android:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>