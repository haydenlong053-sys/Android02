<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fileMessageContentItemView"
    android:layout_width="wrap_content"
    android:layout_height="100dp"
    android:background="@drawable/bg_bubble_broad_receive"
    android:minWidth="200dp"
    android:padding="10dp">

    <ImageView
        android:id="@+id/fileIconImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:contentDescription="@null"
        android:src="@mipmap/ic_broad_file" />

    <TextView
        android:id="@+id/fileNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/fileIconImageView"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@id/fileIconImageView"
        android:ellipsize="end"
        android:maxWidth="160dp"
        android:maxLines="1"
        android:textColor="#58595E"
        android:textSize="18sp"
        tools:text="文件名.pdf" />

    <TextView
        android:id="@+id/fileSizeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/fileIconImageView"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@id/fileIconImageView"
        android:maxLines="1"
        android:textColor="#58595E"
        android:textSize="12sp"
        tools:text="128KB" />
</RelativeLayout>
