                android:layout_marginTop="@dimen/dp_4"
                android:layout_gravity="center_horizontal"
                />
            <com.cboda.baselibrary.view.AppRoundBroadImage
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_56"
                android:layout_gravity="center_horizontal"
                android:scaleType="centerCrop"
                android:visibility="visible"
                app:app_round_round_type="0"
                app:app_round_border_color="#D4AF37"
                app:app_round_border_width="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_16"
                android:src="@drawable/meet_mic_site_bg"
                tools:visibility="visible" />

            <ImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/bg_mic_icon"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_56"
                android:visibility="gone"
                tools:visibility="visible"
                android:layout_gravity="end"
                tools:ignore="ContentDescription" />
            <com.hjq.shape.view.ShapeTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_40"
                android:lines="1"
                android:ellipsize="end"
                app:shape_radius="@dimen/dp_4"
