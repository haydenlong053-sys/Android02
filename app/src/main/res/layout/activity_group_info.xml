<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wechat_bg_page"
    android:fillViewport="true"
    tools:context=".group.GroupInfoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/layout_group_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/wechat_bg_white"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/avatar"
                layout="@layout/view_avatar"
                android:layout_width="64dp"
                android:layout_height="64dp" />

            <TextView
                android:id="@+id/tv_group_name"
                style="@style/WeChatTextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="18sp"
                tools:text="项目群" />

            <TextView
                android:id="@+id/tv_group_id"
                style="@style/WeChatTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="g_abc123" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <include
            android:id="@+id/row_members"
            layout="@layout/item_group_setting" />

        <include
            android:id="@+id/row_notice"
            layout="@layout/item_group_setting" />

        <include
            android:id="@+id/row_qrcode"
            layout="@layout/item_group_setting" />

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <include
            android:id="@+id/row_add_member"
            layout="@layout/item_group_setting" />

        <include
            android:id="@+id/row_rename"
            layout="@layout/item_group_setting" />

        <include
            android:id="@+id/row_transfer"
            layout="@layout/item_group_setting" />

        <include
            android:id="@+id/row_apply_list"
            layout="@layout/item_group_setting" />

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <include
            android:id="@+id/row_leave"
            layout="@layout/item_group_setting" />

        <include
            android:id="@+id/row_disband"
            layout="@layout/item_group_setting" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/wechat_green"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
