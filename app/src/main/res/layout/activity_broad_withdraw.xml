<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/bg_main_space"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".lj.RechargeBroadActivity">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:paddingHorizontal="27dp"
            android:paddingVertical="20dp"
            android:layout_marginTop="17dp"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/bg_rect_broad_main"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/提现金额"
                android:textSize="14sp"
                android:textColor="@color/color_text0"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="78dp">
                <TextView
                    android:text="@string/人民币"
                    android:textSize="20sp"
                    android:textColor="@color/color_text0"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/etMoney"
                    android:textSize="30sp"
                    android:hint="@string/请输入"
                    android:textColorHint="@color/color_text_content_hint"
                    android:textColor="@color/color_text0"
                    android:paddingHorizontal="10dp"
                    android:inputType="numberDecimal"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <View
                android:background="#11F3F3F3"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tvBigBiaoti"
            tools:text="标题标题"
            android:textSize="14sp"
            android:layout_marginLeft="38dp"
            android:layout_marginTop="18dp"
            android:textColor="@color/color_text0"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:paddingHorizontal="27dp"
            android:paddingVertical="20dp"
            android:layout_marginTop="17dp"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/bg_rect_broad_main"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ryTixian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="为了保障资金安全，请您填写完成后再检查一下账号是否正确"
                android:textSize="11sp"
                android:layout_marginTop="13dp"
                android:textColor="#FF5145"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvSmallBiaoti"
                android:text="标题标题"
                android:textSize="14sp"
                android:layout_marginTop="20dp"
                android:textColor="@color/color_text0"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/imImage"
                android:layout_marginTop="15dp"
                android:src="@mipmap/ic_add_broad_image"
                android:layout_width="75dp"
                android:layout_height="75dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvEnter"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="37dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"
            android:background="@mipmap/ic_bg_btn2_broad_01"
            android:gravity="center"
            android:text="@string/确认提现"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>