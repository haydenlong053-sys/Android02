<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".lj.RegisterBroadActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:src="@mipmap/ic_bg_top_login" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:id="@+id/viHead"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="50dp"
            android:src="@mipmap/ic_logo_broad_login" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/app_name"
            android:textStyle="bold"
            android:textColor="@color/color_text0"
            android:textSize="18sp"
            />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="34dp"
                android:layout_marginTop="40dp"
                android:drawableLeft="@mipmap/ic_login_phone"
                android:drawablePadding="12dp"
                android:text="@string/用户名"
                android:textColor="@color/color_text0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="33dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rect_login"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/请输入用户名"
                    android:paddingHorizontal="22dp"
                    android:textColor="@color/color_text_content"
                    android:textColorHint="@color/color_text_content_hint"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="34dp"
            android:layout_marginTop="12dp"
            android:drawableLeft="@mipmap/ic_login_password"
            android:drawablePadding="12dp"
            android:text="@string/密码"
            android:textColor="@color/color_text0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="33dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rect_login"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/请输入密码"
                android:inputType="textPassword"
                android:paddingHorizontal="22dp"
                android:textColor="@color/color_text_content"
                android:textColorHint="@color/color_text_content_hint"
                android:textSize="14sp"
                android:textStyle="bold" />
            <CheckBox
                android:id="@+id/cb_check_pass"
                style="@style/checkbox_password_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:gravity="center"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="34dp"
            android:layout_marginTop="12dp"
            android:drawableLeft="@mipmap/ic_login_password"
            android:drawablePadding="12dp"
            android:text="@string/密码验证"
            android:textColor="@color/color_text0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="33dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rect_login"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etNewPassword2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/请再次输入密码"
                android:inputType="textPassword"
                android:paddingHorizontal="22dp"
                android:textColor="@color/color_text_content"
                android:textColorHint="@color/color_text_content_hint"
                android:textSize="14sp"
                android:textStyle="bold" />
            <CheckBox
                android:id="@+id/cb_check_pass2"
                style="@style/checkbox_password_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:gravity="center"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llInvite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="34dp"
                android:layout_marginTop="32dp"
                android:drawableLeft="@mipmap/ic_login_invite"
                android:drawablePadding="12dp"
                android:text="@string/邀请码"
                android:textColor="#4D5668"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="33dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rect_f7f8fa_22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etInvite"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/请输入邀请码"
                    android:paddingHorizontal="22dp"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubmit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="33dp"
            android:background="@mipmap/ic_bg_btn2_01"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="@string/立即注册"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="33dp"
            android:background="@mipmap/ic_bg_btn1_01"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="@string/返回登录"
            android:textColor="@color/color_text1"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="30dp"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbAgree"
                style="@style/CustomCheckboxTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="@string/我已阅读并同意"
                android:textColor="#999999"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvXy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/用户协议"
                android:textColor="#333333"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/和"
                android:textColor="#999999"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvYs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/隐私协议"
                android:textColor="#333333"
                android:textSize="12sp" />
            <TextView
                android:visibility="gone"
                android:id="@+id/tvThrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/第三方信息共享清单"
                android:textColor="#333333"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>