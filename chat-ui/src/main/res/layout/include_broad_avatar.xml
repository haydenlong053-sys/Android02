<?xml version="1.0" encoding="utf-8"?><!--<de.hdodenhof.circleimageview.CircleImageView xmlns:android="http://schemas.android.com/apk/res/android"--><!--android:id="@+id/ivAvatar"--><!--android:layout_width="40dp"--><!--android:layout_height="40dp"--><!--android:focusable="false"--><!--android:focusableInTouchMode="false"--><!--android:src="@mipmap/avatar_def"/>-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="40dp"
    android:layout_height="47dp"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <com.cboda.baselibrary.view.AppRoundBroadImage
        android:id="@+id/portraitImageView"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:app_round_round_type="0"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@mipmap/avatar_broad_def" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/portraitTv"
        android:layout_width="34dp"
        android:layout_height="14dp"
        android:gravity="center"
        android:textColor="@color/ps_color_white"
        android:textSize="8sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:shape_angle="0"
        app:shape_endColor="#7A66FA"
        app:shape_radius="7dp"
        app:shape_startColor="#956BEC"
        tools:text="78分"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>