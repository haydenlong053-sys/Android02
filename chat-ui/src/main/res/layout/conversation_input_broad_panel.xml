<?xml version="1.0" encoding="utf-8"?>

<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inputPanelFrameLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:background="@color/color_bg_input"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/inputContainerLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:focusableInTouchMode="true"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/menuImageView"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="bottom"
                android:layout_margin="5dp"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_chat_menu" />


            <ImageView
                android:id="@+id/extImageView"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="5dp"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_msg_add" />

            <ImageView
                android:id="@+id/mIvVoiceCancel"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="5dp"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_msg_voice_cancel"
                android:visibility="gone"
                tools:visibility="visible"
                />




            <ImageView
                android:id="@+id/pttImageView"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="bottom"
                android:layout_margin="5dp"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_ptt"
                android:visibility="gone"
                app:tint="@color/black" />


            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        >
                        <EditText
                            android:id="@+id/editText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/msg_input"
                            android:textColorHint="@color/black35"
                            android:background="@drawable/shape_session_text_broad_input2"
                            android:gravity="center_vertical"
                            android:maxLines="5"
                            android:minHeight="42dp"
                            android:textColor="@color/color_text0"
                            android:paddingStart="12dp"
                            android:paddingEnd="40dp"
                            android:paddingTop="6dp"
                            android:textSize="16sp"
                            android:visibility="visible" />
                        <ImageView
                            android:id="@+id/emotionImageView"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="5dp"
                            android:scaleType="centerInside"
                            android:src="@mipmap/ic_msg_emo" />
                    </FrameLayout>

                    <RelativeLayout
                        android:id="@+id/refRelativeLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        >

                        <EditText
                            android:id="@+id/refEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:background="@drawable/shape_session_ref_broad_input"
                            android:enabled="false"
                            android:maxLines="2"
                            android:minHeight="30dp"
                            android:paddingLeft="5dp"
                            android:textSize="12sp"
                            android:visibility="visible" />

                        <ImageButton
                            android:id="@+id/clearRefImageButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:src="@mipmap/ic_cancel" />

                    </RelativeLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/audioButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/shape_session_msg_voice_broad_bg"
                    android:visibility="gone"
                    tools:visibility="gone" >
                    <!-- layout.xml -->
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/mViewAnimateVoice"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:lottie_fileName="voice_data.json"
                        app:lottie_autoPlay="false"
                        app:lottie_loop="true" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/channelMenuContainerLinearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/gray"
                    android:gravity="center_vertical"
                    android:minHeight="42dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                </LinearLayout>

            </FrameLayout>

            <ImageView
                android:id="@+id/audioImageView"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="bottom"
                android:layout_margin="5dp"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_msg_voice" />

            <ImageView
                android:id="@+id/mIvVoiceSend"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="bottom"
                android:layout_margin="5dp"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_msg_voice_send"
                android:visibility="gone"
                tools:visibility="visible"
                />

            <Button
                android:id="@+id/sendButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="50dp"
                android:layout_height="35dp"
                android:layout_gravity="bottom"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="2.5dp"
                android:background="@drawable/shape_session_btn_broad_send"
                android:gravity="center"
                android:text="@string/send"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/disableInputTipTextView"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/gray2"
            android:gravity="center"
            android:text="全员禁言中"
            android:visibility="gone" />

        <View style="@style/Line" />

        <com.cboda.chatui.widget.KeyboardHeightFrameBroadLayout
            android:id="@+id/emotionContainerFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_custom_keyboard_size"
            android:visibility="gone">
            <!--表情-->
            <com.cboda.chatemoji.EmotionBroadLayout
                android:id="@+id/emotionLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </com.cboda.chatui.widget.KeyboardHeightFrameBroadLayout>

        <com.cboda.chatui.widget.KeyboardHeightFrameBroadLayout
            android:id="@+id/extContainerContainerLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_custom_keyboard_size"
            android:background="@color/color_bg_input_more"
            android:visibility="gone">

            <!--其他功能-->
            <com.cboda.chatui.widget.ViewPagerBroadFixed
                android:id="@+id/conversationExtViewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.cboda.chatui.widget.KeyboardHeightFrameBroadLayout>
    </LinearLayout>
</merge>
