<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:background="@color/black">

    <com.hjq.shape.layout.ShapeConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginHorizontal="16dp"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="@color/white">

        <!--        <com.cboda.baselibrary.view.AppRoundBroadImage-->
        <!--            android:id="@+id/ivTouxiang"-->
        <!--            android:layout_width="48dp"-->
        <!--            android:layout_height="48dp"-->
        <!--            android:layout_marginStart="12dp"-->
        <!--            app:layout_constraintBottom_toBottomOf="parent"-->
        <!--            app:layout_constraintStart_toStartOf="parent"-->
        <!--            app:layout_constraintTop_toTopOf="parent"-->
        <!--            tools:src="@color/black"-->
        <!--            />-->

        <com.cboda.baselibrary.widge.VpGradeView
            android:id="@+id/ivTouxiang"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_0"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvnicheng"
            app:layout_constraintEnd_toStartOf="@+id/rightLayout"
            app:layout_constraintStart_toEndOf="@+id/ivTouxiang"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="亚历克斯福建省大不大方水电费哈吉斯发送" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/rightLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"

            >

            <com.hjq.shape.view.ShapeTextView
                android:id="@+id/tvNotAgree"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/jujuele"
                android:textColor="@color/color_EB534B"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@+id/tvAgree"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvContent"
                app:shape_radius="8dp"
                app:shape_solidColor="@color/color_EB534B_16" />


            <com.hjq.shape.view.ShapeTextView
                android:id="@+id/tvAgree"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/jieshoule"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvNotAgree"
                app:layout_constraintTop_toBottomOf="@+id/tvContent"
                app:shape_radius="8dp"
                app:shape_solidColor="@color/color_3B47DD" />

            <TextView
                android:id="@+id/yitianjia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yitianjia"
                android:textColor="@color/black_35"
                android:textSize="14sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>


        <TextView
            android:id="@+id/tvnicheng"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#720F0F25"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/rightLayout"
            app:layout_constraintStart_toEndOf="@+id/ivTouxiang"
            app:layout_constraintTop_toBottomOf="@+id/tvname"
            tools:text="昵称：i后来1111111111111111111111111111111" />
    </com.hjq.shape.layout.ShapeConstraintLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />
</LinearLayout>