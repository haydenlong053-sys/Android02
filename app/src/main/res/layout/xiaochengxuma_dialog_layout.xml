<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/yellow">

    <com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout
        android:id="@+id/rootView"
        android:layout_width="320dp"
        android:layout_height="240dp"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"
        app:shapeCornersRadius="15dp"
        app:shapeSolidColor="#FFFFFF">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@mipmap/ic_confim_top_bg"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/xiaochengxuma"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout
            android:layout_marginTop="86dp"
            android:layout_marginStart="23dp"
            android:layout_marginEnd="23dp"
            app:shapeSolidColor="#80F2F2F2"
            app:shapeCornersRadius="10dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="45dp">

            <EditText
                android:paddingStart="25dp"
                android:id="@+id/edtBeizhu"
                android:background="@null"
                android:textColor="#666666"
                android:textSize="14sp"
                android:textColorHint="#666666"
                android:hint="@string/xiaochengxuma"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>


        </com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout>


        <com.cboda.baselibrary.shapeview.shape.ShapeTextView
            android:id="@+id/tvNotAgree"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="26dp"
            android:layout_marginBottom="26dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="@string/quxiao"
            android:textColor="#5456F6"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/tvAgree"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:shapeCornersRadius="22dp"
            app:shapeSolidColor="#DDDEFC" />


        <com.cboda.baselibrary.shapeview.shape.ShapeTextView
            android:id="@+id/tvAgree"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="26dp"
            android:layout_marginEnd="26dp"
            android:gravity="center"
            android:text="@string/queding"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvNotAgree"
            app:layout_constraintBottom_toBottomOf="parent"
            app:shapeCornersRadius="22dp"
            app:shapeSolidColor="#5456F6" />


        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            app:layout_constraintTop_toBottomOf="@+id/tvAgree" />

    </com.cboda.baselibrary.shapeview.shape.ShapeConstraintLayout>
</LinearLayout>