<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/black">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_25"
        android:text="@string/login_password_change"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.hjq.shape.view.ShapeView
        android:id="@+id/backView"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="-40dp"
        app:layout_constraintBottom_toBottomOf="@id/loginBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="#FF0F1B3A"
        app:shape_strokeColor="#FF3E5387"
        app:shape_strokeWidth="@dimen/dp_1"
        tools:visibility="visible" />


    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/loginAccount"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_50"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_40"
        android:drawableStart="@mipmap/icon_login_account"
        android:drawablePadding="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_16"
        android:textColor="@color/white"
        android:textColorHint="#7366A0F7"
        android:textSize="16sp"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="@id/backView"
        app:layout_constraintStart_toStartOf="@id/backView"
        app:layout_constraintTop_toTopOf="@id/backView"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="@color/color_080E1E"
        app:shape_strokeColor="@color/color_080E1E"
        app:shape_strokeWidth="@dimen/dp_1"
        tools:text="@string/please_enter_account" />


    <com.hjq.shape.view.ShapeEditText
        android:id="@+id/loginPwd"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_20"
        android:drawableStart="@mipmap/icon_login_pwd"
        android:drawablePadding="@dimen/dp_12"
        android:hint="@string/please_enter_password"
        android:inputType="textPassword"
        android:paddingHorizontal="@dimen/dp_16"
        android:textColor="@color/white"
        android:textColorHint="#7366A0F7"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/loginAccount"
        app:layout_constraintStart_toStartOf="@id/loginAccount"
        app:layout_constraintTop_toBottomOf="@id/loginAccount"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="@color/color_080E1E"
        app:shape_strokeColor="@color/color_080E1E"
        app:shape_strokeWidth="@dimen/dp_1"/>

    <com.hjq.shape.view.ShapeEditText
        android:id="@+id/updatePwd"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_20"
        android:drawableStart="@mipmap/icon_update_pwd"
        android:drawablePadding="@dimen/dp_12"
        android:hint="@string/please_repeat_password"
        android:inputType="textPassword"
        android:paddingHorizontal="@dimen/dp_16"
        android:textColor="@color/white"
        android:textColorHint="#7366A0F7"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/loginAccount"
        app:layout_constraintStart_toStartOf="@id/loginAccount"
        app:layout_constraintTop_toBottomOf="@id/loginPwd"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="@color/color_080E1E"
        app:shape_strokeColor="@color/color_080E1E"
        app:shape_strokeWidth="@dimen/dp_1" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/loginBtn"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_50"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_32"
        android:gravity="center"
        android:text="@string/mine_google_auth_submit"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/backView"
        app:layout_constraintStart_toStartOf="@id/backView"
        app:layout_constraintTop_toBottomOf="@id/updatePwd" />
</androidx.constraintlayout.widget.ConstraintLayout>