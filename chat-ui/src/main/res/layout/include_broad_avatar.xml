<?xml version="1.0" encoding="utf-8"?><!--<de.hdodenhof.circleimageview.CircleImageView xmlns:android="http://schemas.android.com/apk/res/android"--><!--android:id="@+id/ivAvatar"--><!--android:layout_width="40dp"--><!--android:layout_height="40dp"--><!--android:focusable="false"--><!--android:focusableInTouchMode="false"--><!--android:src="@mipmap/avatar_def"/>-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/portraitImageLayout"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dp_42"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:minWidth="@dimen/dp_40">

    <com.cboda.baselibrary.view.AppRoundBroadImage
        android:id="@+id/portraitImageView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        app:app_round_round_type="0"
        app:layout_constraintEnd_toEndOf="@id/portraitTv"
        app:layout_constraintStart_toStartOf="@id/portraitTv"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@mipmap/avatar_broad_def" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vipMirrorCredit"
        android:layout_width="@dimen/dp_17"
        android:layout_height="@dimen/dp_14"
        android:scaleType="centerCrop"
        android:src="@mipmap/new_vip"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/portraitImageView"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/portraitTv"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_14"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/dp_4"
        android:textColor="@color/ps_color_white"
        android:textSize="8sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:shape_angle="0"
        app:shape_endColor="@color/color_7A66FA"
        app:shape_radius="7dp"
        app:shape_startColor="@color/color_956BEC"
        tools:text="10.2分"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>