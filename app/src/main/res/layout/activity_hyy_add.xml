<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main_space"
    tools:context=".lj.PushActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etContent"
            android:background="@drawable/bg_rect_main"
            android:gravity="top"
            android:paddingHorizontal="20dp"
            android:paddingVertical="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="12dp"
            android:hint="@string/请填写消息内容"
            android:textColor="@color/color_text0"
            android:textColorHint="@color/color_text_content_hint"
            android:textSize="15sp"
            android:minHeight="188dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_rect_main">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ryImage"
                android:layout_marginHorizontal="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/llAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:gravity="center"
                android:orientation="vertical">


                <ImageView
                    android:id="@+id/ivFile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@mipmap/ic_add_upload"/>

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="100dp"
                    android:singleLine="true"
                    android:visibility="invisible"
                    android:layout_marginTop="10dp"
                    android:text="文件名称"
                    android:textColor="@color/color_text0"
                    android:textSize="12sp"
                    />
            </LinearLayout>

        </LinearLayout>



        <TextView
            android:id="@+id/tvConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:gravity="center"
            android:textStyle="bold"
            android:background="@mipmap/ic_bg_btn2_01"
            android:text="@string/确认"
            android:textColor="#ffffffff"
            android:textSize="16sp"
            />


    </LinearLayout>

</FrameLayout>