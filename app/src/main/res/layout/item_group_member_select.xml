<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/wechat_list_item_padding_h"
        android:paddingEnd="@dimen/wechat_list_item_padding_h">

        <CheckBox
            android:id="@+id/cb_member"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/wechat_green"
            android:clickable="false"
            android:focusable="false" />

        <include
            android:id="@+id/avatar"
            layout="@layout/view_avatar"
            android:layout_width="@dimen/wechat_avatar_size_small"
            android:layout_height="@dimen/wechat_avatar_size_small"
            android:layout_marginStart="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_user_name"
                style="@style/WeChatTextPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="张三" />

            <TextView
                android:id="@+id/tv_user_id"
                style="@style/WeChatTextSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="10001" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="76dp"
        android:background="@color/wechat_divider" />
</LinearLayout>
