<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".lj.MiBaoActivity">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="7dp"
            app:tint="@color/color_text0"
            android:src="@mipmap/ic_mibaowenti"/>
        <TextView
            android:text="@string/密保问题"
            android:textSize="14sp"
            android:textColor="@color/color_text0"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llMibao"
        android:paddingHorizontal="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="33dp"
        android:background="@drawable/bg_rect_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <TextView
            android:id="@+id/tvMibao"
            android:text="@string/请选择密保问题"
            android:textSize="14sp"
            android:textColor="#5456F6"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <ImageView
            android:src="@mipmap/ic_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/llZidingyiMibao"
        android:visibility="gone"
        android:paddingHorizontal="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="33dp"
        android:background="@drawable/bg_rect_f7f8fa_22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <EditText
            android:id="@+id/etMibaoIssue"
            android:hint="@string/请输入密保问题"
            android:textSize="14sp"
            android:background="@null"
            android:textColor="#A7B0B6"
            android:textColorHint="#A7B0B6"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="25dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="7dp"
            app:tint="@color/color_text0"
            android:src="@mipmap/ic_daan"/>
        <TextView
            android:text="@string/密保答案"
            android:textSize="14sp"
            android:textColor="@color/color_text0"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>
    <LinearLayout
        android:paddingHorizontal="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="33dp"
        android:background="@drawable/bg_rect_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp">
      <EditText
          android:id="@+id/etMibao"
          android:hint="@string/请输入"
          android:textSize="14sp"
          android:textColor="@color/color_text0"
          android:textColorHint="@color/color_text_content_hint"
          android:textStyle="bold"
          android:background="@null"
          android:layout_width="match_parent"
          android:layout_height="match_parent"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvOk"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="52dp"
        android:layout_marginHorizontal="33dp"
        android:background="@mipmap/ic_bg_btn2_01"
        android:gravity="center"
        android:text="@string/完成"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>