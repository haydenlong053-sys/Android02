<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/text_bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxWidth="240dp"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_6"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    tools:background="@drawable/bg_bubble_broad_receive">

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_6"
        android:layout_marginEnd="@dimen/dp_6"
        android:autoLink="web"
        android:gravity="start|center_vertical"
        android:linksClickable="true"
        android:minHeight="20dp"
        android:textColor="@color/color_text0"
        android:textColorLink="@color/color_text0"
        android:textSize="16sp"
        tools:text="收到，马上查看" />

    <!-- wrap_content：由引用文案撑开宽度，避免被短正文挤扁 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quote_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minWidth="140dp"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        tools:background="@drawable/bg_message_quote_card_input"
        tools:visibility="visible">

        <com.hjq.shape.view.ShapeView
            android:id="@+id/yyView"
            android:layout_width="@dimen/dp_2"
            android:layout_height="@dimen/dp_0"
            android:layout_marginVertical="@dimen/dp_3"
            android:layout_marginStart="@dimen/dp_5"
            app:layout_constraintBottom_toBottomOf="@id/tv_quote_digest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_quote_title"
            app:shape_angle="90"
            app:shape_endColor="#4444F0"
            app:shape_radius="@dimen/dp_2"
            app:shape_startColor="#5686F3" />

        <TextView
            android:id="@+id/tv_quote_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_5"
            android:ellipsize="end"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:textColor="#B2000000"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/yyView"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="引用 JOY Follow" />

        <TextView
            android:id="@+id/tv_quote_digest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxWidth="200dp"
            android:maxLines="2"
            android:textColor="#B2000000"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tv_quote_title"
            app:layout_constraintTop_toBottomOf="@id/tv_quote_title"
            tools:text="你好，很高兴认识你" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
