<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginBottom="16dp"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.cboda.baselibrary.view.AppRoundBroadImage
                android:id="@+id/ivTouxiang"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@mipmap/ic_head_broad_defaut"
                />

            <com.cboda.baselibrary.shapeview.shape.ShapeTextBroadView
                android:id="@+id/tvshenfen"
                android:visibility="gone"
                tools:visibility="visible"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                app:shapeCornersRadius="5dp"
                app:shapeCornersBottomRightRadius="5dp"
                app:shapeSolidColor="#FFF2E4"
                android:textColor="#F99D3A"
                tools:text="东方红"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="15dp"/>
        </FrameLayout>
        <TextView
            android:id="@+id/tvusername"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="name"
            android:textColor="@color/black_65"
            android:textSize="11sp"
            />
    </androidx.appcompat.widget.LinearLayoutCompat>

</LinearLayout>