<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivTopBg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_214"
        android:scaleType="fitXY"
        android:src="@drawable/ic_gc_top_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <com.cboda.baselibrary.view.AppRoundBroadImage
        android:id="@+id/userImg"
        android:layout_width="@dimen/dp_42"
        android:layout_height="@dimen/dp_42"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_11"
        android:scaleType="centerCrop"
        app:app_round_border_color="@color/white"
        app:app_round_border_width="@dimen/dp_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@mipmap/ic_head_broad_defaut" />

    <com.hjq.shape.view.ShapeView
        android:id="@+id/shapeRightView"
        android:layout_width="@dimen/dp_62"
        android:layout_height="@dimen/dp_62"
        android:layout_marginTop="@dimen/dp_1"
        android:layout_marginEnd="@dimen/dp_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shape_radius="@dimen/dp_31"
        app:shape_shadowColor="#739e9e9e"
        app:shape_shadowSize="@dimen/dp_10"
        app:shape_solidColor="@color/white" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:scaleType="centerCrop"
        android:src="@mipmap/icon_squre_tx"
        app:layout_constraintBottom_toBottomOf="@id/shapeRightView"
        app:layout_constraintEnd_toEndOf="@id/shapeRightView"
        app:layout_constraintStart_toStartOf="@id/shapeRightView"
        app:layout_constraintTop_toTopOf="@id/shapeRightView" />

    <com.hjq.shape.view.ShapeView
        android:id="@+id/unReadNotice"
        android:layout_width="@dimen/dp_8"
        android:layout_height="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_18"
        android:layout_marginEnd="@dimen/dp_18"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/shapeRightView"
        app:layout_constraintTop_toTopOf="@id/shapeRightView"
        app:shape_radius="@dimen/dp_8"
        app:shape_solidColor="#EB534B"
        tools:visibility="visible" />

    <com.hjq.shape.view.ShapeView
        android:id="@+id/shapeView"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_62"
        android:layout_marginHorizontal="@dimen/dp_60"
        android:layout_marginTop="@dimen/dp_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shape_radius="@dimen/dp_31"
        app:shape_shadowColor="#739e9e9e"
        app:shape_shadowSize="@dimen/dp_10"
        app:shape_solidColor="@color/white" />

    <com.cboda.baselibrary.view.magicindicator.MagicBroadIndicator
        android:id="@+id/gpMagicIndicator"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_margin="@dimen/dp_11"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/shapeView"
        app:layout_constraintEnd_toEndOf="@id/shapeView"
        app:layout_constraintStart_toStartOf="@id/shapeView"
        app:layout_constraintTop_toTopOf="@id/shapeView" />

    <com.cboda.baselibrary.widge.NestedViewPager
        android:id="@+id/gpViewPagerLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shapeView" />

    <Space
        android:id="@+id/gpView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.hjq.shape.view.ShapeImageView
        android:id="@+id/gpAddView"
        android:layout_width="@dimen/dp_46"
        android:layout_height="@dimen/dp_46"
        android:layout_marginEnd="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_100"
        android:padding="@dimen/dp_16"
        android:scaleType="centerCrop"
        android:src="@mipmap/icon_gp_add"
        app:layout_constraintBottom_toTopOf="@id/gpView1"
        app:layout_constraintEnd_toEndOf="parent"
        app:shape_radius="@dimen/dp_16"
        app:shape_solidColor="@color/color_3B47DD" />
</androidx.constraintlayout.widget.ConstraintLayout>