<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/text_bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxWidth="240dp"
    android:orientation="vertical"
    tools:background="@drawable/bg_bubble_broad_receive">

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:autoLink="web"
        android:gravity="start|center_vertical"
        android:linksClickable="true"
        android:minHeight="40dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:textColor="@color/color_text0"
        android:textColorLink="@color/color_text0"
        android:textSize="16sp"
        tools:text="你好，这是一条文本消息" />

    <TextView
        android:id="@+id/tv_edited"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:visibility="gone"
        tools:textColor="#99000000"
        tools:visibility="visible" />
</LinearLayout>
