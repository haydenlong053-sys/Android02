<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    >
    <TextView
        android:id="@+id/tvHead"
        android:text="@string/验证支付密码"
        android:layout_marginTop="100dp"
        android:textSize="20sp"
        android:textColor="@color/color_text0"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/tvHint"
        android:text="@string/请输入支付密码用于修改登录密码"
        android:textSize="13dp"
        android:layout_marginTop="21dp"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/color_text_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.maning.pswedittextlibrary.MNPasswordEditText
        android:id="@+id/pswEdit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="23dp"
        android:layout_marginBottom="16dp"
        android:focusableInTouchMode="true"
        android:layout_marginHorizontal="20dp"
        android:inputType="number"
        android:maxLength="6"
        android:textSize="20sp"
        app:psw_mode="Circle"
        app:psw_border_color="@color/color_psw_bg"
        app:psw_border_radius="5dp"
        app:psw_cover_circle_radius="4dp"
        app:psw_border_selected_color="@color/color_psw_border"
        app:psw_background_color="@color/color_psw_bg"
        app:psw_border_width="1dp"
        app:psw_cover_circle_color="@color/color_psw_border"
        app:psw_cursor_width="0dp"
        app:psw_item_margin="10dp"
        app:psw_show_cursor="false"
        app:psw_style="StyleOneself"
        app:psw_text_color="@color/color_psw_border"/>
</LinearLayout>