<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/voice_background_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.cboda.agora.ui.ui.basic.AUIImageBroadView
        android:id="@+id/back_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="center"
        android:background="@drawable/bg_meeting_broad_close"
        app:layout_constraintDimensionRatio="1:1"
        android:src="@drawable/ic_meet_broad_close"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:maxEms="8"
        android:maxLines="1"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/back_icon"
        android:ellipsize="end"
        android:id="@+id/tvRoomTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="公共事业群公共事业群公共事公共事业群公共事业群公共事业群公共事业群业群公共事业群 聊天室"
        android:layout_marginStart="8dp"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />




</androidx.constraintlayout.widget.ConstraintLayout>