<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rect_white_broad_12dp"
    android:layout_marginHorizontal="16dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/shezhiquntou"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/shezhiquntouxiang"
            android:textColor="@color/black"
            android:textSize="16sp" />



        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:src="@mipmap/ic_broad_next2" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:layout_width="match_parent"
        style="@style/Line2"
        />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/shezhiqunnicheng"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/qubmingcheng"
            android:textColor="@color/black"
            android:textSize="16sp" />


        <TextView
            android:maxWidth="180dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/black_65"
            android:textSize="16sp"
            android:id="@+id/qunmingceng"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:src="@mipmap/ic_broad_next2" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:layout_width="match_parent"
        style="@style/Line2"
        />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/qungonggao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/qungonggapo"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/mTvNoticeSet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible"
                android:text="未设置"
                android:textColor="@color/black_35"
                android:textSize="16sp" />


            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_broad_next2" />
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView
            android:id="@+id/mTvNoticeDes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            tools:visibility="visible"
            android:ellipsize="end"
            android:maxLines="3"
            tools:text="尊敬的业主/ 为了更好地开展物业服务，促进物业公司与业主之间的交流。原管家微信号使用至2023年12月31日原管家微信号使用至"
            android:textColor="@color/black_65"
            android:textSize="14sp" />
    </androidx.appcompat.widget.LinearLayoutCompat>



</androidx.appcompat.widget.LinearLayoutCompat>