<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/bg_main_space"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <LinearLayout
        android:padding="25dp"
        android:background="@drawable/bg_rect_broad_main"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="10dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/问题描述必填"
            android:textSize="15sp"
            android:textColor="@color/color_text0"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etContent"
            android:hint="@string/请填写15字以上描述以便我们更好地为您提供帮助"
            android:background="@drawable/bg_rect_broad_input"
            android:textSize="12sp"
            android:textColor="@color/color_text0"
            android:textColorHint="@color/color_text_content_hint"
            android:paddingHorizontal="18dp"
            android:paddingVertical="23dp"
            android:layout_marginTop="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:paddingVertical="25dp"
        android:background="@drawable/bg_rect_broad_main"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="10dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_marginLeft="25dp"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/上传图片"
                android:textSize="15sp"
                android:textColor="@color/color_text0"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="@string/最多3张"
                android:textSize="12sp"
                android:textColor="#666666"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ryImage"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:padding="25dp"
        android:background="@drawable/bg_rect_broad_main"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="10dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/联系方式必填"
            android:textSize="15sp"
            android:textColor="@color/color_text0"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etCall"
            android:hint="@string/请填写您的微信或者手机号码"
            android:background="@drawable/bg_rect_broad_input"
            android:textSize="12sp"
            android:textColor="@color/color_text0"
            android:textColorHint="@color/color_text_content_hint"
            android:paddingHorizontal="18dp"
            android:paddingVertical="13dp"
            android:layout_marginTop="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvSubmit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="26dp"
        android:layout_marginHorizontal="37dp"
        android:background="@mipmap/ic_bg_btn2_broad_01"
        android:gravity="center"
        android:text="@string/提交"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>