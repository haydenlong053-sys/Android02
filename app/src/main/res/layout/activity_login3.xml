<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".lj.LoginActivity">
    <ImageView
        android:src="@mipmap/ic_login_bg"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ImageView
        android:visibility="gone"
        android:id="@+id/ivRegisterBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <FrameLayout
        android:visibility="gone"
        android:id="@+id/videoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.lxkj.aiim.widge.LiXinStandardGSYVideoPlayer
            android:id="@+id/videoplayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <ImageView
            android:id="@+id/thumbImage"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            />


    </FrameLayout>



   <LinearLayout
       android:orientation="vertical"
       android:layout_width="match_parent"
       android:layout_height="match_parent">
       <View
           android:id="@+id/viHead"
           android:layout_width="match_parent"
           android:layout_height="0dp"/>
       <androidx.core.widget.NestedScrollView
           android:layout_width="match_parent"
           android:layout_height="match_parent">

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical">
               <FrameLayout
                   android:layout_width="match_parent"
                   android:layout_height="50dp">
                   <TextView
                       android:id="@+id/tvLanguage"
                       android:layout_width="wrap_content"
                       android:layout_height="23dp"
                       android:layout_gravity="right|center_vertical"
                       android:layout_marginRight="17dp"
                       android:background="@drawable/bg_rect_b3b3b9_12dp"
                       android:drawableRight="@mipmap/ic_login_qiehuan"
                       android:drawablePadding="4dp"
                       android:gravity="center_vertical"
                       android:paddingHorizontal="8dp"
                       android:text="中文"
                       android:textColor="@color/white"
                       android:textSize="12sp" />
               </FrameLayout>
               <RelativeLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="16dp">

                   <ImageView
                       android:layout_width="50dp"
                       android:layout_height="50dp"
                       android:layout_centerHorizontal="true"
                       android:src="@mipmap/ic_logo" />

                   <ImageView
                       android:id="@+id/imWangluo"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_alignParentRight="true"
                       android:layout_marginRight="13dp"
                       android:src="@mipmap/ic_wangluo" />
               </RelativeLayout>

               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="48dp"
                   android:orientation="horizontal"
                   android:paddingLeft="35dp">

                   <RelativeLayout
                       android:id="@+id/rlUser"
                       android:layout_marginRight="50dp"
                       android:layout_width="wrap_content"
                       android:layout_height="50dp">
                       <ImageView
                           android:id="@+id/imUser"
                           android:layout_alignParentBottom="true"
                           android:src="@mipmap/ic_login_bt_bg"
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"/>

                       <TextView
                           android:id="@+id/tvUser"
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:layout_alignParentBottom="true"
                           android:text="@string/用户名登录"
                           android:textColor="#222222"
                           android:textSize="17sp"
                           android:textStyle="bold" />
                   </RelativeLayout>

                   <RelativeLayout
                       android:id="@+id/rlPhone"
                       android:layout_width="wrap_content"
                       android:layout_height="50dp">
                       <ImageView
                           android:id="@+id/imPhone"
                           android:visibility="gone"
                           android:layout_alignParentBottom="true"
                           android:src="@mipmap/ic_login_bt_bg"
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"/>

                       <TextView
                           android:id="@+id/tvPhone"
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:layout_alignParentBottom="true"
                           android:text="@string/手机号登录"
                           android:textColor="#515763"
                           android:textSize="17sp"
                           android:textStyle="bold" />
                   </RelativeLayout>
               </LinearLayout>
               <LinearLayout
                   android:id="@+id/llUser"
                   android:orientation="vertical"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content">
                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_marginLeft="34dp"
                       android:layout_marginTop="46dp"
                       android:drawableLeft="@mipmap/ic_login_user"
                       android:drawablePadding="12dp"
                       android:text="@string/用户名"
                       android:textColor="#4D5668"
                       android:textSize="14sp"
                       android:textStyle="bold" />

                   <EditText
                       android:id="@+id/etUser"
                       android:layout_width="match_parent"
                       android:layout_height="44dp"
                       android:layout_marginHorizontal="33dp"
                       android:layout_marginTop="12dp"
                       android:background="@drawable/bg_rect_f7f8fa_22dp"
                       android:hint="@string/请输入用户名"
                       android:paddingHorizontal="22dp"
                       android:textColor="#333333"
                       android:textSize="14sp"
                       android:textStyle="bold" />
               </LinearLayout>


               <LinearLayout
                   android:id="@+id/llPhone"
                   android:visibility="gone"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="vertical">

                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_marginLeft="34dp"
                       android:layout_marginTop="46dp"
                       android:drawableLeft="@mipmap/ic_login_phone"
                       android:drawablePadding="12dp"
                       android:text="@string/手机号"
                       android:textColor="#4D5668"
                       android:textSize="14sp"
                       android:textStyle="bold" />

                   <LinearLayout
                       android:layout_width="match_parent"
                       android:layout_height="44dp"
                       android:layout_marginHorizontal="33dp"
                       android:layout_marginTop="12dp"
                       android:background="@drawable/bg_rect_f7f8fa_22dp"
                       android:gravity="center_vertical"
                       android:orientation="horizontal">
                       <TextView
                           android:id="@+id/tvDiqu"
                           android:text="+86"
                           android:textSize="14sp"
                           android:drawablePadding="5dp"
                           android:drawableRight="@mipmap/ic_login_xiala"
                           android:paddingLeft="19dp"
                           android:paddingRight="5dp"
                           android:paddingVertical="6dp"
                           android:textColor="#333333"
                           android:textStyle="bold"
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"/>
                       <View
                           android:background="#CCCCCC"
                           android:layout_width="0.5dp"
                           android:layout_height="18.5dp"/>
                       <EditText
                           android:id="@+id/etPhone"
                           android:layout_width="0dp"
                           android:layout_height="match_parent"
                           android:layout_weight="1"
                           android:inputType="number"
                           android:background="@null"
                           android:hint="@string/请输入手机号"
                           android:paddingHorizontal="10dp"
                           android:textColor="#333333"
                           android:textSize="14sp"
                           android:textStyle="bold" />
                   </LinearLayout>
               </LinearLayout>

               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginLeft="34dp"
                   android:layout_marginTop="32dp"
                   android:drawableLeft="@mipmap/ic_login_password"
                   android:drawablePadding="12dp"
                   android:text="@string/密码"
                   android:textColor="#4D5668"
                   android:textSize="14sp"
                   android:textStyle="bold" />

               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="44dp"
                   android:layout_marginHorizontal="33dp"
                   android:layout_marginTop="12dp"
                   android:background="@drawable/bg_rect_f7f8fa_22dp"
                   android:gravity="center_vertical"
                   android:orientation="horizontal">

                   <EditText
                       android:id="@+id/etPassword"
                       android:layout_width="0dp"
                       android:layout_height="match_parent"
                       android:layout_weight="1"
                       android:background="@null"
                       android:hint="@string/请输入密码"
                       android:inputType="textPassword"
                       android:paddingHorizontal="22dp"
                       android:textColor="#333333"
                       android:textSize="14sp"
                       android:textStyle="bold" />

                   <ImageView
                       android:id="@+id/imEyes"
                       android:layout_width="wrap_content"
                       android:layout_height="match_parent"
                       android:paddingRight="28dp"
                       android:src="@mipmap/ic_biyan" />
               </LinearLayout>

               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="70dp"
                   android:gravity="center_vertical"
                   android:orientation="horizontal"
                   android:paddingHorizontal="44dp">

                   <TextView
                       android:id="@+id/tvZhaohui"
                       android:layout_width="wrap_content"
                       android:layout_height="50dp"
                       android:gravity="center_vertical"
                       android:text="@string/找回密码"
                       android:textColor="#5456F6"
                       android:textSize="13sp" />

                   <View
                       android:layout_width="0dp"
                       android:layout_height="0dp"
                       android:layout_weight="1" />

                   <TextView
                       android:id="@+id/tvZhuce"
                       android:layout_width="wrap_content"
                       android:layout_height="50dp"
                       android:gravity="center_vertical"
                       android:text="@string/立即注册"
                       android:textColor="#6F87A7"
                       android:textSize="13sp" />
               </LinearLayout>

               <TextView
                   android:id="@+id/tvLogin"
                   android:layout_width="match_parent"
                   android:layout_height="50dp"
                   android:layout_marginHorizontal="33dp"
                   android:background="@drawable/bg_button"
                   android:gravity="center"
                   android:text="@string/登录"
                   android:textColor="@color/white"
                   android:textSize="16sp"
                   android:textStyle="bold" />
               <LinearLayout
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_gravity="center_horizontal"
                   android:layout_marginTop="10dp"
                   android:orientation="horizontal">

                   <CheckBox
                       android:id="@+id/cbAgree"
                       style="@style/CustomCheckboxTheme"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:checked="true"
                       android:padding="5dp"
                       android:text="@string/我已阅读并同意"
                       android:textColor="#999999"
                       android:textSize="12sp" />

                   <TextView
                       android:id="@+id/tvXy"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:paddingTop="7dp"
                       android:paddingBottom="7dp"
                       android:text="@string/用户协议"
                       android:textColor="#333333"
                       android:textSize="12sp" />

                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:paddingTop="7dp"
                       android:paddingBottom="7dp"
                       android:text="@string/和"
                       android:textColor="#999999"
                       android:textSize="12sp" />

                   <TextView
                       android:id="@+id/tvYs"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:paddingTop="7dp"
                       android:paddingBottom="7dp"
                       android:text="@string/隐私协议"
                       android:textColor="#333333"
                       android:textSize="12sp" />

               </LinearLayout>
               <ImageView
                   android:id="@+id/imVpn"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_gravity="right"
                   android:layout_marginTop="20dp"
                   android:layout_marginRight="13dp"
                   android:src="@mipmap/ic_login_vpn" />

               <ImageView
                   android:id="@+id/imKefu"
                   android:layout_marginBottom="30dp"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_gravity="right"
                   android:layout_marginRight="13dp"
                   android:src="@mipmap/ic_login_kefu" />


           </LinearLayout>
       </androidx.core.widget.NestedScrollView>
   </LinearLayout>

</RelativeLayout>