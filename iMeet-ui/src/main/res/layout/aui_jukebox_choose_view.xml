<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="?attr/aui_jukeboxChoose_appearance">

    <com.cboda.agora.ui.ui.basic.AUIEditBroadText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        app:aui_edittext_icon_left="@drawable/aui_jukebox_choose_icon_broad_search"
        app:aui_edittext_icon_right="@drawable/aui_jukebox_choose_icon_broad_close"
        app:aui_edittext_input_hintText="@string/aui_jukebox_search_hint" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.cboda.agora.ui.ui.basic.AUITabBroadLayout
                android:id="@+id/tl_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:aui_tabLayout_menu="@menu/aui_jukebox_broad_category"
                app:aui_tabLayout_tabMode="scrollable" />

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/srl_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.cboda.agora.ui.ui.basic.AUIRecyclerBroadView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingHorizontal="?attr/aui_jukeboxChoose_listPaddingHorizontal"
                    app:aui_listDivider="?attr/aui_jukeboxChoose_listDivider"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="1"
                    tools:listitem="@layout/aui_jukebox_choose_broad_item" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/srl_search_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <com.cboda.agora.ui.ui.basic.AUIRecyclerBroadView
                android:id="@+id/recyclerView_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="?attr/aui_jukeboxChoose_listPaddingHorizontal"
                app:aui_listDivider="?attr/aui_jukeboxChoose_listDivider"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="1"
                tools:listitem="@layout/aui_jukebox_choose_broad_item" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </FrameLayout>


</LinearLayout>