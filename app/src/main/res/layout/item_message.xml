<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tv_time_divider"
        style="@style/WeChatTextCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:text="昨天 14:30"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/row_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <include
            android:id="@+id/avatar_left"
            layout="@layout/view_avatar"
            android:layout_width="@dimen/wechat_avatar_size_small"
            android:layout_height="@dimen/wechat_avatar_size_small"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/message_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_nickname"
                style="@style/WeChatTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:textColor="@color/wechat_text_secondary"
                android:visibility="gone"
                tools:text="张三"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/bubble_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_read_status"
                    style="@style/WeChatTextCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:layout_marginEnd="2dp"
                    android:textColor="@color/wechat_text_hint"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="已读"
                    tools:visibility="visible" />

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="2dp"
                    android:indeterminateTint="@color/wechat_text_hint"
                    android:visibility="gone"
                    tools:visibility="visible"
                    />

                <FrameLayout
                    android:id="@+id/fl_message_content_host"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:layout_height="100dp"
                    tools:layout_width="176dp"
                    tools:background="@drawable/bg_bubble_received" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_time_inline"
                style="@style/WeChatTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:visibility="gone"
                tools:text="14:30"
                tools:visibility="visible" />


        </LinearLayout>

        <include
            android:id="@+id/avatar_right"
            layout="@layout/view_avatar"
            android:layout_width="@dimen/wechat_avatar_size_small"
            android:layout_height="@dimen/wechat_avatar_size_small"
            android:visibility="gone"
            tools:visibility="visible"
            />
    </LinearLayout>
</LinearLayout>
